        <mxCell id="proc2_feat_text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666;fontStyle=2;" value="user_id 限定归属防越权 | 统一维护时间戳 | 封装状态变更逻辑" vertex="1">
          <mxGeometry height="25" width="570" x="80" y="750" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;" value="设计说明" vertex="1">
          <mxGeometry height="780" width="320" x="720" y="80" as="geometry" />
        </mxCell>
        <mxCell id="legend_text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=10;spacingTop=5;" value="【存储过程设计原则】&#xa;&#xa;1. 事务原子性&#xa;   使用 START TRANSACTION&#xa;   和 COMMIT 保证操作完整性&#xa;&#xa;2. 主键生成&#xa;   使用 REPLACE(UUID(), &#39;-&#39;, &#39;&#39;)&#xa;   生成32位紧凑UUID&#xa;&#xa;3. 默认值兜底&#xa;   COALESCE(NULLIF(p_status, &#39;&#39;), &#39;已记录&#39;)&#xa;   空字符串和NULL统一规整&#xa;&#xa;4. 异常处理&#xa;   DECLARE EXIT HANDLER&#xa;   FOR SQLEXCEPTION&#xa;   BEGIN ROLLBACK; RESIGNAL; END&#xa;&#xa;5. 防越权&#xa;   WHERE user_id = p_user_id&#xa;   限定数据归属&#xa;&#xa;6. 写后读模式&#xa;   INSERT/UPDATE 后立即 SELECT&#xa;   返回数据库最新状态&#xa;&#xa;【使用场景】&#xa;&#xa;p_create_health_record&#xa;→ 用户提交健康检查记录&#xa;→ 后端服务层调用&#xa;&#xa;p_complete_reminder&#xa;→ 用户标记提醒完成&#xa;→ 提醒页操作调用&#xa;&#xa;【调用示例】&#xa;&#xa;CALL p_create_health_record(&#xa;  1, &#39;2024-01-15&#39;,&#xa;  &#39;TCT检查&#39;, &#39;宫颈TCT&#39;,&#xa;  &#39;结果正常&#39;, &#39;定期复查&#39;,&#xa;  &#39;已记录&#39;&#xa;);&#xa;&#xa;CALL p_complete_reminder(&#xa;  1, &#39;abc123def456&#39;&#xa;);" vertex="1">
          <mxGeometry height="740" width="300" x="730" y="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
