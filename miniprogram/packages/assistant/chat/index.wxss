@import '../../../styles/design-tokens.wxss';

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--wx-bg-secondary);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ---- 欢迎区域 ---- */
.chat-welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 36rpx;
  text-align: center;
}

.welcome-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--wx-radius-xl);
  background: var(--wx-brand-100);
  margin-bottom: 32rpx;
}

.welcome-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 40rpx;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.welcome-desc {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
  max-width: 560rpx;
  margin-bottom: 48rpx;
}

.welcome-suggestions {
  width: 100%;
  max-width: 620rpx;
}

.suggestions-label {
  display: block;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: left;
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-primary);
  border: 1rpx solid var(--wx-border-default);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--wx-shadow-card);
  transition: transform var(--wx-motion-fast);
}

.suggestion-chip-hover {
  transform: var(--wx-scale-press);
  background: var(--wx-brand-50);
}

/* ---- 消息列表 ---- */
.chat-messages {
  flex: 1;
  padding: 24rpx 24rpx 0;
  overflow-y: auto;
}

.chat-bubble-row {
  display: flex;
  margin-bottom: 24rpx;
}

.chat-bubble-user {
  justify-content: flex-end;
}

.chat-bubble-assistant {
  justify-content: flex-start;
}

.chat-bubble {
  max-width: 80%;
  padding: 22rpx 28rpx;
  border-radius: var(--wx-radius-lg);
  box-sizing: border-box;
}

.chat-bubble-user-inner {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  border-bottom-right-radius: 8rpx;
}

.chat-bubble-assistant-inner {
  background: var(--wx-bg-primary);
  color: var(--wx-text-primary);
  border: 1rpx solid var(--wx-border-default);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--wx-shadow-card);
}

.chat-bubble-text {
  font-size: 28rpx;
  line-height: 1.65;
  word-wrap: break-word;
}

.chat-disclaimer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--wx-border-default);
}

.chat-disclaimer text {
  font-size: 22rpx;
  color: var(--wx-text-tertiary);
  line-height: 1.5;
}

/* ---- 输入提示动画 ---- */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--wx-text-tertiary);
  animation: typingBounce 1.2s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* ---- 输入区 ---- */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--wx-bg-primary);
  border-top: 1rpx solid var(--wx-border-default);
}

.chat-input-wrap {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: var(--wx-radius-pill);
  border: 1rpx solid var(--wx-border-default);
  background: var(--wx-bg-secondary);
  font-size: 28rpx;
  color: var(--wx-text-primary);
  box-sizing: border-box;
}

.chat-input-placeholder {
  color: var(--wx-text-tertiary);
  font-size: 28rpx;
}

.chat-send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  min-width: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  box-shadow: var(--wx-shadow-button);
  flex: 0 0 auto;
}

.chat-send-btn::after {
  border: 0;
}

.chat-send-btn[disabled] {
  background: var(--wx-border-default);
  box-shadow: none;
}

.chat-send-btn-hover {
  opacity: 0.88;
  transform: var(--wx-scale-press);
}

/* ---- 底部免责声明 ---- */
.chat-footer-disclaimer {
  padding: 8rpx 24rpx 12rpx;
  text-align: center;
  background: var(--wx-bg-primary);
}

.chat-footer-disclaimer text {
  font-size: 20rpx;
  color: var(--wx-text-tertiary);
}
