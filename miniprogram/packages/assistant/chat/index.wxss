@import '../../../styles/design-tokens.wxss';

@keyframes welcomeRingPulse {
  0% {
    transform: scale(0.96);
    opacity: 0.42;
  }
  50% {
    transform: scale(1.02);
    opacity: 0.78;
  }
  100% {
    transform: scale(0.96);
    opacity: 0.42;
  }
}

@keyframes messageFadeInUp {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes streamCursorBlink {
  0%, 45% {
    opacity: 1;
  }
  50%, 100% {
    opacity: 0;
  }
}

@keyframes streamBubbleGlow {
  0% {
    box-shadow: 0 4rpx 14rpx rgba(var(--wx-brand-500-rgb), 0.08);
  }
  50% {
    box-shadow: 0 8rpx 24rpx rgba(var(--wx-brand-500-rgb), 0.16);
  }
  100% {
    box-shadow: 0 4rpx 14rpx rgba(var(--wx-brand-500-rgb), 0.08);
  }
}

/* ======== 页面容器 ======== */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--wx-bg-secondary);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ======== 欢迎页 ======== */
.chat-welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 32rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.welcome-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.welcome-avatar {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
}

.welcome-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  display: block;
}

.welcome-avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 46rpx;
  border: 2rpx solid rgba(var(--wx-brand-500-rgb), 0.15);
  animation: welcomeRingPulse 2.6s ease-in-out infinite;
}

.welcome-title {
  color: var(--wx-text-primary);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.welcome-subtitle {
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 欢迎卡片 */
.welcome-card {
  width: 100%;
  max-width: 680rpx;
  background: var(--wx-bg-primary);
  border-radius: var(--wx-radius-xl);
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(11, 28, 48, 0.06);
  border: 1rpx solid var(--wx-border-default);
}

.welcome-card-desc {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.welcome-divider {
  height: 1rpx;
  background: var(--wx-border-divider);
  margin: 28rpx 0;
}

.welcome-card-label {
  display: block;
  color: var(--wx-text-tertiary);
  font-size: 22rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.suggestion-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-radius: var(--wx-radius-md);
  background: var(--wx-bg-secondary);
  border: 1rpx solid transparent;
  transition: all var(--wx-motion-fast);
}

.suggestion-item-hover {
  background: var(--wx-brand-50);
  border-color: rgba(var(--wx-brand-500-rgb), 0.15);
  transform: translateX(4rpx);
}

.suggestion-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
  color: var(--wx-text-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.suggestion-arrow {
  color: var(--wx-text-tertiary);
  font-size: 28rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* ======== 消息列表 ======== */
.chat-messages {
  flex: 1;
  padding: 0;
  overflow-y: auto;
}

.chat-messages-inner {
  padding: 20rpx 24rpx 16rpx;
}

.chat-system-hint {
  text-align: center;
  padding: 12rpx 0 28rpx;
}

.chat-system-hint text {
  font-size: 22rpx;
  color: var(--wx-text-tertiary);
  background: var(--wx-bg-tertiary);
  padding: 8rpx 24rpx;
  border-radius: var(--wx-radius-pill);
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
  animation: messageFadeInUp 240ms ease-out;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-assistant {
  justify-content: flex-start;
}

/* 头像 */
.msg-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-avatar-bot {
  background: transparent;
  margin-right: 16rpx;
  overflow: hidden;
}

.msg-avatar-user {
  background: linear-gradient(145deg, #e8ecf5, #d4dae8);
  margin-left: 16rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.12);
  overflow: hidden;
}

.msg-avatar-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: block;
}

.msg-avatar-user-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
}

.msg-avatar-emoji {
  font-size: 34rpx;
}

/* 消息体 */
.msg-body {
  max-width: 72%;
  min-width: 80rpx;
}

.msg-body-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.msg-time {
  display: block;
  font-size: 20rpx;
  color: var(--wx-text-tertiary);
  margin-bottom: 8rpx;
  padding: 0 4rpx;
  opacity: 0.7;
}

.msg-time-right {
  text-align: right;
}

/* 气泡 */
.msg-bubble {
  padding: 24rpx 28rpx;
  border-radius: var(--wx-radius-lg);
  word-break: break-word;
}

.msg-bubble-bot {
  background: var(--wx-bg-primary);
  border: 1rpx solid var(--wx-border-default);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(11, 28, 48, 0.04);
}

.msg-bubble-streaming {
  border-color: rgba(var(--wx-brand-500-rgb), 0.22);
  animation: streamBubbleGlow 1.6s ease-in-out infinite;
}

.msg-bubble-user {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(var(--wx-brand-500-rgb), 0.25);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--wx-text-primary);
}

.msg-text-wrap {
  display: inline;
}

.msg-stream-cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: var(--wx-brand-500);
  animation: streamCursorBlink 1s steps(1) infinite;
}

.msg-text-user {
  color: var(--wx-text-on-primary);
}

/* 免责声明 */
.msg-disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.04);
  border-radius: var(--wx-radius-sm);
}

.disclaimer-icon {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  color: var(--wx-text-tertiary);
  line-height: 1.5;
}

/* ======== 深度思考面板 ======== */
.think-panel {
  margin-bottom: 12rpx;
  border-radius: var(--wx-radius-md);
  background: rgba(245, 158, 11, 0.04);
  border: 1rpx solid rgba(245, 158, 11, 0.15);
  overflow: hidden;
  transition: all var(--wx-motion-normal);
}

.think-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
}

.think-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.think-icon {
  font-size: 24rpx;
}

.think-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #92600a;
  letter-spacing: 1rpx;
}

.think-toggle {
  font-size: 24rpx;
  color: #92600a;
  transition: transform var(--wx-motion-fast);
}

.think-toggle-up {
  transform: rotate(0deg);
}

.think-toggle-down {
  transform: rotate(-90deg);
}

.think-content {
  padding: 0 20rpx 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.think-text {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--wx-text-secondary);
  opacity: 0.85;
}

/* ======== 加载骨架 ======== */
.loading-skeleton {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 4rpx 0;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg,
    rgba(var(--wx-brand-500-rgb), 0.06) 0%,
    rgba(var(--wx-brand-500-rgb), 0.12) 50%,
    rgba(var(--wx-brand-500-rgb), 0.06) 100%
  );
  animation: shimmer 1.5s infinite;
}

.skeleton-line-long {
  width: 90%;
}

.skeleton-line-medium {
  width: 70%;
  animation-delay: 0.15s;
}

.skeleton-line-short {
  width: 45%;
  animation-delay: 0.3s;
}

@keyframes shimmer {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}

/* ======== 输入区 ======== */
.chat-input-area {
  background: var(--wx-bg-primary);
  border-top: 1rpx solid var(--wx-border-divider);
  padding: 16rpx 24rpx 0;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-field-wrap {
  flex: 1;
  min-width: 0;
}

.input-field {
  width: 100%;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: var(--wx-radius-pill);
  border: 1.5rpx solid var(--wx-border-default);
  background: var(--wx-bg-secondary);
  font-size: 28rpx;
  color: var(--wx-text-primary);
  box-sizing: border-box;
  transition: border-color var(--wx-motion-fast);
}

.input-field:focus {
  border-color: var(--wx-brand-400);
}

.input-placeholder {
  color: var(--wx-text-tertiary);
  font-size: 28rpx;
}

/* 发送按钮 */
.send-btn {
  width: 84rpx;
  height: 84rpx;
  min-width: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all var(--wx-motion-fast);
}

.send-btn-active {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  box-shadow: 0 4rpx 20rpx rgba(var(--wx-brand-500-rgb), 0.35);
}

.send-btn-active:active {
  transform: scale(0.92);
}

.send-btn-disabled {
  background: var(--wx-bg-secondary);
  border: 1.5rpx solid var(--wx-border-default);
}

.send-btn-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: #ffffff;
}

.send-btn-disabled .send-btn-icon {
  color: var(--wx-text-tertiary);
}

/* 输入区底部提示 */
.input-footer {
  text-align: center;
  padding: 10rpx 0 14rpx;
}

.input-footer text {
  font-size: 20rpx;
  color: var(--wx-text-tertiary);
  opacity: 0.7;
}
