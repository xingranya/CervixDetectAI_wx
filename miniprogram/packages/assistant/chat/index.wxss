@import '../../../styles/design-tokens.wxss';

/* ======== 页面容器 ======== */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--wx-bg-secondary);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.chat-notice {
  flex-shrink: 0;
  margin: 16rpx 28rpx 0;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  color: var(--wx-text-tertiary);
  background: rgba(148, 163, 184, 0.12);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  font-size: 22rpx;
  line-height: 1.45;
}

/* ======== 消息列表（TDesign chat-list） ======== */
.chat-list {
  flex: 1;
  min-height: 0;
}

/* 列表底部免责声明（chat-list footer slot） */
.chat-disclaimer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  padding: 12rpx 24rpx 8rpx;
  font-size: 20rpx;
  color: var(--wx-text-hint);
}

/* ======== 输入区（TDesign chat-sender） ======== */
.chat-sender {
  background: var(--wx-bg-primary);
  border-top: 1rpx solid var(--td-component-divider, var(--wx-border-divider));
}

.sender-prefix {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
  padding: 2rpx 0;
}

.sender-inline-loading {
  flex-shrink: 0;
}

.sender-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--wx-border-default);
  color: var(--wx-text-secondary);
  background: var(--wx-bg-tertiary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  transition: all var(--wx-motion-fast);
}

.sender-toggle-active {
  color: var(--wx-brand-700);
  border-color: rgba(var(--wx-brand-500-rgb), 0.34);
  background: rgba(var(--wx-brand-500-rgb), 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(var(--wx-brand-500-rgb), 0.08);
}

.sender-toggle-hover {
  opacity: 0.82;
}

.sender-toggle-text {
  white-space: nowrap;
}

.sender-toggle-icon {
  flex-shrink: 0;
}

.message-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.thinking-panel {
  margin-bottom: 2rpx;
}

.thinking-stream-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.message-disclaimer {
  display: block;
  color: var(--wx-text-hint);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ======== 欢迎页 ======== */
.chat-welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 24rpx 28rpx 28rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.welcome-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 680rpx;
  padding: 6rpx 20rpx 0;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.welcome-avatar-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 164rpx;
  height: 164rpx;
  margin-bottom: 18rpx;
}

.welcome-avatar-glow {
  position: absolute;
  inset: 8rpx;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 32% 22%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.42) 36%, transparent 62%),
    linear-gradient(145deg, rgba(var(--wx-brand-500-rgb), 0.18), rgba(20, 184, 166, 0.12));
  box-shadow:
    0 22rpx 48rpx rgba(var(--wx-brand-500-rgb), 0.16),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.86);
}

.welcome-avatar-img {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: block;
  background: var(--wx-bg-primary);
  border: 8rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.10);
}

.welcome-title {
  color: var(--wx-text-primary);
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.18;
  margin-bottom: 12rpx;
  text-align: center;
}

.welcome-subtitle {
  max-width: 520rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.55;
  text-align: center;
}

.welcome-pill-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.welcome-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 0 18rpx;
  margin: 0 6rpx 10rpx;
  border-radius: var(--wx-radius-pill);
  color: var(--wx-brand-700);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.12);
  font-size: 22rpx;
  font-weight: 800;
}

/* 欢迎卡片 */
.welcome-card {
  width: 100%;
  max-width: 680rpx;
  background: var(--wx-bg-primary);
  border-radius: var(--wx-radius-md);
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(11, 28, 48, 0.06);
  border: 1rpx solid var(--wx-border-default);
  box-sizing: border-box;
  flex-shrink: 0;
}

.welcome-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.welcome-card-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.25;
}

.welcome-card-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--wx-text-tertiary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.35;
}

.welcome-card-icon {
  flex: 0 0 auto;
  color: var(--wx-brand-500);
}

.suggestion-grid {
  display: block;
}

.suggestion-row {
  display: flex;
  align-items: stretch;
  width: 100%;
  margin-bottom: 12rpx;
}

.suggestion-row:last-child {
  margin-bottom: 0;
}

.suggestion-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 156rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, var(--wx-bg-secondary), rgba(239, 246, 255, 0.72));
  border: 1rpx solid rgba(198, 210, 236, 0.72);
  transition: all var(--wx-motion-fast);
  box-sizing: border-box;
}

.suggestion-item + .suggestion-item {
  margin-left: 12rpx;
}

.suggestion-item-placeholder {
  visibility: hidden;
  pointer-events: none;
}

.suggestion-item-hover {
  background: var(--wx-brand-50);
  border-color: rgba(var(--wx-brand-500-rgb), 0.15);
  transform: translateY(-2rpx);
}

.suggestion-text {
  display: block;
  width: 100%;
  color: var(--wx-text-primary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.42;
  margin-top: 14rpx;
  word-break: normal;
  overflow-wrap: break-word;
  white-space: normal;
}

.suggestion-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: var(--wx-brand-100);
  color: var(--wx-brand-600);
  flex: 0 0 auto;
}

.suggestion-icon {
  flex-shrink: 0;
  color: inherit;
}

/* ============================================================
 *  TDesign chat 组件本地覆盖：紧凑、安全间距、金色深度思考
 *  聊天页启用 styleIsolation: shared 后，这些选择器可穿透到
 *  t-chat-message / t-chat-content / t-chat-sender / t-chat-markdown 内部节点
 * ============================================================ */

/* 消息列表整体：统一左右安全间距，避免气泡贴边 */
.t-chat-list__content {
  padding: 20rpx 32rpx 24rpx !important;
  box-sizing: border-box;
}

/* 消息条：更紧凑的上下间距 */
.t-chat-message {
  margin-bottom: 32rpx !important;
}

/* 消息头部（名字 + 时间）：与气泡间距收紧 */
.t-chat-message__base {
  color: var(--wx-text-secondary) !important;
  font-weight: 500;
  font-size: 24rpx !important;
  margin-bottom: 8rpx !important;
}

.t-chat-message__name {
  font-weight: 600;
}

.t-chat-message__time {
  color: var(--wx-text-tertiary) !important;
}

/* 用户消息气泡：更紧凑的内边距与文字 */
.t-chat-message--base.user .t-chat-content,
.t-chat-message--base.right .t-chat-content {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600)) !important;
  border: 0 !important;
  padding: 20rpx 26rpx !important;
  border-radius: 24rpx 0 24rpx 24rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(var(--wx-brand-500-rgb), 0.22);
}

.t-chat-message--base.user .t-chat-content__user,
.t-chat-message--base.right .t-chat-content__user {
  color: var(--wx-text-on-primary) !important;
  font-size: 28rpx !important;
  line-height: 1.5 !important;
}

/* 助手消息气泡：白底卡片 + 细边框 + 紧凑内边距 */
.t-chat-message--base.assistant .t-chat-content,
.t-chat-message--base.left .t-chat-content {
  background: var(--wx-bg-primary) !important;
  border: 1rpx solid var(--wx-border-default) !important;
  padding: 20rpx 26rpx !important;
  border-radius: 0 24rpx 24rpx 24rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(11, 28, 48, 0.05);
}

.t-chat-message--base.assistant .t-chat-content__assistant,
.t-chat-message--base.left .t-chat-content__assistant {
  color: var(--wx-text-primary) !important;
  font-size: 28rpx !important;
  line-height: 1.55 !important;
}

.t-chat-message__avatar-image {
  border-radius: var(--wx-radius-md) !important;
  box-shadow: 0 2rpx 8rpx rgba(11, 28, 48, 0.08);
}

.t-chat-message__avatar {
  padding-top: 0 !important;
}

/* 兜底：确保 user 在右、assistant 在左，头像与气泡方向一致 */
.t-chat-message.user.right {
  display: flex;
  flex-direction: row-reverse !important;
}

.t-chat-message.assistant.left {
  display: flex;
  flex-direction: row !important;
}

.t-chat-message.right .message-content {
  align-items: flex-end;
}

.t-chat-message.left .message-content {
  align-items: flex-start;
}

/* 深度思考面板：高辨识度金色边框容器，缩小尺寸与字体 */
.t-chat-thinking__inner--block {
  background: #fffbeb !important;
  border: 4rpx solid #e6b422 !important;
  border-radius: var(--wx-radius-md) !important;
  padding: 16rpx 20rpx !important;
  box-shadow: 0 0 0 4rpx rgba(230, 180, 34, 0.12), 0 2rpx 12rpx rgba(230, 180, 34, 0.08);
}

.t-chat-thinking__hd {
  height: auto !important;
  min-height: 40rpx;
  margin-bottom: 6rpx !important;
}

.t-chat-thinking__hd .t-chat-thinking__icon {
  font-size: 32rpx !important;
  color: var(--wx-brand-500) !important;
}

.t-chat-thinking__hd .t-chat-thinking__icon--complete,
.t-chat-thinking__hd .t-chat-thinking__icon--stop {
  color: var(--wx-success) !important;
}

.t-chat-thinking__hd .t-chat-thinking__txt {
  color: var(--wx-text-primary) !important;
  font-weight: 600;
  font-size: 24rpx !important;
}

.t-chat-thinking__bd {
  color: var(--wx-text-secondary) !important;
  line-height: 1.6 !important;
  font-size: 22rpx !important;
  margin-top: 12rpx !important;
}

.t-chat-thinking__bd--border {
  border-left: 4rpx solid rgba(230, 180, 34, 0.55) !important;
  padding-left: 18rpx !important;
}

/* ============================================================
 *  Markdown 层级：字号整体收小，段落与模块间距更紧凑
 * ============================================================ */

.t-chat-markdown {
  color: var(--wx-text-primary) !important;
  font-size: 27rpx !important;
  line-height: 1.65 !important;
}

.t-chat-markdown-p {
  -webkit-margin-before: 16rpx !important;
  margin-block-start: 16rpx !important;
  -webkit-margin-after: 16rpx !important;
  margin-block-end: 16rpx !important;
}

.t-chat-markdown-p:first-child {
  -webkit-margin-before: 0 !important;
  margin-block-start: 0 !important;
}

.t-chat-markdown-p:last-child {
  -webkit-margin-after: 0 !important;
  margin-block-end: 0 !important;
}

.t-chat-markdown-h1,
.t-chat-markdown-h2,
.t-chat-markdown-h3,
.t-chat-markdown-h4,
.t-chat-markdown-h5,
.t-chat-markdown-h6 {
  color: var(--wx-text-deep) !important;
  font-weight: 700 !important;
  margin: 20rpx 0 12rpx !important;
  line-height: 1.45 !important;
}

.t-chat-markdown-h1 {
  font-size: 1.55em !important;
}

.t-chat-markdown-h2 {
  font-size: 1.35em !important;
}

.t-chat-markdown-h3 {
  font-size: 1.15em !important;
}

.t-chat-markdown-strong {
  color: var(--wx-text-deep) !important;
  font-weight: 700 !important;
}

.t-chat-markdown-list {
  padding-left: 0.6em !important;
  margin: 12rpx 0 16rpx !important;
}

.t-chat-markdown-list-item {
  margin-bottom: 8rpx !important;
}

.t-chat-markdown-blockquote {
  background: var(--wx-bg-tertiary) !important;
  border-left: 6rpx solid var(--wx-brand-400) !important;
  border-radius: 0 var(--wx-radius-sm) var(--wx-radius-sm) 0 !important;
  padding: 16rpx 20rpx !important;
  margin: 16rpx 0 !important;
  color: var(--wx-text-secondary) !important;
}

.t-chat-markdown-codespan {
  background: var(--wx-bg-tertiary) !important;
  border: 1rpx solid var(--wx-border-brand) !important;
  color: var(--wx-brand-700) !important;
  padding: 3rpx 8rpx !important;
  border-radius: 10rpx !important;
  font-size: 0.82em !important;
}

.t-chat-markdown-link {
  color: var(--wx-brand-600) !important;
  text-decoration: underline !important;
}

.t-chat-markdown-hr {
  height: 1rpx !important;
  background: var(--wx-border-divider) !important;
  margin: 20rpx 0 !important;
}

/* 流式光标：加深颜色，让“正在生成”更明显 */
.t-chat-markdown-tail {
  color: var(--wx-brand-500) !important;
  animation: tChatStreamPulse 0.9s ease-in-out infinite;
}

@keyframes tChatStreamPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* 输入区：更紧凑，与屏幕保持安全边距 */
.t-chat-sender {
  background: var(--wx-bg-primary) !important;
  border: 2rpx solid var(--wx-border-default) !important;
  box-shadow: 0 -2rpx 16rpx rgba(11, 28, 48, 0.05), 0 12rpx 34rpx rgba(11, 28, 48, 0.08) !important;
  margin-top: 20rpx !important;
  margin-right: 32rpx !important;
  margin-bottom: calc(22rpx + env(safe-area-inset-bottom));
  margin-left: 32rpx !important;
  border-radius: 26rpx !important;
  padding: 10rpx 12rpx 12rpx !important;
  transition: margin-bottom 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease !important;
}

.chat-sender-keyboard {
  box-shadow: 0 -8rpx 30rpx rgba(11, 28, 48, 0.12), 0 14rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.10) !important;
}

.t-chat-sender__actions {
  padding: 0 18rpx !important;
}

.t-chat-sender__footer {
  align-items: center !important;
}

.t-chat-sender__textarea--control {
  color: var(--wx-text-primary) !important;
  font-size: 28rpx !important;
  line-height: 1.5 !important;
  letter-spacing: 0 !important;
}

.t-chat-sender__textarea--placeholder {
  color: var(--wx-text-hint) !important;
  font-size: 28rpx !important;
  line-height: 1.5 !important;
  letter-spacing: 0 !important;
}

.t-chat-sender__sendbtn--default .send-btn-icon {
  width: 82rpx !important;
  height: 82rpx !important;
  margin-left: 18rpx !important;
  color: var(--wx-text-on-primary) !important;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600)) !important;
  box-shadow:
    0 14rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.30),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.24);
}

.t-chat-sender__sendbtn--default .send-btn-icon.active {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-700, var(--wx-brand-600))) !important;
  opacity: 1 !important;
  transform: rotate(-90deg) scale(1.03) !important;
}

.t-chat-sender__sendbtn--default .send-btn-icon.disabled {
  color: rgba(255, 255, 255, 0.78) !important;
  background: linear-gradient(135deg, #d7deea, #cbd5e1) !important;
  box-shadow: 0 8rpx 18rpx rgba(100, 116, 139, 0.14);
  opacity: 1 !important;
}

.t-chat-sender__sendbtn--default .plus-btn .btn-func {
  width: 72rpx !important;
  height: 72rpx !important;
  border-color: var(--wx-border-default) !important;
  background: var(--wx-bg-primary) !important;
}

.t-chat-sender__sendbtn--default .plus-btn.disabled {
  opacity: 0.42 !important;
}

/* 暗色模式覆盖：保持亮/暗两套可读性 */
@media (prefers-color-scheme: dark) {
  .chat-notice {
    background: rgba(148, 163, 184, 0.10);
    border-color: rgba(148, 163, 184, 0.18);
  }

  .sender-toggle {
    background: rgba(148, 163, 184, 0.10);
    border-color: rgba(148, 163, 184, 0.22);
  }

  .sender-toggle-active {
    background: rgba(var(--wx-brand-500-rgb), 0.16);
    border-color: rgba(var(--wx-brand-500-rgb), 0.46);
  }

  .welcome-avatar-glow {
    background:
      radial-gradient(circle at 32% 22%, rgba(255, 255, 255, 0.28), rgba(96, 165, 250, 0.18) 40%, transparent 66%),
      linear-gradient(145deg, rgba(var(--wx-brand-500-rgb), 0.26), rgba(20, 184, 166, 0.12));
    box-shadow:
      0 18rpx 42rpx rgba(0, 0, 0, 0.24),
      inset 0 0 0 1rpx rgba(255, 255, 255, 0.16);
  }

  .welcome-avatar-img {
    border-color: rgba(255, 255, 255, 0.20);
    box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.26);
  }

  .welcome-card {
    background: var(--wx-bg-card);
    border-color: var(--wx-border-default);
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.16);
  }

  .welcome-pill {
    background: rgba(var(--wx-brand-500-rgb), 0.14);
    border-color: rgba(var(--wx-brand-500-rgb), 0.30);
  }

  .suggestion-item {
    background: rgba(148, 163, 184, 0.10);
    border-color: rgba(148, 163, 184, 0.20);
  }

  .suggestion-icon-wrap {
    background: rgba(var(--wx-brand-500-rgb), 0.18);
  }

  .t-chat-message--base.assistant .t-chat-content,
  .t-chat-message--base.left .t-chat-content {
    background: var(--wx-bg-card) !important;
    border-color: var(--wx-border-default) !important;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
  }

  .t-chat-thinking__inner--block {
    background: rgba(212, 168, 75, 0.10) !important;
    border-color: #d4a84b !important;
  }

  .t-chat-message__avatar-image {
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  }

  .t-chat-sender {
    background: var(--wx-bg-primary) !important;
    border-color: var(--wx-border-default) !important;
    box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.15) !important;
  }

  .t-chat-sender__sendbtn--default .send-btn-icon.disabled {
    background: rgba(148, 163, 184, 0.42) !important;
  }

  .t-chat-markdown {
    color: var(--wx-text-primary) !important;
  }

  .t-chat-markdown-blockquote {
    background: rgba(37, 99, 235, 0.08) !important;
  }

  .t-chat-markdown-codespan {
    background: rgba(37, 99, 235, 0.08) !important;
  }
}
