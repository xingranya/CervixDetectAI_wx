<view class="chat-page">
  <view class="chat-notice">
    仅提供健康科普与记录整理，不能替代线下医疗意见。
  </view>

  <view wx:if="{{messages.length === 0}}" class="chat-welcome">
    <view class="welcome-hero">
      <image class="welcome-avatar-img" src="{{botAvatar}}" mode="aspectFit" />
      <text class="welcome-title">健康科普助手</text>
      <text class="welcome-subtitle">筛查常识、术语解释、复查准备</text>
    </view>

    <view class="welcome-card">
      <view class="welcome-card-label">可以这样问</view>
      <view class="suggestion-grid">
        <view
          wx:for="{{suggestions}}"
          wx:key="text"
          class="suggestion-item"
          hover-class="suggestion-item-hover"
          bind:tap="onSuggestionTap"
          data-text="{{item.text}}"
        >
          <t-icon class="suggestion-icon" name="{{item.icon}}" size="30rpx" />
          <text class="suggestion-text">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <t-chat
    wx:else
    class="chat-list"
    id="chatList"
    layout="both"
    reverse="{{false}}"
    animation="gradient"
  >
    <block wx:for="{{chatData}}" wx:key="id">
      <t-chat-message
        chat-id="{{item.id}}"
        avatar="{{item.avatar}}"
        name="{{item.name}}"
        datetime="{{item.datetime}}"
        role="{{item.role}}"
        placement="{{item.placement}}"
        status="{{item.status}}"
        content="{{emptyContent}}"
        variant="base"
        bind:message-longpress="onMessageLongPress"
      >
        <view slot="content" class="message-content">
          <t-chat-loading
            wx:if="{{item.status === 'pending' && !item.reasoning}}"
            animation="gradient"
            text="正在梳理健康科普要点..."
          />

          <t-chat-thinking
            wx:if="{{item.reasoning}}"
            class="thinking-panel"
            content="{{item.thinkingContent}}"
            status="{{item.status === 'complete' ? 'complete' : 'pending'}}"
            layout="border"
            animation="gradient"
            collapsed="{{false}}"
            max-height="{{220}}"
          />

          <t-chat-content
            wx:if="{{item.text}}"
            role="{{item.role}}"
            status="{{item.status}}"
            content="{{item.contentItem}}"
            markdown-props="{{item.markdownProps}}"
          />

          <t-attachments
            wx:if="{{item.attachments.length}}"
            items="{{item.attachments}}"
            removable="{{false}}"
            image-viewer="{{true}}"
          />

          <text wx:if="{{item.disclaimer}}" class="message-disclaimer">{{item.disclaimer}}</text>
        </view>

        <t-chat-actionbar
          wx:if="{{item.role === 'assistant'}}"
          slot="actionbar"
          chat-id="{{item.id}}"
          content="{{item.text}}"
          action-bar="{{actionBarItems}}"
          bind:actions="onMessageAction"
        />
      </t-chat-message>
    </block>

    <view slot="footer" class="chat-disclaimer">
      <text>科普信息，请结合线下医疗机构意见理解。</text>
    </view>
  </t-chat>

  <t-chat-actionbar
    wx:if="{{activePopoverId && longPressPosition}}"
    placement="longpress"
    chat-id="{{activePopoverId}}"
    long-press-position="{{longPressPosition}}"
    action-bar="{{popoverActionBarItems}}"
    bind:actions="onMessageAction"
  />

  <t-chat-sender
    class="chat-sender"
    value="{{inputValue}}"
    placeholder="输入健康术语、筛查常识或复查准备问题..."
    loading="{{isSending}}"
    visible="{{senderVisible}}"
    file-list="{{senderFiles}}"
    attachments-props="{{senderAttachmentsProps}}"
    render-presets="{{senderPresets}}"
    textarea-props="{{textareaProps}}"
    adjust-position="{{true}}"
    bind:change="onInputChange"
    bind:send="onSend"
    bind:stop="onStopStream"
    bind:fileChange="onSenderFileChange"
    bind:fileSelect="onSenderFileSelect"
    bind:fileDelete="onSenderFileDelete"
    bind:updateVisible="onSenderVisibleChange"
    bind:updatevisible="onSenderVisibleChange"
  >
    <view slot="footer-prefix" class="sender-prefix">
      <t-chat-loading wx:if="{{isSending}}" class="sender-inline-loading" animation="dots" />
      <view
        class="sender-toggle {{deepThinkActive ? 'sender-toggle-active' : ''}}"
        hover-class="sender-toggle-hover"
        bind:tap="onDeepThinkTap"
      >
        <t-icon class="sender-toggle-icon" name="chat-bubble-help" size="28rpx" />
        <text class="sender-toggle-text">深度思考</text>
      </view>
      <view
        class="sender-toggle {{netSearchActive ? 'sender-toggle-active' : ''}}"
        hover-class="sender-toggle-hover"
        bind:tap="onNetSearchTap"
      >
        <t-icon class="sender-toggle-icon" name="internet" size="28rpx" />
        <text class="sender-toggle-text">联网检索</text>
      </view>
    </view>
  </t-chat-sender>
</view>
