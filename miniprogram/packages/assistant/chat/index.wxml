<view class="chat-page">
  <view class="chat-notice">
    仅提供健康科普与记录整理，不能替代线下医疗意见。
  </view>

  <view wx:if="{{messages.length === 0}}" class="chat-welcome">
    <view class="welcome-hero">
      <view class="welcome-avatar-shell">
        <view class="welcome-avatar-glow"></view>
        <image class="welcome-avatar-img" src="{{botAvatar}}" mode="aspectFit" />
      </view>
      <text class="welcome-title">健康科普助手</text>
      <text class="welcome-subtitle">整理筛查常识、术语解释和复查准备问题</text>
      <view class="welcome-pill-row">
        <view class="welcome-pill">
          <t-icon name="check-circle" size="24rpx" />
          <text>科普信息</text>
        </view>
        <view class="welcome-pill">
          <t-icon name="time" size="24rpx" />
          <text>复查准备</text>
        </view>
      </view>
    </view>

    <view class="welcome-card">
      <view class="welcome-card-head">
        <view>
          <text class="welcome-card-title">可以这样问</text>
          <text class="welcome-card-subtitle">选择一个问题，快速开始整理</text>
        </view>
        <t-icon class="welcome-card-icon" name="chat-bubble-help" size="34rpx" />
      </view>
      <view class="suggestion-grid">
        <view wx:for="{{suggestionRows}}" wx:key="id" class="suggestion-row">
          <view
            class="suggestion-item"
            hover-class="suggestion-item-hover"
            bind:tap="onSuggestionTap"
            data-text="{{item.left.text}}"
          >
            <view class="suggestion-icon-wrap">
              <t-icon class="suggestion-icon" name="{{item.left.icon}}" size="34rpx" />
            </view>
            <text class="suggestion-text">{{item.left.text}}</text>
          </view>
          <view
            wx:if="{{item.right}}"
            class="suggestion-item"
            hover-class="suggestion-item-hover"
            bind:tap="onSuggestionTap"
            data-text="{{item.right.text}}"
          >
            <view class="suggestion-icon-wrap">
              <t-icon class="suggestion-icon" name="{{item.right.icon}}" size="34rpx" />
            </view>
            <text class="suggestion-text">{{item.right.text}}</text>
          </view>
          <view wx:else class="suggestion-item suggestion-item-placeholder"></view>
        </view>
      </view>
    </view>
  </view>

  <t-chat
    wx:else
    class="chat-list"
    id="chatList"
    layout="both"
    reverse="{{false}}"
    animation="gradient"
  >
    <block wx:for="{{chatData}}" wx:key="id">
      <t-chat-message
        chat-id="{{item.id}}"
        avatar="{{item.avatar}}"
        name="{{item.name}}"
        datetime="{{item.datetime}}"
        role="{{item.role}}"
        placement="{{item.placement}}"
        status="{{item.status}}"
        content="{{emptyContent}}"
        variant="base"
        bind:message-longpress="onMessageLongPress"
      >
        <view slot="content" class="message-content">
          <t-chat-loading
            wx:if="{{item.status === 'pending' && !item.showThinking && !item.reasoning}}"
            animation="gradient"
            text="正在梳理健康科普要点..."
          />

          <t-chat-thinking
            wx:if="{{item.showThinking || item.reasoning}}"
            class="thinking-panel"
            content="{{item.thinkingContent}}"
            status="{{item.status === 'complete' ? 'complete' : 'pending'}}"
            layout="border"
            animation="gradient"
            collapsed="{{false}}"
            max-height="{{220}}"
          >
            <text slot="content" class="thinking-stream-text">{{item.reasoning}}</text>
          </t-chat-thinking>

          <t-chat-content
            wx:if="{{item.text}}"
            role="{{item.role}}"
            status="{{item.status}}"
            content="{{item.contentItem}}"
            markdown-props="{{item.markdownProps}}"
          />

          <t-attachments
            wx:if="{{item.attachments.length}}"
            items="{{item.attachments}}"
            removable="{{false}}"
            image-viewer="{{true}}"
          />

          <text wx:if="{{item.disclaimer}}" class="message-disclaimer">{{item.disclaimer}}</text>
        </view>

        <t-chat-actionbar
          wx:if="{{item.role === 'assistant'}}"
          slot="actionbar"
          chat-id="{{item.id}}"
          content="{{item.text}}"
          action-bar="{{actionBarItems}}"
          bind:actions="onMessageAction"
        />
      </t-chat-message>
    </block>

    <view slot="footer" class="chat-disclaimer">
      <text>科普信息，请结合线下医疗机构意见理解。</text>
    </view>
  </t-chat>

  <t-chat-actionbar
    wx:if="{{activePopoverId && longPressPosition}}"
    placement="longpress"
    chat-id="{{activePopoverId}}"
    long-press-position="{{longPressPosition}}"
    action-bar="{{popoverActionBarItems}}"
    bind:actions="onMessageAction"
  />

  <t-chat-sender
    class="chat-sender {{senderKeyboardActive ? 'chat-sender-keyboard' : ''}}"
    value="{{inputValue}}"
    custom-style="{{senderKeyboardStyle}}"
    placeholder="输入健康术语、筛查常识或复查准备问题..."
    loading="{{isSending}}"
    visible="{{senderVisible}}"
    file-list="{{senderFiles}}"
    attachments-props="{{senderAttachmentsProps}}"
    render-presets="{{senderPresets}}"
    textarea-props="{{textareaProps}}"
    adjust-position="{{false}}"
    auto-rise-with-keyboard="{{true}}"
    bind:change="onInputChange"
    bind:send="onSend"
    bind:stop="onStopStream"
    bind:keyboardheightchange="onSenderKeyboardHeightChange"
    bind:fileChange="onSenderFileChange"
    bind:fileSelect="onSenderFileSelect"
    bind:fileDelete="onSenderFileDelete"
    bind:updateVisible="onSenderVisibleChange"
    bind:updatevisible="onSenderVisibleChange"
  >
    <view slot="footer-prefix" class="sender-prefix">
      <t-chat-loading wx:if="{{isSending}}" class="sender-inline-loading" animation="dots" />
      <view
        class="sender-toggle {{deepThinkActive ? 'sender-toggle-active' : ''}}"
        hover-class="sender-toggle-hover"
        bind:tap="onDeepThinkTap"
      >
        <t-icon class="sender-toggle-icon" name="chat-bubble-help" size="28rpx" />
        <text class="sender-toggle-text">深度思考</text>
      </view>
      <view
        class="sender-toggle {{netSearchActive ? 'sender-toggle-active' : ''}}"
        hover-class="sender-toggle-hover"
        bind:tap="onNetSearchTap"
      >
        <t-icon class="sender-toggle-icon" name="internet" size="28rpx" />
        <text class="sender-toggle-text">联网检索</text>
      </view>
    </view>
  </t-chat-sender>
</view>
