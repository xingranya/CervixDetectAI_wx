.service-page {
  padding-bottom: 72rpx;
}

.service-hero,
.service-panel,
.safe-note {
  box-sizing: border-box;
}

.service-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card);
  box-shadow: 0 14rpx 36rpx rgba(var(--wx-brand-500-rgb), 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--wx-bg-section);
  flex: 0 0 auto;
}

.hero-copy,
.service-body {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.service-title,
.service-text,
.safe-note {
  display: block;
}

.hero-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--wx-text-muted);
  font-size: 25rpx;
  line-height: 1.62;
}

.service-panel {
  overflow: hidden;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card-88);
  box-shadow: 0 16rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.06);
}

.service-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.service-row:last-child {
  border-bottom: 0;
}

.service-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--wx-bg-section);
  color: var(--wx-brand-500);
  font-size: 22rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.service-title {
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.service-text {
  margin-top: 10rpx;
  color: var(--wx-text-tertiary);
  font-size: 26rpx;
  line-height: 1.68;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}
