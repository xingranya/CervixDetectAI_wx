.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.privacy-list {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 38rpx rgba(31, 83, 201, 0.06);
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(195, 198, 214, 0.26);
}

.privacy-row:last-child {
  border-bottom: 0;
}

.privacy-icon {
  width: 72rpx;
  height: 72rpx;
}

.privacy-body {
  flex: 1;
}

.privacy-title {
  display: block;
  color: #0b1c30;
  font-size: 31rpx;
  font-weight: 900;
}

.privacy-text {
  display: block;
  margin-top: 12rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.7;
}
