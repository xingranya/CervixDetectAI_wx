.privacy-page {
  padding-bottom: 72rpx;
}

.privacy-hero,
.privacy-panel,
.safe-note {
  box-sizing: border-box;
}

.privacy-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 36rpx rgba(31, 83, 201, 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #eef3ff;
  flex: 0 0 auto;
}

.hero-icon-image {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.hero-copy,
.privacy-body {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.privacy-title,
.privacy-text,
.safe-note {
  display: block;
}

.hero-title {
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: #617089;
  font-size: 25rpx;
  line-height: 1.62;
}

.privacy-panel {
  overflow: hidden;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(31, 83, 201, 0.06);
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(199, 210, 232, 0.48);
}

.privacy-row:last-child {
  border-bottom: 0;
}

.privacy-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #1f53c9;
  font-size: 22rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.privacy-title {
  color: #10233c;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.privacy-text {
  margin-top: 10rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.68;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.62);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}
