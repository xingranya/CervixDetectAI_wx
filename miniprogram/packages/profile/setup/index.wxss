.setup-page {
  padding-bottom: 72rpx;
}

.setup-hero,
.setup-card,
.popup-panel {
  box-sizing: border-box;
}

.setup-hero {
  margin-bottom: 24rpx;
}

.setup-title,
.setup-desc,
.setup-section-title,
.setup-note,
.editor-label,
.avatar-placeholder-text,
.avatar-upload-note,
.popup-title,
.popup-desc {
  display: block;
}

.setup-title {
  color: #0b1c30;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
}

.setup-desc {
  margin-top: 16rpx;
  color: #5f6f86;
  font-size: 26rpx;
  line-height: 1.68;
}

.setup-card {
  padding: 26rpx;
  border: 1rpx solid rgba(198, 210, 236, 0.58);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 83, 201, 0.05);
}

.setup-section-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 900;
}

.setup-note {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.62;
}

.agreement-links {
  margin-top: 14rpx;
  line-height: 1.7;
}

.agreement-link,
.agreement-separator {
  font-size: 25rpx;
}

.agreement-link {
  color: #1f53c9;
  font-weight: 800;
}

.agreement-separator {
  margin: 0 8rpx;
  color: #4d5d73;
}

.setup-form,
.setup-actions {
  margin-top: 24rpx;
}

.editor-label {
  color: #1e293b;
  font-size: 27rpx;
  font-weight: 900;
}

.avatar-label {
  margin-top: 22rpx;
}

.editor-input {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 18rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 29rpx;
  box-sizing: border-box;
}

.editor-placeholder {
  color: #64748b;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx !important;
  height: 180rpx !important;
  margin-top: 16rpx;
  padding: 0 !important;
  border: 1rpx solid rgba(195, 198, 214, 0.52) !important;
  border-radius: 50% !important;
  background: rgba(248, 249, 255, 0.72) !important;
  overflow: hidden;
}

.avatar-picker::after,
.primary-button::after,
.secondary-button::after,
.popup-cancel::after,
.popup-confirm::after {
  border: 0;
}

.avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.avatar-placeholder-text {
  color: #5f6f86;
  font-size: 22rpx;
}

.avatar-upload-note {
  margin-top: 14rpx;
  color: #5f6f86;
  font-size: 23rpx;
  line-height: 1.6;
}

.primary-button,
.secondary-button,
.popup-cancel,
.popup-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
}

.setup-save-button {
  margin-top: 24rpx;
}

.secondary-button {
  width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: rgba(24, 118, 210, 0.08);
  color: #1f53c9;
  font-size: 28rpx;
  font-weight: 800;
}

.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: rgba(11, 28, 48, 0.48);
}

.popup-panel {
  width: 100%;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 26rpx 70rpx rgba(11, 28, 48, 0.2);
}

.popup-title {
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
}

.popup-desc {
  margin-top: 16rpx;
  color: #3e4a5f;
  font-size: 26rpx;
  line-height: 1.7;
}

.popup-links {
  margin-top: 18rpx;
}

.popup-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.popup-cancel {
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
}

.popup-confirm {
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #ffffff;
}
