.setup-page {
  padding-bottom: 72rpx;
}

.setup-hero,
.setup-card,
.popup-panel {
  box-sizing: border-box;
}

.setup-hero {
  margin-bottom: 24rpx;
}

.setup-title,
.setup-desc,
.setup-section-title,
.setup-note,
.editor-label,
.avatar-placeholder-text,
.avatar-upload-note,
.popup-title,
.popup-desc {
  display: block;
}

.setup-title {
  color: var(--wx-text-primary);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
}

.setup-desc {
  margin-top: 16rpx;
  color: var(--wx-text-tertiary);
  font-size: 26rpx;
  line-height: 1.68;
}

.setup-card {
  padding: 26rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: 24rpx;
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-elevated);
}

.setup-section-title {
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
}

.setup-note {
  margin-top: 12rpx;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.62;
}

.agreement-links {
  margin-top: 14rpx;
  line-height: 1.7;
}

.agreement-link,
.agreement-separator {
  font-size: 25rpx;
}

.agreement-link {
  color: var(--wx-brand-500);
  font-weight: 800;
}

.agreement-separator {
  margin: 0 8rpx;
  color: var(--wx-text-secondary);
}

.setup-form,
.setup-actions {
  margin-top: 24rpx;
}

.editor-label {
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 900;
}

.avatar-label {
  margin-top: 22rpx;
}

.editor-input {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--wx-border-light);
  border-radius: 18rpx;
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 29rpx;
  box-sizing: border-box;
}

.editor-placeholder {
  color: var(--wx-text-tertiary);
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx !important;
  height: 180rpx !important;
  margin-top: 16rpx;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-light) !important;
  border-radius: 50% !important;
  background: var(--wx-bg-input) !important;
  overflow: hidden;
}

.avatar-picker::after,
.primary-button::after,
.secondary-button::after,
.popup-cancel::after,
.popup-confirm::after {
  border: 0;
}

.avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.avatar-placeholder-text {
  color: var(--wx-text-tertiary);
  font-size: 22rpx;
}

.avatar-upload-note {
  margin-top: 14rpx;
  color: var(--wx-text-tertiary);
  font-size: 23rpx;
  line-height: 1.6;
}

.primary-button,
.secondary-button,
.popup-cancel,
.popup-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 29rpx;
  font-weight: 800;
}

.setup-save-button {
  margin-top: 24rpx;
}

.secondary-button {
  width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-500);
  font-size: 28rpx;
  font-weight: 800;
}

.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: var(--wx-overlay);
}

.popup-panel {
  width: 100%;
  padding: 34rpx;
  border-radius: 28rpx;
  background: var(--wx-bg-primary);
  box-shadow: 0 26rpx 70rpx var(--wx-shadow-sheet);
}

.popup-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.popup-desc {
  margin-top: 16rpx;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.popup-links {
  margin-top: 18rpx;
}

.popup-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.popup-cancel,
.popup-confirm {
  flex: 1;
  height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.popup-cancel {
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-500);
}

.popup-confirm {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
}
