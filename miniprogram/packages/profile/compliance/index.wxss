.compliance-page {
  padding-bottom: 72rpx;
}

.boundary-hero,
.scope-row,
.scope-cell,
.boundary-panel,
.safe-note {
  box-sizing: border-box;
}

.boundary-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card);
  box-shadow: 0 14rpx 36rpx rgba(var(--wx-brand-500-rgb), 0.07);
}

.boundary-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--wx-bg-section);
  flex: 0 0 auto;
}

.boundary-mark-image {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.boundary-copy {
  flex: 1;
  min-width: 0;
}

.boundary-title,
.boundary-desc,
.scope-value,
.scope-label,
.panel-title,
.panel-desc,
.boundary-text,
.safe-note {
  display: block;
}

.boundary-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.boundary-desc {
  margin-top: 10rpx;
  color: var(--wx-text-muted);
  font-size: 25rpx;
  line-height: 1.62;
}

.scope-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.scope-cell {
  flex: 1;
  min-width: 0;
  padding: 18rpx 10rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  text-align: center;
}

.scope-value {
  color: var(--wx-brand-500);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.scope-label {
  margin-top: 6rpx;
  color: var(--wx-text-tertiary);
  font-size: 21rpx;
  line-height: 1.3;
}

.boundary-panel {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card-88);
  box-shadow: 0 16rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.06);
}

.restricted-panel {
  background: rgba(255, 252, 251, 0.9);
}

.panel-heading {
  margin-bottom: 14rpx;
}

.panel-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.58;
}

.boundary-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.boundary-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.row-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.allow-mark {
  background: var(--wx-brand-500);
}

.restrict-mark {
  background: var(--wx-bg-danger-surface);
}

.row-mark-image {
  display: block;
  width: 22rpx;
  height: 22rpx;
}

.boundary-text {
  flex: 1;
  min-width: 0;
  color: var(--wx-text-label);
  font-size: 26rpx;
  line-height: 1.62;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}
