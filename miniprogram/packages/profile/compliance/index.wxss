.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.small-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.boundary-hero {
  padding: 34rpx 30rpx;
  background:
    radial-gradient(circle at 90% 0, rgba(38, 166, 154, 0.16), transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(239, 255, 252, 0.76));
}

.boundary-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1f53c9, #26a69a);
  box-shadow: 0 14rpx 32rpx rgba(31, 83, 201, 0.18);
}

.boundary-mark image {
  width: 42rpx;
  height: 42rpx;
}

.boundary-title,
.boundary-desc,
.boundary-section-title,
.cell-value,
.cell-label {
  display: block;
}

.boundary-title {
  margin-top: 24rpx;
  color: #0b1c30;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.22;
}

.boundary-desc {
  margin-top: 16rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.7;
}

.compliance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.compliance-cell {
  padding: 20rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  text-align: center;
}

.cell-value {
  color: #1f53c9;
  font-size: 26rpx;
  font-weight: 900;
}

.cell-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
}

.boundary-section-title {
  margin-bottom: 18rpx;
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
}

.boundary-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 0;
  color: #425d96;
  font-size: 27rpx;
  line-height: 1.6;
}

.warning-card {
  background: rgba(255, 250, 247, 0.78);
}
