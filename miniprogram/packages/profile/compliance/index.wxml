<view class="page compliance-page">
  <section-header title="合规与服务边界" weui-icon="info" desc="确认健康记录工具的使用范围。" />

  <view class="boundary-hero">
    <view class="boundary-mark">
      <mp-icon icon="info" color="#1f53c9" size="{{34}}" />
    </view>
    <view class="boundary-copy">
      <text class="boundary-title">健康记录工具，不是医疗服务</text>
      <text class="boundary-desc">本小程序用于个人健康信息整理、复查计划管理和线下咨询前准备，不提供诊断、治疗、处方或在线问诊。</text>
    </view>
  </view>

  <view class="scope-row">
    <view wx:for="{{checklist}}" wx:key="label" class="scope-cell">
      <text class="scope-value">{{item.value}}</text>
      <text class="scope-label">{{item.label}}</text>
    </view>
  </view>

  <view class="boundary-panel">
    <view class="panel-heading">
      <text class="panel-title">可以使用的功能</text>
      <text class="panel-desc">用于记录、提醒和整理线下沟通资料。</text>
    </view>
    <view wx:for="{{allowedItems}}" wx:key="*this" class="boundary-row">
      <view class="row-mark allow-mark">
        <mp-icon icon="info" color="#ffffff" size="{{16}}" />
      </view>
      <text class="boundary-text">{{item}}</text>
    </view>
  </view>

  <view class="boundary-panel restricted-panel">
    <view class="panel-heading">
      <text class="panel-title">明确不提供的服务</text>
      <text class="panel-desc">涉及健康判断时，请以线下正规医疗机构意见为准。</text>
    </view>
    <view wx:for="{{restrictedItems}}" wx:key="*this" class="boundary-row">
      <view class="row-mark restrict-mark">
        <mp-icon icon="close" color="#ffffff" size="{{16}}" />
      </view>
      <text class="boundary-text">{{item}}</text>
    </view>
  </view>

  <view class="safe-note">如出现明显不适或紧急情况，请及时联系线下正规医疗机构或当地急救服务。</view>
</view>
