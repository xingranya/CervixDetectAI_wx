.feedback-page {
  padding-bottom: 72rpx;
}

.feedback-hero,
.feedback-panel,
.official-feedback-card,
.safe-note {
  box-sizing: border-box;
}

.feedback-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 36rpx rgba(31, 83, 201, 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #1f53c9;
  flex: 0 0 auto;
}

.hero-icon-image {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.form-label,
.guest-tip,
.official-title,
.official-desc,
.safe-note,
.form-error {
  display: block;
}

.hero-title {
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: #617089;
  font-size: 25rpx;
  line-height: 1.62;
}

.feedback-panel {
  padding: 30rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(31, 83, 201, 0.06);
}

.field-block {
  margin-top: 28rpx;
}

.field-block:first-of-type {
  margin-top: 0;
}

.form-label {
  margin-bottom: 12rpx;
  color: #10233c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 18rpx;
  background: #f8faff;
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.select-value {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.select-arrow {
  color: #8b9ab0;
  font-size: 40rpx;
  line-height: 1;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 236rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.primary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 88rpx;
  border-radius: 18rpx;
  background: #1f53c9;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(31, 83, 201, 0.2);
}

.ghost-button {
  width: 192rpx;
  height: 70rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.2);
  border-radius: 16rpx;
  background: #fff;
  color: #1f53c9;
  font-size: 26rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-submit {
  margin-top: 34rpx;
}

.form-error {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.16);
  border-radius: 18rpx;
  background: #fff3f1;
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}

.guest-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f3f6fc;
  color: #5c6d86;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-weui-cells {
  margin: 0 !important;
  background: transparent !important;
}

.form-weui-cells .weui-cell {
  display: block !important;
  padding: 22rpx 0 !important;
}

.form-weui-cells .weui-cell__hd,
.form-weui-cells .weui-cell__bd {
  display: block !important;
  width: 100% !important;
}

.form-weui-cells .weui-label {
  width: 100% !important;
  margin-bottom: 14rpx;
  color: #10233c;
  font-size: 26rpx;
  font-weight: 800;
}

.form-weui-cells .weui-cell__bd {
  margin-top: 12rpx;
  min-width: 0 !important;
}

.form-weui-cells .weui-cell::before {
  left: 0 !important;
  right: 0 !important;
}

mp-cell + mp-cell {
  margin-top: 0;
}

.official-feedback-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.66);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
}

.official-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
}

.official-feedback-card .ghost-button {
  width: 100%;
  min-width: 0;
}

.ghost-button-secondary {
  width: 100% !important;
}

.attachment-preview-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.attachment-preview {
  width: 128rpx;
  height: 128rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #eef3ff;
}

.attachment-preview::after {
  border: 0;
}

.attachment-preview-image {
  display: block;
  width: 128rpx;
  height: 128rpx;
}

.official-copy {
  flex: 1;
  min-width: 0;
}

.official-title {
  color: #10233c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.official-desc {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.58;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.62);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.official-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.36);
  box-sizing: border-box;
}

.official-sheet {
  width: 100%;
  padding: 30rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 22rpx 54rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
}

.official-sheet-title,
.official-sheet-desc {
  display: block;
}

.official-sheet-title {
  color: #10233c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.official-sheet-desc {
  margin-top: 12rpx;
  color: #4d5d73;
  font-size: 25rpx;
  line-height: 1.62;
}

.official-sheet-button {
  width: 100%;
  height: 78rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: rgb(24, 118, 210);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.official-sheet-button::after {
  border: 0;
}
