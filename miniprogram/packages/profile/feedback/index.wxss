.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.ghost-button {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.ghost-button {
  white-space: nowrap;
  height: 76rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #1f53c9;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-error {
  display: block;
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.24);
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.feedback-card {
  padding-bottom: 38rpx;
}

.guest-tip {
  display: block;
  margin-bottom: 22rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 800;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.picker-value {
  color: #0f172a;
}

.form-submit {
  margin-top: 34rpx;
}

.official-feedback-card {
  display: block;
}

.official-copy {
  margin-bottom: 22rpx;
}

.official-title,
.official-desc {
  display: block;
}

.official-title {
  color: #0b1c30;
  font-size: 31rpx;
  font-weight: 900;
}

.official-desc {
  margin-top: 10rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.65;
}
