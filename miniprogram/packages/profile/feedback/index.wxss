.feedback-page {
  padding-bottom: 72rpx;
}

.feedback-hero,
.feedback-panel,
.official-feedback-card,
.safe-note {
  box-sizing: border-box;
}

.feedback-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card);
  box-shadow: 0 14rpx 36rpx rgba(var(--wx-brand-500-rgb), 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--wx-brand-500);
  flex: 0 0 auto;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.guest-tip,
.official-title,
.official-desc,
.safe-note,
.official-sheet-title,
.official-sheet-desc {
  display: block;
}

.hero-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.62;
}

.feedback-panel {
  padding: 30rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card-88);
  box-shadow: 0 16rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.06);
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid var(--wx-border-input-alt);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.select-value {
  color: var(--wx-text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 236rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.form-placeholder {
  color: var(--wx-text-secondary);
}

.primary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.2);
}

.ghost-button {
  width: 192rpx;
  height: 70rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.2);
  border-radius: 16rpx;
  background: var(--wx-bg-primary);
  color: var(--wx-brand-500);
  font-size: 26rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.form-submit {
  margin-top: 34rpx;
}

.upload-section {
  margin-top: 22rpx;
}

.upload-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--wx-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.upload-tips {
  display: block;
  margin-bottom: 14rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

.guest-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--wx-bg-secondary);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.form-cells {
  margin: 0;
  background: transparent;
}

.form-cell {
  display: block;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.form-cell:last-child {
  border-bottom: none;
}

.form-cell-title {
  display: block;
  width: 100%;
  margin-bottom: 14rpx;
  color: var(--wx-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.official-feedback-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 22rpx;
  background: var(--wx-bg-glass);
}

.official-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
}

.official-feedback-card .ghost-button {
  width: 100%;
  min-width: 0;
}

.ghost-button-secondary {
  width: 100% !important;
}

.attachment-preview-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.attachment-preview {
  width: 128rpx;
  height: 128rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--wx-bg-section);
}

.attachment-preview::after {
  border: 0;
}

.attachment-preview-image {
  display: block;
  width: 128rpx;
  height: 128rpx;
}

.official-copy {
  flex: 1;
  min-width: 0;
}

.official-title {
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.official-desc {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.58;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.official-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--wx-shadow-bottom-sheet);
  box-sizing: border-box;
}

.official-sheet {
  width: 100%;
  padding: 30rpx;
  border-radius: 26rpx;
  background: var(--wx-bg-primary);
  box-shadow: 0 22rpx 54rpx var(--wx-shadow-confirm);
  box-sizing: border-box;
}

.official-sheet-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.official-sheet-desc {
  margin-top: 12rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.62;
}

.official-sheet-button {
  width: 100%;
  height: 78rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.official-sheet-button::after {
  border: 0;
}
