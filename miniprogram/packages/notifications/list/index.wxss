.notifications-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ---- Action Bar ---- */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.12);
  border-radius: var(--wx-radius-sm);
  background: rgba(var(--wx-brand-500-rgb), 0.04);
}

.unread-summary {
  color: var(--wx-brand-700);
  font-size: 25rpx;
  font-weight: 800;
}

.mark-all {
  height: 48rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
}

/* ---- Notification List ---- */
.notification-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notification-card {
  padding: 24rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

.notification-unread {
  border-left: 6rpx solid var(--wx-brand-500);
  background: rgba(var(--wx-brand-500-rgb), 0.02);
}

.notification-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.notification-type-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.type-system {
  background: rgba(var(--wx-brand-500-rgb), 0.10);
}

.type-reminder {
  background: var(--wx-warning-light);
}

.type-record {
  background: var(--wx-success-light);
}

.type-ai {
  background: var(--wx-diagnosis-normal-bg);
}

.type-icon-text {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--wx-text-primary);
}

.notification-meta {
  flex: 1;
  min-width: 0;
}

.notification-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  display: block;
  margin-top: 4rpx;
  color: var(--wx-text-tertiary);
  font-size: 22rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--wx-brand-500);
  flex-shrink: 0;
}

.notification-content {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
  overflow-wrap: break-word;
}

/* ---- Shared Styles ---- */
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: var(--wx-radius-sm);
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: var(--wx-shadow-button);
}

.primary-button::after,
.text-button::after {
  border: 0;
}

.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 700;
}
