<view class="page notifications-page">
  <section-header title="通知中心" weui-icon="info" desc="查看系统通知、复查提醒和健康助手消息。" />

  <view wx:if="{{unreadCount > 0}}" class="action-bar">
    <text class="unread-summary">{{unreadCount}} 条未读</text>
    <button class="text-button mark-all" hover-class="u-hover" bind:tap="markAllRead">
      <text class="button-text">全部已读</text>
    </button>
  </view>

  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <view class="local-loading">
      <view class="loading-ring"></view>
      <text class="loading-text">正在加载通知</text>
    </view>
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载通知</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" hover-class="u-hover" bind:tap="loadNotifications">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="暂无通知"
    desc="当有新的复查提醒、记录更新或健康助手消息时，会在这里展示。"
    weui-icon="info"
  />

  <block wx:else>
    <view class="notification-list" aria-role="list">
      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="notification-card {{item.isRead ? '' : 'notification-unread'}}"
        hover-class="u-hover"
        bind:tap="onNotificationTap"
        data-id="{{item.id}}"
        data-extra="{{item.extra}}"
        aria-role="listitem"
        aria-label="{{item.title}}，{{item.isRead ? '已读' : '未读'}}"
      >
        <view class="notification-header">
          <view class="notification-type-icon type-{{item.type}}">
            <text class="type-icon-text">{{item.typeIcon}}</text>
          </view>
          <view class="notification-meta">
            <text class="notification-title">{{item.title}}</text>
            <text class="notification-time">{{item.timeText}}</text>
          </view>
          <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
        </view>
        <text class="notification-content">{{item.content}}</text>
      </view>
    </view>
  </block>
</view>
