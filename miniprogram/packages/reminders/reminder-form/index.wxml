<view class="page">
  <view class="card form-card">
    <section-header title="{{id ? '编辑复查提醒' : '新增复查提醒'}}" icon="/assets/icons/form-active.png" />

    <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>

    <view wx:if="{{!id}}" class="quick-section">
      <text class="section-label">常用提醒</text>
      <scroll-view class="template-scroll" scroll-x>
        <button
          wx:for="{{reminderTemplates}}"
          wx:key="name"
          class="template-card"
          data-index="{{index}}"
          bind:tap="applyTemplate"
        >
          <text class="template-title">{{item.name}}</text>
          <text class="template-desc">{{item.desc}}</text>
        </button>
      </scroll-view>
    </view>

    <text class="form-label">提醒类型</text>
    <picker mode="selector" range="{{titleOptions}}" value="{{titleIndex}}" bind:change="onTitleTemplateChange">
      <view class="form-input picker-value">{{titleOptions[titleIndex]}}</view>
    </picker>

    <text class="form-label">提醒标题</text>
    <input class="form-input" value="{{form.title}}" data-field="title" bind:input="onInput" maxlength="60" placeholder="例如：复查提醒" />

    <text class="form-label">提醒日期</text>
    <picker mode="date" value="{{form.date}}" bind:change="onDateChange">
      <view class="form-input picker-value">{{form.date || '请选择日期'}}</view>
    </picker>
    <view class="chip-row">
      <button
        wx:for="{{quickDateOptions}}"
        wx:key="label"
        class="choice-chip"
        data-offset="{{item.offsetDays}}"
        bind:tap="selectQuickDate"
      >
        <text>{{item.label}}</text>
      </button>
    </view>

    <text class="form-label">提醒内容</text>
    <textarea class="form-textarea" value="{{form.desc}}" data-field="desc" bind:input="onInput" maxlength="500" placeholder="例如：提前准备近期检查摘要和问题清单。" />
    <text class="field-hint">{{form.desc.length || 0}} / 500</text>

    <label class="switch-row">
      <text>标记为已完成</text>
      <switch checked="{{form.done}}" color="#1976d2" bind:change="onDoneChange" />
    </label>

    <view class="subscribe-card">
      <view class="subscribe-copy">
        <text class="subscribe-title">微信服务通知</text>
        <text class="subscribe-desc">{{subscriptionMessage}}</text>
      </view>
      <button wx:if="{{subscriptionEnabled}}" class="text-button" bind:tap="requestSubscription">
        <text class="button-text">{{subscriptionAccepted ? '已开启' : '开启通知'}}</text>
      </button>
      <text wx:else class="subscribe-status">保存到小程序内</text>
    </view>

    <button class="primary-button form-submit" disabled="{{loading}}" bind:tap="submitForm">
      <view class="button-content">
        <image class="button-icon" src="/assets/icons/save-white.png" mode="aspectFit" />
        <text class="button-text">{{loading ? '正在保存' : '保存提醒'}}</text>
      </view>
    </button>
  </view>
  <view class="safe-note">微信服务通知需用户主动授权；未开启时，提醒仍会保存在小程序内，方便你随时查看。</view>
</view>
