<view class="page reminder-form-page">
  <section-header title="{{pageTitle}}" weui-icon="time" desc="设置线下复查、资料准备或咨询前整理提醒。" />

  <mp-toptips msg="{{errorMessage}}" type="error" show="{{!!errorMessage}}" />

  <view wx:if="{{!id}}" class="form-panel template-panel">
    <view class="panel-heading">
      <text class="panel-title">常用提醒</text>
      <text class="panel-desc">选择后会自动填入提醒类型、内容和建议日期，可继续修改。</text>
    </view>
    <view class="template-row">
      <button class="template-card" data-template="复查" bind:tap="applyTemplate">
        <view class="template-title-wrap">
          <text class="template-title">复查</text>
        </view>
        <text class="template-desc">到期前安排复查</text>
      </button>
      <button class="template-card" data-template="资料" bind:tap="applyTemplate">
        <view class="template-title-wrap">
          <text class="template-title">资料</text>
        </view>
        <text class="template-desc">整理摘要和历史记录</text>
      </button>
      <button class="template-card" data-template="问题" bind:tap="applyTemplate">
        <view class="template-title-wrap">
          <text class="template-title">问题</text>
        </view>
        <text class="template-desc">咨询前整理问题</text>
      </button>
    </view>
  </view>

  <mp-form id="form" rules="{{formRules}}" models="{{formModel}}" bindfail="onFormFail">
    <view class="form-panel">
      <view class="panel-heading">
        <text class="panel-title">提醒类型</text>
        <text class="panel-desc">选择当前提醒最接近的用途。</text>
      </view>
      <view class="chip-row type-row">
        <button wx:for="{{titleOptionsView}}" wx:key="title" class="{{item.className}}" data-title="{{item.title}}" bind:tap="selectTitle">
          <text>{{item.label}}</text>
        </button>
      </view>
      <mp-cells ext-class="form-weui-cells">
        <mp-cell title="提醒标题" prop="title" show-error="{{true}}" inline="{{false}}">
          <input class="form-input" value="{{title}}" bind:input="onTitleInput" maxlength="60" placeholder="例如：复查提醒" placeholder-class="form-placeholder" />
        </mp-cell>
      </mp-cells>
    </view>

    <view class="form-panel">
      <view class="panel-heading">
        <text class="panel-title">时间安排</text>
        <text class="panel-desc">可选择具体日期，也可以使用快捷时间。</text>
      </view>
      <mp-cells ext-class="form-weui-cells">
        <mp-cell title="提醒日期" prop="date" show-error="{{true}}" inline="{{false}}">
          <picker mode="date" value="{{date}}" bind:change="onDateChange">
            <view class="select-field">
              <text class="select-value">{{dateDisplay}}</text>
              <mp-icon icon="arrow" color="#4d5d73" size="{{16}}" />
            </view>
          </picker>
        </mp-cell>
      </mp-cells>

      <view class="quick-date-row">
        <button class="quick-date-chip" data-offset="0" bind:tap="selectQuickDate">
          <text>今天</text>
        </button>
        <button class="quick-date-chip" data-offset="3" bind:tap="selectQuickDate">
          <text>3天后</text>
        </button>
        <button class="quick-date-chip" data-offset="7" bind:tap="selectQuickDate">
          <text>1周后</text>
        </button>
        <button class="quick-date-chip" data-offset="30" bind:tap="selectQuickDate">
          <text>1个月后</text>
        </button>
      </view>
    </view>

    <view class="form-panel">
      <view class="panel-heading">
        <text class="panel-title">提醒内容</text>
        <text class="panel-desc">写清楚到时需要完成的准备事项。</text>
      </view>
      <mp-cells ext-class="form-weui-cells">
        <mp-cell title="内容" prop="desc" show-error="{{true}}" inline="{{false}}">
          <view class="label-row">
            <text class="field-hint">{{descLength}} / 500</text>
          </view>
          <textarea class="form-textarea" value="{{desc}}" bind:input="onDescInput" maxlength="500" placeholder="例如：提前准备近期检查摘要和问题清单。" placeholder-class="form-placeholder" />
        </mp-cell>
      </mp-cells>

      <mp-cells ext-class="weui-choice-cells">
        <mp-checkbox-group multi="{{true}}" bindchange="onDoneChange">
          <mp-checkbox wx:for="{{doneItems}}" wx:key="value" label="{{item.label}}" value="{{item.value}}" checked="{{item.checked}}"></mp-checkbox>
        </mp-checkbox-group>
      </mp-cells>
    </view>
  </mp-form>

  <view class="submit-panel">
    <button class="primary-button form-submit" disabled="{{loading}}" bind:tap="submitForm">
      <view class="button-content">
        <mp-icon icon="time" color="#ffffff" size="{{18}}" />
        <text class="button-text">{{submitText}}</text>
      </view>
    </button>
  </view>
</view>
