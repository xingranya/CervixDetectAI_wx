.reminder-form-page {
  padding-bottom: 72rpx;
}

.form-panel,
.submit-panel,
.form-error {
  box-sizing: border-box;
}

.form-panel,
.submit-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(31, 83, 201, 0.06);
}

.template-panel {
  background: rgba(255, 255, 255, 0.82);
}

.panel-heading {
  margin-bottom: 20rpx;
}

.panel-title,
.panel-desc,
.template-title,
.template-desc,
.form-label,
.field-hint,
.switch-title,
.switch-desc,
.form-error {
  display: block;
}

.panel-title {
  color: #10233c;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.58;
}

.template-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.template-card {
  width: 32%;
  flex: 0 0 auto;
  min-width: 0;
  min-height: 126rpx;
  margin: 0;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.72);
  border-radius: 18rpx;
  background: #f8faff;
  color: #10233c;
  text-align: left;
  box-sizing: border-box;
  white-space: normal;
}

.template-card::after,
.choice-chip::after,
.quick-date-chip::after,
.primary-button::after {
  border: 0;
}

.template-title {
  color: #1f53c9;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.28;
  white-space: normal;
}

.template-desc {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
  line-height: 1.42;
  white-space: normal;
}

.chip-row,
.quick-date-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.type-row {
  margin-bottom: 26rpx;
}

.choice-chip,
.quick-date-chip {
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 18rpx;
  background: #f8faff;
  color: #425d96;
  font-weight: 800;
  box-sizing: border-box;
}

.choice-chip {
  width: 48%;
  height: 68rpx;
  margin-bottom: 16rpx;
  font-size: 25rpx;
}

.quick-date-chip {
  width: 23%;
  height: 64rpx;
  font-size: 24rpx;
}

.choice-chip-active {
  border-color: rgba(31, 83, 201, 0.36);
  background: #eef3ff;
  color: #1f53c9;
}

.field-block {
  margin-top: 26rpx;
}

.field-block:first-of-type {
  margin-top: 0;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #10233c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.label-row .form-label {
  margin-bottom: 0;
}

.field-hint {
  color: #7a8798;
  font-size: 22rpx;
  line-height: 1.35;
  flex: 0 0 auto;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 18rpx;
  background: #f8faff;
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.select-value {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.select-arrow {
  color: #8b9ab0;
  font-size: 40rpx;
  line-height: 1;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 190rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 18rpx;
  background: #f8faff;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.switch-title {
  color: #10233c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.switch-desc {
  margin-top: 6rpx;
  color: #66748a;
  font-size: 23rpx;
  line-height: 1.45;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  background: #1f53c9;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(31, 83, 201, 0.2);
  white-space: nowrap;
  box-sizing: border-box;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-error {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.16);
  border-radius: 18rpx;
  background: #fff3f1;
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}
