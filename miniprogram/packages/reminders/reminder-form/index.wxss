.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.text-button {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.text-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-error {
  display: block;
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.24);
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-card {
  padding: 30rpx 26rpx 38rpx;
}

.quick-section {
  margin-top: 24rpx;
  overflow: hidden;
}

.section-label,
.form-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 800;
}

.section-label {
  margin-top: 0;
}

.template-row {
  display: flex;
  gap: 14rpx;
  width: 100%;
}

.template-card {
  flex: 1;
  min-width: 0;
  min-height: 132rpx;
  margin: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.14);
  border-radius: 18rpx;
  background: rgba(239, 244, 255, 0.62);
  color: #0b1c30;
  text-align: left;
  box-sizing: border-box;
  white-space: normal;
}

.template-card::after,
.choice-chip::after {
  border: 0;
}

.template-title,
.template-desc {
  display: block;
  width: 100%;
  white-space: normal;
  overflow-wrap: break-word;
}

.template-card text,
.choice-chip text {
  white-space: normal;
}

.template-title {
  color: #1f53c9;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
}

.template-desc {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 500;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
  color: #7a8798;
  font-size: 22rpx;
  text-align: right;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 14rpx;
  margin-bottom: 0;
}

.choice-chip {
  width: 48%;
  height: 64rpx;
  margin: 0 0 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.14);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #425d96;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 800;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  color: #0b1c30;
  font-size: 28rpx;
}

.form-submit {
  margin-top: 34rpx;
}
