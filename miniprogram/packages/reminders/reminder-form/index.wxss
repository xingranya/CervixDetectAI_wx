.form-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 800;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  color: #0b1c30;
  font-size: 28rpx;
}

.subscribe-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.12);
  border-radius: 22rpx;
  background: rgba(239, 244, 255, 0.72);
  box-sizing: border-box;
}

.subscribe-copy {
  flex: 1;
  min-width: 0;
}

.subscribe-title,
.subscribe-desc,
.subscribe-status {
  display: block;
}

.subscribe-title {
  color: #0b1c30;
  font-size: 28rpx;
  font-weight: 900;
}

.subscribe-desc {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.55;
}

.subscribe-status {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #425d96;
  font-size: 23rpx;
  font-weight: 800;
}

.form-submit {
  margin-top: 34rpx;
}
