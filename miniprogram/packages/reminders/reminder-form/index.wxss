.reminder-form-page {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.form-panel,
.submit-panel,
.form-error {
  box-sizing: border-box;
}

.form-panel,
.submit-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(205, 215, 232, 0.72);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(24, 67, 126, 0.05);
}

.template-panel {
  background: #ffffff;
}

.panel-heading {
  margin-bottom: 20rpx;
}

.panel-title,
.panel-desc,
.template-title,
.template-desc,
.form-label,
.field-hint,
.switch-title,
.switch-desc,
.form-error {
  display: block;
}

.panel-title {
  color: #191c1e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.58;
}

.template-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  overflow: hidden;
}

.template-card {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 18rpx;
  width: 100%;
  min-width: 0;
  min-height: 96rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.78);
  border-radius: 16rpx;
  background: rgba(247, 250, 254, 0.92);
  color: #191c1e;
  text-align: left;
  box-sizing: border-box;
  line-height: normal;
  white-space: normal !important;
  overflow: hidden;
}

.template-card::after,
.choice-chip::after,
.quick-date-chip::after,
.primary-button::after {
  border: 0;
}

.template-title-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(24, 118, 210, 0.14);
  min-width: 0;
}

.template-title {
  color: #0d47a1;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.28;
  text-align: center;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
}

.template-desc {
  color: #414752;
  font-size: 23rpx;
  line-height: 1.42;
  text-align: left;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
}

.chip-row,
.quick-date-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  overflow: hidden;
}

.type-row {
  margin-bottom: 26rpx;
}

.choice-chip,
.quick-date-chip {
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 14rpx;
  background: rgba(247, 250, 254, 0.96);
  color: #355173;
  font-weight: 800;
  box-sizing: border-box;
  line-height: normal;
  white-space: normal !important;
  overflow: hidden;
}

.choice-chip {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  margin-bottom: 0;
  font-size: 25rpx;
}

.quick-date-chip {
  width: 100%;
  min-width: 0;
  height: 66rpx;
  font-size: 24rpx;
}

.choice-chip text,
.quick-date-chip text {
  display: block;
  width: 100%;
  min-width: 0;
  line-height: 1.25;
  white-space: normal !important;
  overflow: hidden;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
}

.choice-chip-active {
  border-color: rgba(24, 118, 210, 0.32);
  background: rgba(24, 118, 210, 0.16);
  color: #0d47a1;
}

.field-block {
  margin-top: 26rpx;
}

.field-block:first-of-type {
  margin-top: 0;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -4rpx 0 12rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.label-row .form-label {
  margin-bottom: 0;
}

.field-hint {
  color: #3e4a5f;
  font-size: 22rpx;
  line-height: 1.35;
  flex: 0 0 auto;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(193, 198, 212, 0.78);
  border-radius: 10rpx;
  background: #f7f9fb;
  color: #191c1e;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 22rpx;
}

.select-value {
  color: #191c1e;
  font-size: 28rpx;
  font-weight: 700;
}

.select-arrow {
  color: #4d5d73;
  font-size: 40rpx;
  line-height: 1;
}

.form-input {
  height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.form-textarea {
  min-height: 190rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.form-placeholder {
  color: #4d5d73;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 16rpx;
  background: #f7f9ff;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.switch-title {
  color: #191c1e;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.switch-desc {
  margin-top: 6rpx;
  color: #414752;
  font-size: 23rpx;
  line-height: 1.45;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgb(24, 118, 210);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 118, 210, 0.2);
  white-space: nowrap;
  box-sizing: border-box;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-error {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.16);
  border-radius: 18rpx;
  background: #fff3f1;
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}

.form-weui-cells,
.weui-choice-cells {
  margin: 0 !important;
  background: transparent !important;
}

.form-weui-cells .weui-cell {
  display: block !important;
  padding: 22rpx 0 !important;
}

.form-weui-cells .weui-cell__hd,
.form-weui-cells .weui-cell__bd {
  display: block !important;
  width: 100% !important;
}

.form-weui-cells .weui-label {
  width: 100% !important;
  margin-bottom: 14rpx;
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 800;
}

.form-weui-cells .weui-cell__bd {
  margin-top: 12rpx;
  min-width: 0 !important;
}

.form-weui-cells .weui-cell::before {
  left: 0 !important;
  right: 0 !important;
}
