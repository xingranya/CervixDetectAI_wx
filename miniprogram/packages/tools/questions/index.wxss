.questions-page {
  padding-bottom: 72rpx;
}

.question-hero,
.question-panel,
.saved-panel,
.guest-card,
.state-panel,
.safe-note {
  box-sizing: border-box;
}

.question-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card);
  box-shadow: 0 14rpx 36rpx rgba(var(--wx-brand-500-rgb), 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--wx-bg-section);
  flex: 0 0 auto;
}

.hero-icon-image {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.hero-copy,
.saved-body {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.panel-title,
.panel-desc,
.question-text,
.saved-title,
.guest-tip,
.guest-card-title,
.guest-card-desc,
.state-title,
.state-desc,
.safe-note {
  display: block;
}

.hero-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--wx-text-muted);
  font-size: 25rpx;
  line-height: 1.62;
}

.question-panel,
.saved-panel,
.state-panel,
.guest-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card-88);
  box-shadow: 0 16rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.06);
}

.panel-heading {
  margin-bottom: 20rpx;
}

.saved-heading {
  margin-bottom: 6rpx;
}

.panel-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc,
.state-desc {
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.58;
}

.template-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.question-item {
  display: flex;
  align-items: flex-start;
  width: 48.2%;
  min-width: 0;
  min-height: 146rpx;
  margin: 0 0 14rpx;
  padding: 20rpx 14rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.58);
  border-radius: 18rpx;
  background: var(--wx-bg-primary);
  color: var(--wx-text-primary);
  text-align: left;
  box-sizing: border-box;
  overflow: hidden;
}

.question-item:last-child {
  border-bottom: 1rpx solid rgba(199, 210, 232, 0.58);
}

.question-item::after {
  border: 0;
}

.choice-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  margin-right: 8rpx;
  border: 2rpx solid var(--wx-border-list);
  border-radius: 50%;
  background: var(--wx-bg-primary);
  flex: 0 0 auto;
  box-sizing: border-box;
}

.choice-icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
}

.question-item-active {
  border-color: rgba(var(--wx-brand-500-rgb), 0.32);
  background: var(--wx-bg-section);
}

.question-item-active .choice-mark {
  border-color: var(--wx-brand-500);
  background: var(--wx-brand-500);
}

.question-item-active .question-text {
  color: var(--wx-brand-500);
  font-weight: 800;
}

.question-text {
  flex: 1;
  min-width: 0;
  color: var(--wx-text-primary);
  font-size: 23rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  word-break: break-all;
  white-space: normal;
}

.form-textarea,
.answer-textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--wx-border-input-alt);
  border-radius: 18rpx;
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 28rpx;
  line-height: 1.62;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 170rpx;
}

.answer-textarea {
  min-height: 150rpx;
  margin-top: 18rpx;
}

.primary-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.2);
}

.text-button {
  width: auto;
  height: 60rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--wx-bg-section);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 800;
}

.primary-button::after,
.text-button::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.save-button {
  margin-top: 24rpx;
}

.retry-button {
  margin-top: 22rpx;
}

.guest-tip {
  margin-top: 14rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

.weui-search {
  margin: -2rpx 0 24rpx;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 20rpx;
  background: var(--wx-bg-card-92) !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.05);
}

.weui-search .weui-search-bar {
  padding: 10rpx 12rpx !important;
  background: transparent !important;
}

.weui-search .weui-search-bar__form {
  border-radius: 16rpx !important;
  background: var(--wx-bg-primary) !important;
}

.question-weui-cells {
  margin: 0 !important;
  background: transparent !important;
}

.saved-question {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.saved-question:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.saved-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: var(--wx-bg-section);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.saved-title {
  color: var(--wx-text-primary);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.55;
}

.question-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.danger {
  background: var(--wx-bg-danger-surface);
  color: var(--wx-danger);
}

.guest-card-title {
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.guest-card-desc {
  margin-top: 10rpx;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.6;
}

.state-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}
