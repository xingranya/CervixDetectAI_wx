.questions-page {
  padding-bottom: 72rpx;
}

.question-hero,
.question-panel,
.saved-panel,
.guest-card,
.state-panel,
.safe-note {
  box-sizing: border-box;
}

.question-hero {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card);
  box-shadow: 0 14rpx 36rpx rgba(var(--wx-brand-500-rgb), 0.07);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--wx-bg-section);
  flex: 0 0 auto;
}

.hero-copy,
.saved-body {
  flex: 1;
  min-width: 0;
}

.hero-title,
.hero-desc,
.panel-title,
.panel-desc,
.saved-title,
.guest-tip,
.guest-card-title,
.guest-card-desc,
.state-title,
.state-desc,
.safe-note {
  display: block;
}

.hero-title {
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--wx-text-muted);
  font-size: 25rpx;
  line-height: 1.62;
}

.question-panel,
.saved-panel,
.state-panel,
.guest-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 26rpx;
  background: var(--wx-bg-card-88);
  box-shadow: 0 16rpx 40rpx rgba(var(--wx-brand-500-rgb), 0.06);
}

.panel-heading {
  margin-bottom: 20rpx;
}

.saved-heading {
  margin-bottom: 6rpx;
}

.panel-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc,
.state-desc {
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.58;
}

.form-textarea,
.answer-textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--wx-border-input-alt);
  border-radius: 18rpx;
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 28rpx;
  line-height: 1.62;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 170rpx;
}

.answer-textarea {
  min-height: 150rpx;
  margin-top: 18rpx;
}

.primary-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.2);
}

.text-button {
  width: auto;
  height: 60rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--wx-bg-section);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 800;
}

.primary-button::after,
.text-button::after {
  border: 0;
}

.save-button {
  margin-top: 24rpx;
}

.retry-button {
  margin-top: 22rpx;
}

.guest-tip {
  margin-top: 14rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

/* t-search 项目样式：圆角容器 + 卡片背景，替代原 mp-searchbar ext-class */
.questions-search {
  margin: -2rpx 0 24rpx;
  --td-search-bg-color: var(--wx-bg-card-92);
  --td-search-padding: 10rpx 12rpx;
  --td-search-square-radius: 20rpx;
  --td-search-icon-color: var(--wx-text-tertiary);
  --td-search-placeholder-color: var(--wx-text-tertiary);
  --td-search-text-color: var(--wx-text-primary);
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.05);
}

.question-cells {
  margin: 0;
  background: transparent;
}

.saved-question {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.saved-question:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.saved-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: var(--wx-bg-section);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.saved-title {
  color: var(--wx-text-primary);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.55;
}

.question-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.danger {
  background: var(--wx-bg-danger-surface);
  color: var(--wx-danger);
}

.guest-card-title {
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.guest-card-desc {
  margin-top: 10rpx;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.6;
}

.state-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}
