.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--wx-border-white-90);
  border-radius: 24rpx;
  background: var(--wx-bg-glass);
  box-shadow: 0 18rpx 46rpx rgba(var(--wx-brand-500-rgb), 0.07);
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: var(--wx-shadow-float);
}

.primary-button::after {
  border: 0;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--wx-bg-glass-light);
  border: 1rpx solid var(--wx-border-light);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

.article-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.card-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 auto;
}

.article-body {
  flex: 1;
  min-width: 0;
}

.article-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
}

.article-summary {
  display: block;
  margin-top: 14rpx;
  color: var(--wx-text-tertiary);
  font-size: 27rpx;
  line-height: 1.65;
}

.article-arrow {
  color: var(--wx-text-caption);
  font-size: 44rpx;
  line-height: 1;
}

.article-mask {
  position: fixed;
  inset: 0;
  z-index: 8888;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: var(--wx-overlay);
  box-sizing: border-box;
}

.article-panel {
  width: 100%;
  max-height: 76vh;
  overflow: auto;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--wx-bg-primary);
  box-shadow: 0 24rpx 68rpx var(--wx-shadow-button-disabled);
  box-sizing: border-box;
}

.article-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.article-panel-title,
.article-panel-summary,
.article-panel-content {
  display: block;
}

.article-panel-title {
  flex: 1;
  color: var(--wx-text-primary);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}

.article-close {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-500);
  font-size: 24rpx;
  line-height: normal;
  font-weight: 800;
}

.article-close::after {
  border: 0;
}

.article-panel-summary {
  margin-top: 20rpx;
  color: var(--wx-text-brand-muted);
  font-size: 27rpx;
  line-height: 1.6;
  font-weight: 700;
}

.article-panel-content {
  margin-top: 20rpx;
  color: var(--wx-text-primary);
  font-size: 28rpx;
  line-height: 1.78;
}

.article-panel-note {
  margin-top: 24rpx;
}
