.article-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.card-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 auto;
}

.article-body {
  flex: 1;
  min-width: 0;
}

.article-title {
  display: block;
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
}

.article-summary {
  display: block;
  margin-top: 14rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.65;
}

.article-arrow {
  color: #9aa6b8;
  font-size: 44rpx;
  line-height: 1;
}

.article-mask {
  position: fixed;
  inset: 0;
  z-index: 8888;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: rgba(11, 28, 48, 0.48);
  box-sizing: border-box;
}

.article-panel {
  width: 100%;
  max-height: 76vh;
  overflow: auto;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 68rpx rgba(11, 28, 48, 0.22);
  box-sizing: border-box;
}

.article-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.article-panel-title,
.article-panel-summary,
.article-panel-content {
  display: block;
}

.article-panel-title {
  flex: 1;
  color: #0b1c30;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}

.article-close {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 800;
}

.article-close::after {
  border: 0;
}

.article-panel-summary {
  margin-top: 20rpx;
  color: #425d96;
  font-size: 27rpx;
  line-height: 1.6;
  font-weight: 700;
}

.article-panel-content {
  margin-top: 20rpx;
  color: #0b1c30;
  font-size: 28rpx;
  line-height: 1.78;
}

.article-panel-note {
  margin-top: 24rpx;
}
