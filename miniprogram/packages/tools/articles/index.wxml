<view class="page">
  <section-header title="健康知识" icon="/assets/icons/articles-active.png" />

  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <text class="state-title">正在加载知识内容</text>
    <text class="state-desc">请稍候，正在整理适合阅读的内容。</text>
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载知识内容</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" bind:tap="loadArticles">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="暂时还没有内容"
    desc="稍后会在这里补充适合日常查看的健康管理文章。"
    icon="/assets/icons/articles-active.png"
  />

  <block wx:else>
    <view wx:for="{{articles}}" wx:key="id" class="card article-card" bind:tap="openArticle" data-id="{{item.id}}">
      <image class="card-icon" src="/assets/icons/articles-active.png" mode="aspectFit" />
      <view class="article-body">
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
      </view>
      <text class="article-arrow">›</text>
    </view>
  </block>

  <view class="safe-note">知识内容用于日常健康管理参考，不能替代专业医疗意见。</view>

  <view wx:if="{{activeArticle}}" class="article-mask" bind:tap="closeArticle">
    <view class="article-panel" catch:tap="noop">
      <view class="article-panel-head">
        <text class="article-panel-title">{{activeArticle.title}}</text>
        <button class="article-close" bind:tap="closeArticle">
          <text class="button-text">关闭</text>
        </button>
      </view>
      <text class="article-panel-summary">{{activeArticle.summary}}</text>
      <text class="article-panel-content">{{activeArticle.content || activeArticle.summary}}</text>
      <view class="safe-note article-panel-note">以上内容仅用于健康管理参考，如需判断具体健康问题，请前往线下正规医疗机构咨询。</view>
    </view>
  </view>
</view>
