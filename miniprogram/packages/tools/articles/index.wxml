<custom-nav-bar title="健康知识" showBack />
<scroll-view type="list" scroll-y style="height: 100vh;">
<view class="page">
  <section-header title="健康知识" weui-icon="info" />

  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <t-skeleton row-col="{{[{size: '32rpx', type: 'rect'},{size: '24rpx', type: 'rect', width: '70%'}]}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载知识内容</text>
    <text class="state-desc">{{errorMessage}}</text>
    <t-button theme="primary" size="large" block bind:tap="loadArticles">重新加载</t-button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="暂时还没有内容"
    desc="稍后会在这里补充适合日常查看的健康管理文章。"
    weui-icon="info"
  />

  <block wx:else>
    <view wx:for="{{articles}}" wx:key="id" class="card article-card" bind:tap="openArticle" data-id="{{item.id}}">
      <t-icon name="info-circle" color="#1f53c9" size="56rpx" />
      <view class="article-body">
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
      </view>
      <t-icon name="chevron-right" color="#4d5d73" size="32rpx" />
    </view>
  </block>

  <t-notice-bar theme="info" content="知识内容用于日常健康管理参考，不能替代专业医疗意见。" />

  <t-popup visible="{{!!activeArticle}}" placement="bottom" bind:visible-change="closeArticle">
    <view class="article-panel">
      <view class="article-panel-head">
        <text class="article-panel-title">{{activeArticle.title}}</text>
      </view>
      <text class="article-panel-summary">{{activeArticle.summary}}</text>
      <text class="article-panel-content">{{activeArticle.content || activeArticle.summary}}</text>
      <t-notice-bar theme="info" content="以上内容仅用于健康管理参考，如需判断具体健康问题，请前往线下正规医疗机构咨询。" />
    </view>
  </t-popup>
</view>
</scroll-view>
