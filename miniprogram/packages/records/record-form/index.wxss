.record-form-page {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.form-panel,
.submit-panel,
.safe-note {
  box-sizing: border-box;
}

.form-panel,
.submit-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(205, 215, 232, 0.72);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(24, 67, 126, 0.05);
}

.template-panel {
  background: #ffffff;
}

.panel-heading {
  margin-bottom: 20rpx;
}

.panel-title,
.panel-desc,
.field-hint,
.safe-note,
.template-title,
.template-desc {
  display: block;
}

.panel-title {
  color: #191c1e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.58;
}

.template-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  width: 100%;
  overflow: hidden;
}

.template-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  min-height: 200rpx;
  margin: 0;
  padding: 24rpx 16rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.58);
  border-radius: 20rpx;
  background: #ffffff;
  color: #191c1e;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
  box-sizing: border-box;
  line-height: normal;
  white-space: normal !important;
  overflow: hidden;
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.template-card:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 93, 172, 0.06);
}

.template-card::after,
.choice-chip::after,
.primary-button::after {
  border: 0;
}

.template-title-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(24, 118, 210, 0.12);
  min-width: 0;
}

.template-title {
  color: #0d47a1;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.28;
  text-align: center;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
}

.template-desc {
  color: #526174;
  font-size: 23rpx;
  line-height: 1.42;
  text-align: center;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -4rpx 0 12rpx;
}

.field-hint {
  color: #3e4a5f;
  font-size: 22rpx;
  line-height: 1.35;
  flex: 0 0 auto;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(193, 198, 212, 0.78);
  border-radius: 10rpx;
  background: #f7f9fb;
  color: #191c1e;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 22rpx;
}

.select-value {
  color: #191c1e;
  font-size: 28rpx;
  font-weight: 700;
}

.select-arrow {
  color: #4d5d73;
  font-size: 40rpx;
  line-height: 1;
}

.form-input {
  height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.form-textarea {
  min-height: 186rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.form-placeholder {
  color: #4d5d73;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgb(24, 118, 210);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 118, 210, 0.2);
  white-space: nowrap;
  box-sizing: border-box;
}

.safe-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.62);
  border-radius: 12rpx;
  background: #f7f9fb;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-weui-cells,
.weui-choice-cells {
  margin: 0 !important;
  background: transparent !important;
}

.form-weui-cells .weui-cell {
  display: block !important;
  padding: 22rpx 0 !important;
}

.form-weui-cells .weui-cell__hd,
.form-weui-cells .weui-cell__bd {
  display: block !important;
  width: 100% !important;
}

.form-weui-cells .weui-label {
  width: 100% !important;
  margin-bottom: 14rpx;
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 800;
}

.form-weui-cells .weui-cell__bd {
  margin-top: 12rpx;
  min-width: 0 !important;
}

.form-weui-cells .weui-cell::before {
  left: 0 !important;
  right: 0 !important;
}
