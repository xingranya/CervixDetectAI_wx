.record-form-page {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.form-panel,
.submit-panel,
.safe-note,
.form-error {
  box-sizing: border-box;
}

.form-panel,
.submit-panel {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(193, 198, 212, 0.62);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
}

.template-panel {
  background: #ffffff;
}

.panel-heading {
  margin-bottom: 20rpx;
}

.panel-title,
.panel-desc,
.form-label,
.field-hint,
.safe-note,
.form-error,
.template-title,
.template-desc {
  display: block;
}

.panel-title {
  color: #191c1e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.58;
}

.template-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  overflow: visible;
}

.template-card {
  width: 100%;
  min-width: 0;
  min-height: 112rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.72);
  border-radius: 14rpx;
  background: rgba(0, 93, 172, 0.04);
  color: #191c1e;
  text-align: center;
  box-sizing: border-box;
  white-space: normal;
}

.template-card::after,
.choice-chip::after,
.primary-button::after {
  border: 0;
}

.template-title {
  color: #005dac;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.28;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: keep-all;
}

.template-desc {
  margin-top: 8rpx;
  color: #414752;
  font-size: 22rpx;
  line-height: 1.42;
  white-space: normal;
  overflow-wrap: break-word;
}

.field-block {
  margin-top: 26rpx;
}

.field-block:first-of-type {
  margin-top: 0;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -4rpx 0 12rpx;
}

.form-label {
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.field-hint {
  color: #7a8798;
  font-size: 22rpx;
  line-height: 1.35;
  flex: 0 0 auto;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(193, 198, 212, 0.78);
  border-radius: 10rpx;
  background: #f7f9fb;
  color: #191c1e;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 22rpx;
}

.select-value {
  color: #191c1e;
  font-size: 28rpx;
  font-weight: 700;
}

.select-arrow {
  color: #8b9ab0;
  font-size: 40rpx;
  line-height: 1;
}

.form-input {
  height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.form-textarea {
  min-height: 186rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.choice-chip {
  width: 48%;
  height: 68rpx;
  margin: 0 0 16rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(176, 190, 215, 0.76);
  border-radius: 10rpx;
  background: #f7f9ff;
  color: #425d96;
  font-size: 25rpx;
  font-weight: 800;
}

.choice-chip-active {
  border-color: rgba(0, 93, 172, 0.42);
  background: #d4e3ff;
  color: #005dac;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  background: #005dac;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(0, 93, 172, 0.2);
  white-space: nowrap;
  box-sizing: border-box;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.form-error {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.16);
  border-radius: 18rpx;
  background: #fff3f1;
  color: #ba1a1a;
  font-size: 24rpx;
  line-height: 1.55;
}

.safe-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.62);
  border-radius: 12rpx;
  background: #f7f9fb;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-weui-cells,
.weui-choice-cells {
  margin: 0 !important;
  background: transparent !important;
}

.form-weui-cells .weui-cell {
  display: block !important;
  padding: 22rpx 0 !important;
}

.form-weui-cells .weui-cell__hd,
.form-weui-cells .weui-cell__bd {
  display: block !important;
  width: 100% !important;
}

.form-weui-cells .weui-label {
  width: 100% !important;
  margin-bottom: 14rpx;
  color: #191c1e;
  font-size: 26rpx;
  font-weight: 800;
}

.form-weui-cells .weui-cell__bd {
  margin-top: 12rpx;
  min-width: 0 !important;
}

.form-weui-cells .weui-cell::before {
  left: 0 !important;
  right: 0 !important;
}

mp-cell + mp-cell {
  margin-top: 0;
}
