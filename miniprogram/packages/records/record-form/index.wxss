.form-card {
  padding-bottom: 38rpx;
}

.form-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 800;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.picker-value {
  color: #0f172a;
}

.form-submit {
  margin-top: 34rpx;
}
