.record-form-page {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.form-panel,
.submit-panel,
.safe-note {
  box-sizing: border-box;
}

.form-panel,
.submit-panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-card-light);
  border-radius: 22rpx;
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-soft);
}

.template-panel {
  background: var(--wx-bg-primary);
}

.panel-heading {
  margin-bottom: 20rpx;
}

.panel-title,
.panel-desc,
.field-hint,
.safe-note,
.template-title,
.template-desc {
  display: block;
}

.panel-title {
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.panel-desc {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.58;
}

.template-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  overflow: hidden;
}

.template-card {
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 18rpx;
  width: 100%;
  min-width: 0;
  min-height: 96rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 16rpx;
  background: rgba(247, 250, 254, 0.92);
  color: var(--wx-text-primary);
  text-align: left;
  box-sizing: border-box;
  line-height: normal;
  white-space: normal !important;
  overflow: hidden;
}

.template-card::after,
.choice-chip::after,
.primary-button::after {
  border: 0;
}

.template-title-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.14);
  min-width: 0;
}

.template-title {
  color: var(--wx-brand-700);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.28;
  text-align: center;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
}

.template-desc {
  color: var(--wx-text-secondary);
  font-size: 23rpx;
  line-height: 1.42;
  text-align: left;
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -4rpx 0 12rpx;
}

.field-hint {
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  line-height: 1.35;
  flex: 0 0 auto;
}

.select-field,
.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid var(--wx-border-input-alt);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 22rpx;
}

.select-value {
  color: var(--wx-text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.form-input {
  height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.form-textarea {
  min-height: 186rpx;
  padding: 22rpx 24rpx;
  line-height: 1.62;
}

.form-placeholder {
  color: var(--wx-text-secondary);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.2);
  white-space: nowrap;
  box-sizing: border-box;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: 18rpx;
  background: var(--wx-bg-secondary);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.form-cells,
.choice-cells {
  margin: 0;
  background: transparent;
}

.form-cell {
  display: block;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--wx-border-divider);
}

.form-cell:last-child {
  border-bottom: none;
}

.form-cell-title {
  display: block;
  width: 100%;
  margin-bottom: 14rpx;
  color: var(--wx-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

/* ---- Attachment Grid ---- */
.attachment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.attachment-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid var(--wx-border-card-light);
}

.attachment-image {
  width: 100%;
  height: 100%;
}

.attachment-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.attachment-remove-icon {
  color: var(--wx-text-on-primary);
  font-size: 28rpx;
  line-height: 1;
}

.attachment-add {
  aspect-ratio: 1;
  border: 2rpx dashed rgba(var(--wx-brand-500-rgb), 0.3);
  border-radius: 14rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.attachment-add-icon {
  font-size: 48rpx;
  color: var(--wx-brand-500);
  line-height: 1;
  font-weight: 300;
}

.attachment-add-text {
  font-size: 22rpx;
  color: var(--wx-text-tertiary);
}

.field-error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--wx-danger);
  line-height: 1.4;
}
