<view class="page">
  <view class="card form-card">
    <section-header title="{{id ? '编辑检查记录' : '新增检查记录'}}" icon="/assets/icons/form-active.png" />

    <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>

    <view wx:if="{{!id}}" class="quick-section">
      <text class="section-label">常用模板</text>
      <view class="template-row">
        <button class="template-card" data-index="0" bind:tap="applyTemplate">
          <text class="template-title">筛查摘要</text>
          <text class="template-desc">TCT / HPV 等摘要</text>
        </button>
        <button class="template-card" data-index="1" bind:tap="applyTemplate">
          <text class="template-title">复查准备</text>
          <text class="template-desc">复查前资料整理</text>
        </button>
        <button class="template-card" data-index="2" bind:tap="applyTemplate">
          <text class="template-title">日常记录</text>
          <text class="template-desc">补充普通健康记录</text>
        </button>
      </view>
    </view>

    <text class="form-label">检查日期</text>
    <picker mode="date" value="{{date}}" bind:change="onDateChange">
      <view class="form-input picker-value">{{date || '请选择日期'}}</view>
    </picker>

    <text class="form-label">记录标题</text>
    <input class="form-input" value="{{title}}" bind:input="onTitleInput" maxlength="60" placeholder="例如：女性健康筛查记录" />

    <text class="form-label">检查项目</text>
    <input class="form-input" value="{{project}}" bind:input="onProjectInput" maxlength="60" placeholder="例如：TCT / HPV 摘要记录" />

    <text class="form-label">摘要</text>
    <textarea class="form-textarea" value="{{summary}}" bind:input="onSummaryInput" maxlength="500" placeholder="记录检查摘要，便于后续查看。" />
    <text class="field-hint">{{summaryLength}} / 500</text>

    <text class="form-label">提醒建议</text>
    <textarea class="form-textarea" value="{{suggestion}}" bind:input="onSuggestionInput" maxlength="500" placeholder="记录复查安排、资料准备等提醒。" />
    <text class="field-hint">{{suggestionLength}} / 500</text>

    <text class="form-label">状态</text>
    <view class="chip-row">
      <button class="choice-chip {{status === '已记录' ? 'choice-chip-active' : ''}}" data-status="已记录" bind:tap="selectStatus">
        <text>已记录</text>
      </button>
      <button class="choice-chip {{status === '待复查' ? 'choice-chip-active' : ''}}" data-status="待复查" bind:tap="selectStatus">
        <text>待复查</text>
      </button>
      <button class="choice-chip {{status === '待关注' ? 'choice-chip-active' : ''}}" data-status="待关注" bind:tap="selectStatus">
        <text>待关注</text>
      </button>
      <button class="choice-chip {{status === '已完成' ? 'choice-chip-active' : ''}}" data-status="已完成" bind:tap="selectStatus">
        <text>已完成</text>
      </button>
    </view>

    <button class="primary-button form-submit" disabled="{{loading}}" bind:tap="submitForm">
      <view class="button-content">
        <image class="button-icon" src="/assets/icons/save-white.png" mode="aspectFit" />
        <text class="button-text">{{loading ? '正在保存' : '保存记录'}}</text>
      </view>
    </button>
  </view>

  <view class="safe-note">请仅记录已有检查摘要和个人提醒，不填写诊断结论、处方或紧急求助内容。</view>
</view>
