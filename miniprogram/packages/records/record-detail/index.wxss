.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.ghost-button {
  height: 76rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #1f53c9;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip image {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-title {
  display: block;
  flex: 1;
  color: #0b1c30;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.3;
}

.detail-info {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: rgba(239, 244, 255, 0.72);
  overflow: hidden;
}

.detail-row {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(195, 198, 214, 0.26);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label,
.detail-value {
  display: block;
}

.detail-label {
  color: #425d96;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-value {
  margin-top: 10rpx;
  color: #0b1c30;
  font-size: 28rpx;
  line-height: 1.65;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.delete-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 76rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.2);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.2);
  color: #ba1a1a;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.delete-button::after {
  border: 0;
}
