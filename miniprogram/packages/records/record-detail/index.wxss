.card,
.content-card,
.notify-panel,
.manage-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(205, 215, 232, 0.72);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 36rpx rgba(24, 67, 126, 0.06);
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
}

.primary-button,
.manage-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 78rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: rgb(24, 118, 210);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: normal;
  box-shadow: 0 14rpx 30rpx rgba(24, 118, 210, 0.2);
}

.primary-button::after,
.manage-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.detail-shell {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid rgba(201, 213, 232, 0.86);
  border-radius: 26rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 248, 255, 0.96) 100%);
  box-shadow: 0 14rpx 34rpx rgba(24, 67, 126, 0.07);
}

.hero-meta,
.hero-title-row,
.section-head,
.notify-panel,
.manage-card {
  display: flex;
  align-items: center;
}

.hero-meta {
  justify-content: space-between;
  gap: 18rpx;
}

.date-badge {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 18rpx;
  background: rgba(24, 118, 210, 0.06);
  color: rgb(24, 118, 210);
}

.date-day {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
}

.date-year {
  display: block;
  margin-left: 14rpx;
  padding-left: 14rpx;
  border-left: 1rpx solid rgba(24, 118, 210, 0.18);
  color: #526174;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.status-pill {
  display: block;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  background: rgba(24, 118, 210, 0.06);
  color: rgb(24, 118, 210);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.status-attention {
  color: #9a4d00;
}

.hero-title-row {
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(205, 215, 232, 0.58);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  background: rgba(24, 118, 210, 0.07);
  flex: 0 0 auto;
}

.hero-icon-image {
  width: 52rpx;
  height: 52rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.detail-title,
.detail-project,
.section-label,
.section-title,
.summary-text,
.suggestion-text,
.notify-title,
.notify-desc,
.safe-note {
  display: block;
}

.detail-title {
  color: #191c1e;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.22;
  letter-spacing: 0;
}

.detail-project {
  margin-top: 8rpx;
  color: #414752;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.42;
}

.content-card {
  padding: 30rpx;
  border-radius: 26rpx;
}

.summary-card {
  background: rgba(255, 255, 255, 0.94);
}

.suggestion-card {
  border-color: rgba(202, 213, 230, 0.7);
  background: rgba(247, 250, 254, 0.92);
}

.section-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.section-head.compact {
  margin-bottom: 16rpx;
}

.section-label {
  color: #526174;
  font-size: 23rpx;
  font-weight: 800;
}

.section-title {
  margin-top: 6rpx;
  color: #191c1e;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.28;
}

.section-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.9;
}

.section-title-line {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.suggestion-title-line {
  align-items: flex-start;
}

.suggestion-title-line .section-label {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 999rpx;
  background: rgba(24, 118, 210, 0.06);
  color: rgb(24, 118, 210);
}

.summary-text,
.suggestion-text {
  color: #223044;
  font-size: 28rpx;
  line-height: 1.72;
  font-weight: 500;
}

.suggestion-text {
  color: #31445f;
  font-size: 27rpx;
}

.notify-panel {
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
}

.notify-copy {
  min-width: 0;
  flex: 1;
}

.notify-title {
  color: #102a62;
  font-size: 28rpx;
  font-weight: 900;
}

.notify-desc {
  margin-top: 8rpx;
  color: #526174;
  font-size: 24rpx;
  line-height: 1.5;
}

.subscribe-button {
  width: 190rpx;
  flex: 0 0 auto;
}

.manage-card {
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
}

.manage-button {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.14);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: rgb(24, 118, 210);
  font-size: 26rpx;
  font-weight: 800;
  line-height: normal;
}

.manage-button.danger {
  border-color: rgba(186, 26, 26, 0.18);
  background: rgba(255, 245, 244, 0.82);
  color: #ba1a1a;
}

.safe-note {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}
