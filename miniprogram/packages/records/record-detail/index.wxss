.card,
.content-card,
.notify-panel,
.manage-card {
  box-sizing: border-box;
  border: 1rpx solid var(--wx-border-card-light);
  background: var(--wx-bg-card-88);
  box-shadow: var(--wx-shadow-soft);
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
}

.primary-button,
.manage-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-button {
  height: 78rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 28rpx;
  font-weight: 800;
  line-height: normal;
  box-shadow: 0 14rpx 30rpx rgba(var(--wx-brand-500-rgb), 0.2);
}

.primary-button::after,
.manage-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.detail-shell {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid rgba(201, 213, 232, 0.86);
  border-radius: 26rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 248, 255, 0.96) 100%);
  box-shadow: 0 14rpx 34rpx var(--wx-shadow-record);
}

.hero-meta,
.hero-title-row,
.section-head,
.notify-panel,
.manage-card {
  display: flex;
  align-items: center;
}

.hero-meta {
  justify-content: space-between;
  gap: 18rpx;
}

.date-badge {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--wx-border-brand);
  border-radius: 18rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.06);
  color: var(--wx-brand-700);
}

.date-day {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
}

.date-year {
  display: block;
  margin-left: 14rpx;
  padding-left: 14rpx;
  border-left: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.18);
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.status-pill {
  display: block;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  border: 1rpx solid var(--wx-border-brand);
  background: rgba(var(--wx-brand-500-rgb), 0.06);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.status-attention {
  color: #9a4d00;
}

.hero-title-row {
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(205, 215, 232, 0.58);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--wx-border-brand);
  background: rgba(var(--wx-brand-500-rgb), 0.07);
  flex: 0 0 auto;
}

.hero-icon-image {
  width: 52rpx;
  height: 52rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.detail-title,
.detail-project,
.section-label,
.section-title,
.summary-text,
.suggestion-text,
.notify-title,
.notify-desc,
.safe-note {
  display: block;
}

.detail-title {
  color: var(--wx-text-primary);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.22;
  letter-spacing: 0;
}

.detail-project {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.42;
}

.content-card {
  padding: 30rpx;
  border-radius: 26rpx;
}

.summary-card {
  background: rgba(255, 255, 255, 0.94);
}

.suggestion-card {
  border-color: rgba(202, 213, 230, 0.7);
  background: rgba(247, 250, 254, 0.92);
}

.section-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.section-head.compact {
  margin-bottom: 16rpx;
}

.section-label {
  color: var(--wx-text-tertiary);
  font-size: 23rpx;
  font-weight: 800;
}

.section-title {
  margin-top: 6rpx;
  color: var(--wx-text-primary);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.28;
}

.section-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.9;
}

.section-title-line {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.suggestion-title-line {
  align-items: flex-start;
}

.suggestion-title-line .section-label {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--wx-border-brand);
  border-radius: var(--wx-radius-pill);
  background: rgba(var(--wx-brand-500-rgb), 0.06);
  color: var(--wx-brand-700);
}

.summary-text,
.suggestion-text {
  color: var(--wx-text-deep);
  font-size: 28rpx;
  line-height: 1.72;
  font-weight: 500;
}

.suggestion-text {
  color: var(--wx-text-deep-secondary);
  font-size: 27rpx;
}

.notify-panel {
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: var(--wx-bg-card-92);
}

.notify-copy {
  min-width: 0;
  flex: 1;
}

.notify-title {
  color: var(--wx-text-brand-deep);
  font-size: 28rpx;
  font-weight: 900;
}

.notify-desc {
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.5;
}

.subscribe-button {
  width: 190rpx;
  flex: 0 0 auto;
}

.manage-card {
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: var(--wx-bg-card-88);
}

.manage-button {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.14);
  border-radius: 18rpx;
  background: var(--wx-bg-glass);
  color: var(--wx-brand-700);
  font-size: 26rpx;
  font-weight: 800;
  line-height: normal;
}

.manage-button.danger {
  border-color: rgba(186, 26, 26, 0.18);
  background: rgba(255, 245, 244, 0.82);
  color: var(--wx-danger);
}

.safe-note {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--wx-border-light);
  border-radius: 20rpx;
  background: var(--wx-bg-glass-light);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---- Hospital / Doctor Info Chips ---- */
.hero-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(205, 215, 232, 0.45);
}

.info-chip {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  background: rgba(var(--wx-brand-500-rgb), 0.06);
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.12);
  color: var(--wx-brand-700);
  font-size: 23rpx;
  font-weight: 700;
}

/* ---- Conclusion Card ---- */
.conclusion-card {
  border-color: rgba(202, 213, 230, 0.7);
  background: rgba(247, 250, 254, 0.92);
}

.conclusion-text {
  color: var(--wx-text-primary);
  font-size: 28rpx;
  line-height: 1.72;
  font-weight: 500;
}

/* ---- Diagnosis Pill ---- */
.diagnosis-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  font-size: 22rpx;
  font-weight: 800;
}

.diagnosis-normal {
  background: var(--wx-diagnosis-normal-bg);
  color: var(--wx-diagnosis-normal);
}

.diagnosis-ascus {
  background: var(--wx-diagnosis-ascus-bg);
  color: var(--wx-diagnosis-ascus);
}

.diagnosis-lsil {
  background: var(--wx-diagnosis-lsil-bg);
  color: var(--wx-diagnosis-lsil);
}

.diagnosis-hsil {
  background: var(--wx-diagnosis-hsil-bg);
  color: var(--wx-diagnosis-hsil);
}

.diagnosis-scc {
  background: var(--wx-diagnosis-scc-bg);
  color: var(--wx-diagnosis-scc);
}

/* ---- Attachments Grid ---- */
.detail-attachment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.detail-attachment-image {
  aspect-ratio: 1;
  width: 100%;
  border-radius: 12rpx;
  border: 1rpx solid rgba(205, 215, 232, 0.6);
}
