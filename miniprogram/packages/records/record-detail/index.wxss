.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-title {
  display: block;
  flex: 1;
  color: #0b1c30;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.3;
}

.detail-info {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: rgba(239, 244, 255, 0.72);
  overflow: hidden;
}

.detail-row {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(195, 198, 214, 0.26);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label,
.detail-value {
  display: block;
}

.detail-label {
  color: #425d96;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-value {
  margin-top: 10rpx;
  color: #0b1c30;
  font-size: 28rpx;
  line-height: 1.65;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.delete-button {
  height: 76rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.2);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.2);
  color: #ba1a1a;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 700;
}
