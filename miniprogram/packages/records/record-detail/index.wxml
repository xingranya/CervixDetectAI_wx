<view class="page detail-page">
  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <text class="state-title">正在加载记录详情</text>
    <text class="state-desc">请稍候，正在整理这条检查摘要。</text>
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载记录详情</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" bind:tap="reloadDetail">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <view wx:elif="{{recordView}}" class="detail-shell">
    <view class="detail-hero">
      <view class="hero-meta">
        <view class="date-badge">
          <text class="date-day">{{recordView.dateMonthDay}}</text>
          <text class="date-year">{{recordView.dateYear}}</text>
        </view>
        <text class="status-pill {{recordView.statusTone === 'attention' ? 'status-attention' : ''}}">{{recordView.statusText}}</text>
      </view>
      <view class="hero-title-row">
        <view class="hero-icon">
          <image class="hero-icon-image" src="/assets/icons/detail-white.png" mode="aspectFit" />
        </view>
        <view class="hero-copy">
          <text class="detail-title">{{recordView.title}}</text>
          <view class="project-rule"></view>
          <text class="detail-project">{{recordView.projectText}}</text>
        </view>
      </view>
    </view>

    <view class="content-card summary-card">
      <view class="section-head">
        <view>
          <text class="section-label">检查摘要</text>
          <text class="section-title">本次记录重点</text>
        </view>
        <image class="section-icon" src="/assets/icons/records-active.png" mode="aspectFit" />
      </view>
      <text class="summary-text">{{recordView.summaryText}}</text>
    </view>

    <view class="content-card suggestion-card">
      <view class="section-head compact">
        <view class="section-title-line">
          <image class="inline-icon" src="/assets/icons/reminders-active.png" mode="aspectFit" />
          <text class="section-title">后续提醒</text>
        </view>
      </view>
      <text class="suggestion-text">{{recordView.suggestionText}}</text>
    </view>

    <view wx:if="{{canSubscribeReport}}" class="notify-panel">
      <view class="notify-copy">
        <text class="notify-title">微信提醒</text>
        <text class="notify-desc">允许后会发送一次报告查看提醒，方便稍后从微信消息回到本记录。</text>
      </view>
      <button
        class="primary-button subscribe-button"
        loading="{{subscribingReport}}"
        disabled="{{subscribingReport}}"
        bind:tap="subscribeReportReminder"
      >
        <view class="button-content">
          <image class="button-icon" src="/assets/icons/reminders-white.png" mode="aspectFit" />
          <text class="button-text">{{subscribingReport ? '发送中' : '开启提醒'}}</text>
        </view>
      </button>
    </view>

    <view class="manage-card">
      <button class="manage-button" bind:tap="editRecord">
        <view class="button-content">
          <image class="button-icon" src="/assets/icons/form-active.png" mode="aspectFit" />
          <text class="button-text">编辑记录</text>
        </view>
      </button>
      <button class="manage-button danger" bind:tap="deleteRecord">
        <view class="button-content">
          <image class="button-icon" src="/assets/icons/trash-danger.png" mode="aspectFit" />
          <text class="button-text">删除记录</text>
        </view>
      </button>
    </view>
  </view>

  <view class="safe-note">如对检查内容有疑问，请携带记录到线下医疗机构咨询专业人员。</view>
</view>
