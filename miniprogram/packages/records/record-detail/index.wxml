<view class="page detail-page">
  <view wx:if="{{pageStatus === 'loading'}}" class="skeleton-container">
    <skeleton mode="card" rows="{{6}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载记录详情</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" hover-class="u-hover" bind:tap="reloadDetail">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <view wx:elif="{{recordView}}" class="detail-shell">
    <view class="detail-hero">
      <view class="hero-meta">
        <view class="date-badge">
          <text class="date-day">{{recordView.dateMonthDay}}</text>
          <text class="date-year">{{recordView.dateYear}}</text>
        </view>
        <text class="status-pill {{recordView.statusTone === 'attention' ? 'status-attention' : ''}}">{{recordView.statusText}}</text>
      </view>
      <view class="hero-title-row">
        <view class="hero-icon">
          <mp-icon icon="info_circle" color="rgb(24, 118, 210)" size="{{30}}" />
        </view>
        <view class="hero-copy">
          <text class="detail-title">{{recordView.title}}</text>
          <text class="detail-project">{{recordView.projectText}}</text>
        </view>
      </view>
      <view wx:if="{{recordView.hospital || recordView.doctorName}}" class="hero-info-row">
        <text wx:if="{{recordView.hospital}}" class="info-chip">{{recordView.hospital}}</text>
        <text wx:if="{{recordView.doctorName}}" class="info-chip">{{recordView.doctorName}}</text>
      </view>
    </view>

    <view wx:if="{{recordView.conclusionText}}" class="content-card conclusion-card">
      <view class="section-head">
        <view>
          <text class="section-label">检查结论</text>
          <text class="section-title">诊断结果</text>
        </view>
        <text wx:if="{{recordView.diagnosisTone}}" class="diagnosis-pill diagnosis-{{recordView.diagnosisTone}}">{{recordView.diagnosisToneLabel}}</text>
      </view>
      <text class="conclusion-text">{{recordView.conclusionText}}</text>
    </view>

    <view wx:if="{{recordView.attachments.length}}" class="content-card attachments-card">
      <view class="section-head compact">
        <view class="section-title-line">
          <text class="section-label">附件图片</text>
          <text class="section-title">检查报告附件</text>
        </view>
      </view>
      <view class="detail-attachment-grid">
        <image
          wx:for="{{recordView.attachments}}"
          wx:key="url"
          class="detail-attachment-image"
          src="{{item.url}}"
          mode="aspectFill"
          lazy-load
          bind:tap="previewImage"
          data-index="{{index}}"
          aria-role="img"
          aria-label="附件图片{{index + 1}}"
        />
      </view>
    </view>

    <view class="content-card summary-card">
      <view class="section-head">
        <view>
          <text class="section-label">检查摘要</text>
          <text class="section-title">本次记录重点</text>
        </view>
        <mp-icon icon="info_circle" color="rgb(24, 118, 210)" size="{{26}}" />
      </view>
      <text class="summary-text">{{recordView.summaryText}}</text>
    </view>

    <view class="content-card suggestion-card">
      <view class="section-head compact">
        <view class="section-title-line suggestion-title-line">
          <text class="section-label">复查准备</text>
          <text class="section-title">后续提醒</text>
        </view>
      </view>
      <text class="suggestion-text">{{recordView.suggestionText}}</text>
    </view>

    <view wx:if="{{canSubscribeReport}}" class="notify-panel">
      <view class="notify-copy">
        <text class="notify-title">微信提醒</text>
        <text class="notify-desc">允许后会发送一次报告查看提醒，方便稍后从微信消息回到本记录。</text>
      </view>
      <button
        class="primary-button subscribe-button"
        loading="{{subscribingReport}}"
        disabled="{{subscribingReport}}"
        bind:tap="subscribeReportReminder"
      >
        <view class="button-content">
          <mp-icon icon="time" color="#ffffff" size="{{18}}" />
          <text class="button-text">{{subscribingReport ? '发送中' : '开启提醒'}}</text>
        </view>
      </button>
    </view>

    <view class="manage-card">
      <button class="manage-button" hover-class="u-hover" bind:tap="editRecord" aria-role="button" aria-label="编辑记录">
        <view class="button-content">
          <mp-icon icon="info_circle" color="rgb(24, 118, 210)" size="{{18}}" />
          <text class="button-text">编辑记录</text>
        </view>
      </button>
      <button class="manage-button danger" hover-class="u-hover" bind:tap="deleteRecord" aria-role="button" aria-label="删除记录">
        <view class="button-content">
          <mp-icon icon="delete" color="#ba1a1a" size="{{18}}" />
          <text class="button-text">删除记录</text>
        </view>
      </button>
    </view>
  </view>

  <view class="safe-note">如对检查内容有疑问，请携带记录到线下医疗机构咨询专业人员。</view>
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="删除记录"
    content="删除后无法恢复，确认删除这条检查记录吗？"
    confirm-text="删除"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmDeleteRecord"
  />
</view>
