<custom-nav-bar title="记录详情" showBack />
<scroll-view type="list" scroll-y style="height: 100vh;">
<view class="page detail-page">
  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <t-skeleton row-col="{{[{size: '48rpx', type: 'circle'},{size: '32rpx', type: 'rect', width: '50%'},{size: '24rpx', type: 'rect', width: '80%'}]}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载记录详情</text>
    <text class="state-desc">{{errorMessage}}</text>
    <t-button theme="primary" size="large" block bind:tap="reloadDetail">重新加载</t-button>
  </view>

  <view wx:elif="{{recordView}}" class="detail-shell">
    <view class="detail-hero">
      <view class="hero-meta">
        <view class="date-badge">
          <text class="date-day">{{recordView.dateMonthDay}}</text>
          <text class="date-year">{{recordView.dateYear}}</text>
        </view>
        <t-tag theme="{{recordView.statusTone === 'attention' ? 'warning' : 'primary'}}" variant="light" size="medium">{{recordView.statusText}}</t-tag>
      </view>
      <view class="hero-title-row">
        <view class="hero-icon">
          <t-icon name="file" color="#1876d2" size="60rpx" />
        </view>
        <view class="hero-copy">
          <text class="detail-title">{{recordView.title}}</text>
          <text class="detail-project">{{recordView.projectText}}</text>
        </view>
      </view>
    </view>

    <view class="content-card summary-card">
      <view class="section-head">
        <view>
          <text class="section-label">检查摘要</text>
          <text class="section-title">本次记录重点</text>
        </view>
        <t-icon name="file" color="#1876d2" size="52rpx" />
      </view>
      <text class="summary-text">{{recordView.summaryText}}</text>
    </view>

    <view class="content-card suggestion-card">
      <view class="section-head compact">
        <view class="section-title-line suggestion-title-line">
          <text class="section-label">复查准备</text>
          <text class="section-title">后续提醒</text>
        </view>
      </view>
      <text class="suggestion-text">{{recordView.suggestionText}}</text>
    </view>

    <view wx:if="{{canSubscribeReport}}" class="notify-panel">
      <view class="notify-copy">
        <text class="notify-title">微信提醒</text>
        <text class="notify-desc">允许后会发送一次报告查看提醒，方便稍后从微信消息回到本记录。</text>
      </view>
      <t-button
        theme="primary"
        size="medium"
        loading="{{subscribingReport}}"
        disabled="{{subscribingReport}}"
        icon="time"
        bind:tap="subscribeReportReminder"
      >{{subscribingReport ? '发送中' : '开启提醒'}}</t-button>
    </view>

    <view class="manage-card">
      <t-button variant="text" size="medium" icon="file" bind:tap="editRecord">编辑记录</t-button>
      <t-button variant="text" theme="danger" size="medium" icon="delete" bind:tap="deleteRecord">删除记录</t-button>
    </view>
  </view>

  <t-notice-bar theme="info" content="如对检查内容有疑问，请携带记录到线下医疗机构咨询专业人员。" />
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="删除记录"
    content="删除后无法恢复，确认删除这条检查记录吗？"
    confirm-text="删除"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmDeleteRecord"
  />
</view>
</scroll-view>
