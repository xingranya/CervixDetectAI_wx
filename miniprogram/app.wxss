page {
  background: #f8fafc;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 6% 4%, rgba(59, 130, 246, 0.1), transparent 32%),
    radial-gradient(circle at 92% 2%, rgba(16, 185, 129, 0.1), transparent 28%),
    linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%);
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.title-row .section-title {
  margin: 0;
}

.page-head .title-row {
  margin-bottom: 0;
}

.title-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  max-width: 32rpx;
  max-height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  max-width: 28rpx;
  max-height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.title-icon,
.card-icon,
.button-icon,
.small-icon {
  display: block;
}

.primary-button,
.ghost-button,
.mini-primary,
.text-button,
.delete-button,
.logout-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.muted {
  color: #64748b;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 24rpx;
}

.primary-button {
  height: 86rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1976d2 0%, #2563eb 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
  box-shadow: 0 14rpx 28rpx rgba(25, 118, 210, 0.22);
}

.ghost-button {
  height: 76rpx;
  border: 1rpx solid rgba(25, 118, 210, 0.24);
  border-radius: 16rpx;
  background: #fff;
  color: #1976d2;
  font-size: 28rpx;
  line-height: 76rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid #e3e9f2;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}
