page {
  --color-primary: #1f53c9;
  --color-primary-light: #406de4;
  --color-primary-bg: rgba(31, 83, 201, 0.07);
  --color-primary-border: rgba(31, 83, 201, 0.12);
  --color-primary-rgb: 31, 83, 201;

  --color-brand: rgb(24, 118, 210);
  --color-brand-rgb: 24, 118, 210;
  --color-brand-bg: rgba(24, 118, 210, 0.08);
  --color-brand-light: #d4e3ff;
  --color-brand-deep: #0d47a1;

  --color-danger: #ba1a1a;
  --color-danger-bg: rgba(186, 26, 26, 0.08);
  --color-danger-rgb: 186, 26, 26;

  --color-success: #14b8a6;

  --color-bg: #f7f9fb;
  --color-bg-card: #ffffff;
  --color-bg-card-alpha: rgba(255, 255, 255, 0.72);
  --color-border: rgba(198, 210, 236, 0.58);
  --color-border-light: rgba(195, 198, 214, 0.48);
  --color-shadow: rgba(0, 93, 172, 0.04);

  --color-text-primary: #191c1e;
  --color-text-secondary: #414752;
  --color-text-tertiary: #4d5d73;
  --color-text-placeholder: #526174;
  --color-text-hint: #3e4a5f;

  --radius-sm: 14rpx;
  --radius-md: 16rpx;
  --radius-lg: 18rpx;
  --radius-xl: 22rpx;
  --radius-full: 999rpx;

  --font-weight-bold: 800;
  --font-weight-black: 900;

  background: var(--color-bg);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    --color-primary: #6b93ff;
    --color-primary-light: #8ba8ff;
    --color-primary-bg: rgba(107, 147, 255, 0.12);
    --color-primary-border: rgba(107, 147, 255, 0.2);
    --color-primary-rgb: 107, 147, 255;

    --color-brand: #5b8def;
    --color-brand-rgb: 91, 141, 239;
    --color-brand-bg: rgba(91, 141, 239, 0.15);
    --color-brand-light: #2a3a6e;
    --color-brand-deep: #a0bfff;

    --color-danger: #ff6b6b;
    --color-danger-bg: rgba(255, 107, 107, 0.15);
    --color-danger-rgb: 255, 107, 107;

    --color-success: #2dd4bf;

    --color-bg: #1a1a2e;
    --color-bg-card: #16213e;
    --color-bg-card-alpha: rgba(22, 33, 62, 0.72);
    --color-border: rgba(107, 147, 255, 0.15);
    --color-border-light: rgba(107, 147, 255, 0.1);
    --color-shadow: rgba(0, 0, 0, 0.2);

    --color-text-primary: #e2e8f0;
    --color-text-secondary: #a0aec0;
    --color-text-tertiary: #8892a8;
    --color-text-placeholder: #6b7a90;
    --color-text-hint: #94a3b8;
  }
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

button text {
  display: block;
  line-height: 1.2;
}

button image {
  flex: 0 0 auto;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  line-height: 1;
  white-space: nowrap;
}

.button-text {
  display: block;
  min-width: 0;
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

button[disabled] {
  opacity: 0.68;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg);
}

mp-icon + .button-text,
mp-icon + .plain-link-text {
  margin-left: 8rpx;
}

.local-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  gap: 18rpx;
}

.loading-ring {
  width: 46rpx;
  height: 46rpx;
  border: 5rpx solid rgba(var(--color-brand-rgb), 0.16);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: loadingRotate 0.8s linear infinite;
  box-sizing: border-box;
}

.loading-text {
  color: var(--color-text-placeholder);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

@keyframes loadingRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
