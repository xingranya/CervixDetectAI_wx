page {
  background: #f8f9ff;
  color: #0b1c30;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

button text {
  display: block;
  line-height: 1.2;
}

button image {
  flex: 0 0 auto;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  line-height: 1;
  white-space: nowrap;
}

.button-text {
  display: block;
  min-width: 0;
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

button[disabled] {
  opacity: 0.68;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 0 0, rgba(31, 83, 201, 0.11), transparent 34%),
    radial-gradient(circle at 100% 14%, rgba(166, 192, 255, 0.34), transparent 30%),
    radial-gradient(circle at 100% 100%, rgba(145, 68, 70, 0.05), transparent 34%),
    linear-gradient(180deg, #f8f9ff 0%, #eff4ff 52%, #f8f9ff 100%);
}

mp-icon + .button-text,
mp-icon + .plain-link-text {
  margin-left: 8rpx;
}
