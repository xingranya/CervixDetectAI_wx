page {
  background: #f8f9ff;
  color: #0b1c30;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 0 0, rgba(31, 83, 201, 0.11), transparent 34%),
    radial-gradient(circle at 100% 14%, rgba(166, 192, 255, 0.34), transparent 30%),
    radial-gradient(circle at 100% 100%, rgba(145, 68, 70, 0.05), transparent 34%),
    linear-gradient(180deg, #f8f9ff 0%, #eff4ff 52%, #f8f9ff 100%);
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #0b1c30;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.title-row .section-title {
  margin: 0;
}

.page-head .title-row {
  margin-bottom: 0;
}

.title-icon {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-icon {
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  max-width: 32rpx;
  max-height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  max-width: 28rpx;
  max-height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.title-icon,
.card-icon,
.button-icon,
.small-icon {
  display: block;
}

.primary-button,
.ghost-button,
.mini-primary,
.text-button,
.delete-button,
.logout-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.muted {
  color: #66748a;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.primary-button {
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.primary-button::after,
.ghost-button::after,
.mini-primary::after,
.text-button::after,
.delete-button::after,
.logout-button::after,
.plain-link::after {
  border: 0;
}

.ghost-button {
  height: 76rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #1f53c9;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.mini-primary {
  min-width: 132rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #1f53c9;
  color: #fff;
  font-size: 26rpx;
  line-height: 64rpx;
  font-weight: 700;
}

.text-button {
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.danger {
  background: rgba(186, 26, 26, 0.08);
  color: #ba1a1a;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip image {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: #66748a;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}
