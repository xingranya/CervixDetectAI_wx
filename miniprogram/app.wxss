@import './styles/design-tokens.wxss';
@import './styles/design-tokens-dark.wxss';
@import './styles/utilities.wxss';
@import './miniprogram_npm/tdesign-miniprogram/common/style/theme/_index.wxss';
@import './styles/tdesign-bridge.wxss';

page {
  background: var(--wx-bg-secondary);
  color: var(--wx-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

button text {
  display: block;
  line-height: 1.2;
}

button image {
  flex: 0 0 auto;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  line-height: 1;
  white-space: nowrap;
}

.button-text {
  display: block;
  min-width: 0;
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

button[disabled] {
  opacity: 0.68;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--wx-bg-secondary);
}

/* TDesign t-icon 与相邻文字间距 */
t-icon + .button-text,
t-icon + .plain-link-text {
  margin-left: 8rpx;
}

.local-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  gap: 18rpx;
}

.loading-ring {
  width: 46rpx;
  height: 46rpx;
  border: 5rpx solid rgba(var(--wx-brand-500-rgb), 0.16);
  border-top-color: var(--wx-brand-500);
  border-radius: 50%;
  animation: loadingRotate 0.8s linear infinite;
  box-sizing: border-box;
}

.loading-text {
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

@keyframes loadingRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
