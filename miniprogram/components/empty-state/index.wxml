<t-empty
  icon="{{weuiIcon ? '' : icon}}"
  description="{{desc}}"
>
  <view slot="image" wx:if="{{weuiIcon}}" class="empty-icon-wrap">
    <t-icon name="{{weuiIcon === 'add' ? 'add' : weuiIcon === 'search' ? 'search' : weuiIcon === 'time' ? 'time' : weuiIcon === 'info' ? 'info-circle' : 'file'}}" color="#1f53c9" size="72rpx" />
  </view>
  <view slot="action" wx:if="{{buttonText}}">
    <t-button theme="primary" size="large" block bind:tap="handleAction">
      {{buttonText}}
    </t-button>
  </view>
</t-empty>
