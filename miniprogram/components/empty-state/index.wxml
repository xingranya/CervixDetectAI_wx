<view class="card empty-card" aria-role="status">
  <view wx:if="{{normalizedWeuiIcon}}" class="empty-icon-wrap">
    <t-icon name="{{normalizedWeuiIcon}}" size="56rpx" color="#1f53c9" />
  </view>
  <image wx:elif="{{icon}}" class="empty-icon" src="{{icon}}" mode="aspectFit" />
  <text class="empty-title">{{title}}</text>
  <text class="empty-desc">{{desc}}</text>
  <button wx:if="{{buttonText}}" class="primary-button empty-button" bind:tap="handleAction" aria-role="button" aria-label="{{buttonText}}">
    <text class="button-text">{{buttonText}}</text>
  </button>
</view>
