.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.empty-button::after {
  border: 0;
}
