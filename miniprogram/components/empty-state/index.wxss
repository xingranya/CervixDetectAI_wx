.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(198, 210, 236, 0.58);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 83, 201, 0.05);
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #eef3ff;
}

.empty-title {
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.empty-button::after {
  border: 0;
}

.button-text {
  display: block;
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
