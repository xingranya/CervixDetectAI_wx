.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  width: 100%;
  margin-top: 24rpx;
}
