.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: 22rpx;
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-elevated);
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: var(--wx-bg-section);
}

.empty-title {
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: var(--wx-shadow-float);
}

.empty-button::after {
  border: 0;
}

.button-text {
  display: block;
  max-width: 100%;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
