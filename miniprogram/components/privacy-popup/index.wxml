<t-popup visible="{{visible}}" placement="center" show-overlay="{{true}}" close-on-overlay-click="{{false}}">
  <view class="privacy-panel">
    <view class="privacy-icon">
      <t-icon name="info-circle" color="#1f53c9" size="68rpx" />
    </view>
    <text class="privacy-title">隐私保护提示</text>
    <text class="privacy-desc">
      为完成微信登录、头像昵称填写、健康记录保存和复查提醒管理，请先阅读并同意《{{privacyContractName}}》。
    </text>
    <button class="privacy-link" bind:tap="openPrivacyContract">
      <text>查看隐私保护指引</text>
    </button>
    <view class="privacy-actions">
      <button class="privacy-cancel" bind:tap="handleDisagree">
        <text class="button-text">暂不同意</text>
      </button>
      <button
        id="agree-btn"
        class="privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handleAgree"
      >
        <text class="button-text">同意并继续</text>
      </button>
    </view>
  </view>
</t-popup>
