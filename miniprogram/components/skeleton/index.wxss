/* ---- Skeleton Screen ---- */
.skeleton-wrap {
  padding: 20rpx 0;
}

.sk-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sk-gap-12 {
  gap: 12rpx;
}

.sk-mb-12 {
  margin-bottom: 24rpx;
}

.sk-mb-8 {
  margin-bottom: 16rpx;
}

.sk-mt-8 {
  margin-top: 16rpx;
}

.sk-col {
  display: flex;
  flex-direction: column;
}

.sk-flex {
  flex: 1;
  min-width: 0;
}

.sk-flex-1 {
  flex: 1;
}

/* Shimmer animation */
@keyframes sk-shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.sk-line,
.sk-circle,
.sk-card {
  background: linear-gradient(
    90deg,
    rgba(var(--wx-brand-500-rgb), 0.04) 25%,
    rgba(var(--wx-brand-500-rgb), 0.10) 50%,
    rgba(var(--wx-brand-500-rgb), 0.04) 75%
  );
  background-size: 200% 100%;
  animation: sk-shimmer 1.8s ease-in-out infinite;
}

.sk-line {
  border-radius: 8rpx;
  height: 28rpx;
}

.sk-h12 { height: 24rpx; }
.sk-h14 { height: 28rpx; }
.sk-h16 { height: 32rpx; }
.sk-h20 { height: 40rpx; }

.sk-w40 { width: 40%; }
.sk-w45 { width: 45%; }
.sk-w50 { width: 50%; }
.sk-w60 { width: 60%; }
.sk-w65 { width: 65%; }
.sk-w70 { width: 70%; }
.sk-w80 { width: 80%; }

.sk-circle {
  border-radius: 50%;
  flex-shrink: 0;
}

.sk-48 { width: 96rpx; height: 96rpx; }
.sk-60 { width: 120rpx; height: 120rpx; }

.sk-card {
  border-radius: 16rpx;
}

.sk-h80 {
  height: 160rpx;
}

/* Card block mode */
.sk-card-block {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

/* List mode */
.sk-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sk-list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}
