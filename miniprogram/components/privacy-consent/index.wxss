.privacy-consent-mask {
  position: fixed;
  inset: 0;
  background: var(--wx-shadow-modal);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 36rpx;
}

.privacy-consent-panel {
  width: 100%;
  max-width: 640rpx;
  background: var(--wx-bg-primary);
  border-radius: 32rpx;
  padding: 0;
  box-shadow: 0 32rpx 80rpx var(--wx-shadow-bottom-sheet);
  box-sizing: border-box;
  overflow: visible;
}

.privacy-consent-header {
  padding: 36rpx 36rpx 20rpx;
}

.privacy-consent-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.4;
  text-align: center;
}

.privacy-consent-body {
  max-height: 50vh;
  padding: 0 36rpx;
  box-sizing: border-box;
}

.privacy-consent-desc {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-all;
  overflow-wrap: break-word;
}

.privacy-consent-links {
  margin-top: 18rpx;
  line-height: 1.7;
}

.privacy-consent-link {
  color: var(--wx-brand-500);
  font-size: 27rpx;
  font-weight: 800;
  word-break: break-all;
}

.privacy-consent-separator {
  margin: 0 8rpx;
  color: var(--wx-text-secondary);
  font-size: 27rpx;
}

.privacy-consent-note {
  display: block;
  margin-top: 16rpx;
  color: var(--wx-text-tertiary);
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* ---------- Checkbox ---------- */
.privacy-consent-checkbox-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 16rpx 0;
}

.privacy-consent-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c3c6d6;
  background: var(--wx-bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.privacy-consent-checkbox-checked {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  border-color: var(--wx-brand-500);
}

/* CSS 纯对勾，不依赖 icon 组件 */
.privacy-consent-checkmark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--wx-text-on-primary);
  border-bottom: 3rpx solid var(--wx-text-on-primary);
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.privacy-consent-checkbox-label {
  margin-left: 14rpx;
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* ---------- Actions ---------- */
.privacy-consent-actions {
  display: flex;
  gap: 18rpx;
  padding: 28rpx 36rpx 36rpx;
}

.privacy-consent-btn-decline,
.privacy-consent-btn-confirm {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.privacy-consent-btn-decline::after,
.privacy-consent-btn-confirm::after {
  border: 0;
}

.privacy-consent-btn-decline {
  background: var(--wx-bg-disabled);
  color: var(--wx-text-tertiary);
}

.privacy-consent-btn-confirm {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  box-shadow: 0 12rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.24);
}

.privacy-consent-btn-disabled {
  background: #d4daf0 !important;
  color: rgba(255, 255, 255, 0.8) !important;
  box-shadow: none !important;
}
