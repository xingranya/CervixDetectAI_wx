.confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--wx-overlay);
  box-sizing: border-box;
}

.confirm-panel {
  width: 100%;
  padding: 34rpx 30rpx 28rpx;
  border: 1rpx solid var(--wx-border-card);
  border-radius: 24rpx;
  background: var(--wx-bg-primary);
  box-shadow: 0 24rpx 64rpx var(--wx-shadow-confirm);
  box-sizing: border-box;
}

.confirm-title,
.confirm-content {
  display: block;
}

.confirm-title {
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.confirm-content {
  margin-top: 18rpx;
  color: var(--wx-text-secondary);
  font-size: 30rpx;
  line-height: 1.62;
  text-align: center;
}

.confirm-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  margin-top: 30rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.confirm-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: normal;
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}

.confirm-button::after {
  border: 0;
}

.confirm-button text {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confirm-cancel {
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.16);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-700);
}

.confirm-submit {
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  box-shadow: 0 10rpx 24rpx rgba(var(--wx-brand-500-rgb), 0.18);
}

.confirm-submit-warn {
  background: var(--wx-danger);
  box-shadow: 0 10rpx 24rpx rgba(186, 26, 26, 0.16);
}
