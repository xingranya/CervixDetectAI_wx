.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-header-main {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title-icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
}

.title-weui-icon {
  flex: 0 0 auto;
}

.section-title {
  color: var(--wx-text-primary);
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.22;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.6;
}

.section-extra {
  flex: 0 0 auto;
}
