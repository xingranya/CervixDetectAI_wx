<view class="section-header">
  <view class="section-header-main">
    <view class="title-row">
      <t-icon wx:if="{{weuiIcon}}" name="{{weuiIcon === 'note' ? 'file' : weuiIcon === 'comment' ? 'chat' : weuiIcon === 'time' ? 'time' : weuiIcon === 'info' ? 'info-circle' : weuiIcon}}" color="#1f53c9" size="56rpx" />
      <image wx:elif="{{icon}}" class="title-icon" src="{{icon}}" mode="aspectFit" />
      <text class="section-title">{{title}}</text>
    </view>
    <text wx:if="{{desc}}" class="section-desc">{{desc}}</text>
  </view>
  <view class="section-extra">
    <slot name="extra"></slot>
  </view>
</view>
