.setup-sheet-root {
  position: fixed;
  inset: 0;
  z-index: 9900;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.setup-sheet-root.setup-sheet-open .setup-sheet-mask {
  opacity: 1;
}
.setup-sheet-root.setup-sheet-open .setup-sheet-panel {
  transform: translateY(0);
}

.setup-sheet-root.setup-sheet-closing .setup-sheet-mask {
  opacity: 0;
}
.setup-sheet-root.setup-sheet-closing .setup-sheet-panel {
  transform: translateY(100%);
}

.setup-sheet-mask {
  position: absolute;
  inset: 0;
  background: var(--wx-overlay);
  opacity: 0;
  transition: opacity 0.26s ease;
}

.setup-sheet-panel {
  position: relative;
  width: 100%;
  max-height: 90vh;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 50% 0, rgba(219, 225, 255, 0.7), transparent 42%),
    linear-gradient(180deg, var(--wx-bg-hero-gradient-start) 0%, var(--wx-bg-hero-gradient-end) 100%);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -18rpx 48rpx var(--wx-shadow-sheet);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.setup-sheet-drag-bar {
  width: 60rpx;
  height: 8rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: var(--wx-bg-subtle-14);
}

.setup-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 18rpx;
}

.setup-sheet-title {
  color: var(--wx-text-primary);
  font-size: 38rpx;
  font-weight: 900;
}

.setup-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--wx-bg-subtle);
  margin-right: -10rpx;
}

.setup-sheet-close:active {
  background: rgba(15, 23, 42, 0.12);
}

.setup-sheet-body {
  flex: 1;
  max-height: calc(90vh - 180rpx);
  width: 100%;
}

.setup-sheet-inner {
  padding: 0 4rpx 12rpx;
}

.setup-sheet-desc {
  display: block;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.68;
  margin-bottom: 22rpx;
}

.setup-sheet-card {
  padding: 26rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: 24rpx;
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-elevated);
}

.setup-sheet-section-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
}

.setup-sheet-note {
  display: block;
  margin-top: 10rpx;
  color: var(--wx-text-tertiary);
  font-size: 25rpx;
  line-height: 1.62;
}

.setup-sheet-agreement-links {
  margin-top: 12rpx;
  line-height: 1.7;
}

.setup-sheet-agreement-link,
.setup-sheet-agreement-separator {
  font-size: 25rpx;
}

.setup-sheet-agreement-link {
  color: var(--wx-brand-500);
  font-weight: 800;
}

.setup-sheet-agreement-separator {
  margin: 0 8rpx;
  color: var(--wx-text-secondary);
}

.setup-sheet-form,
.setup-sheet-actions {
  margin-top: 22rpx;
}

.setup-sheet-label {
  display: block;
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 900;
}

.setup-sheet-avatar-label {
  margin-top: 22rpx;
}

.setup-sheet-input {
  width: 100%;
  height: 84rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--wx-border-light);
  border-radius: 18rpx;
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 29rpx;
  box-sizing: border-box;
}

.setup-sheet-placeholder {
  color: var(--wx-text-tertiary);
}

.setup-sheet-avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx !important;
  height: 180rpx !important;
  margin-top: 14rpx;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-light) !important;
  border-radius: 50% !important;
  background: var(--wx-bg-input) !important;
  overflow: hidden;
}

.setup-sheet-avatar-picker::after {
  border: 0;
}

.setup-sheet-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.setup-sheet-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.setup-sheet-avatar-placeholder-text {
  color: var(--wx-text-tertiary);
  font-size: 22rpx;
}

.setup-sheet-avatar-note {
  display: block;
  margin-top: 12rpx;
  color: var(--wx-text-tertiary);
  font-size: 23rpx;
  line-height: 1.6;
}

.setup-sheet-primary-button,
.setup-sheet-secondary-button,
.setup-sheet-popup-cancel,
.setup-sheet-popup-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.setup-sheet-primary-button {
  width: 100%;
  height: 88rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.2);
}

.setup-sheet-primary-button[disabled] {
  background: rgba(var(--wx-brand-500-rgb), 0.36);
  color: var(--wx-text-on-primary);
  box-shadow: none;
}

.setup-sheet-secondary-button {
  width: 100%;
  height: 80rpx;
  margin-top: 14rpx;
  border-radius: 20rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-500);
  font-size: 28rpx;
  font-weight: 800;
}

.setup-sheet-primary-button::after,
.setup-sheet-secondary-button::after,
.setup-sheet-popup-cancel::after,
.setup-sheet-popup-confirm::after {
  border: 0;
}

.setup-sheet-button-content {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.setup-sheet-button-text {
  display: block;
  letter-spacing: 1rpx;
}

.setup-sheet-footer-safe {
  height: 24rpx;
}

.setup-sheet-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: var(--wx-overlay);
}

.setup-sheet-popup-panel {
  width: 100%;
  padding: 34rpx;
  border-radius: 28rpx;
  background: var(--wx-bg-primary);
  box-shadow: 0 26rpx 70rpx var(--wx-shadow-sheet);
}

.setup-sheet-popup-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.setup-sheet-popup-desc {
  display: block;
  margin-top: 14rpx;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.setup-sheet-popup-links {
  margin-top: 16rpx;
}

.setup-sheet-popup-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.setup-sheet-popup-cancel,
.setup-sheet-popup-confirm {
  flex: 1;
  height: 82rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.setup-sheet-popup-cancel {
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-500);
}

.setup-sheet-popup-confirm {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
}
