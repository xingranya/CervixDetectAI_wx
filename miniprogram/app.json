{
  "pages": [
    "pages/home/index",
    "pages/login/index",
    "pages/records/index",
    "pages/reminders/index",
    "pages/profile/index"
  ],
  "subpackages": [
    {
      "root": "packages/records",
      "pages": [
        "record-detail/index",
        "record-form/index"
      ]
    },
    {
      "root": "packages/reminders",
      "pages": [
        "reminder-form/index"
      ]
    },
    {
      "root": "packages/tools",
      "pages": [
        "questions/index",
        "articles/index"
      ]
    },
    {
      "root": "packages/profile",
      "pages": [
        "privacy/index",
        "service/index",
        "setup/index",
        "compliance/index",
        "feedback/index"
      ]
    },
    {
      "root": "packages/assistant",
      "pages": [
        "chat/index"
      ]
    },
    {
      "root": "packages/notifications",
      "pages": [
        "list/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": [
        "packages/records",
        "packages/reminders",
        "packages/tools",
        "packages/assistant"
      ]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "packages/profile"
      ]
    }
  },
  "useExtendedLib": {
    "weui": true
  },
  "window": {
    "navigationBarTitleText": "云端智诊",
    "navigationBarBackgroundColor": "#f8fafc",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f8fafc"
  },
  "tabBar": {
    "color": "#66748a",
    "selectedColor": "#2563eb",
    "backgroundColor": "#f8f9ff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "assets/icons/home-inactive.png",
        "selectedIconPath": "assets/icons/home-active.png"
      },
      {
        "pagePath": "pages/records/index",
        "text": "记录",
        "iconPath": "assets/icons/records-inactive.png",
        "selectedIconPath": "assets/icons/records-active.png"
      },
      {
        "pagePath": "pages/reminders/index",
        "text": "提醒",
        "iconPath": "assets/icons/reminders-inactive.png",
        "selectedIconPath": "assets/icons/reminders-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "assets/icons/profile-inactive.png",
        "selectedIconPath": "assets/icons/profile-active.png"
      }
    ]
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "styles/theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
