.profile-page {
  padding-bottom: 72rpx;
}

.profile-hero {
  margin-bottom: 28rpx;
  padding: 36rpx 30rpx 30rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(38, 166, 154, 0.36), transparent 34%),
    linear-gradient(135deg, #1976d2 0%, #1d4ed8 100%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx rgba(25, 118, 210, 0.2);
}

.profile-user-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.42);
  box-sizing: border-box;
}

.profile-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
}

.profile-avatar-icon {
  width: 58rpx;
  height: 58rpx;
}

.profile-user-body {
  flex: 1;
  min-width: 0;
}

.profile-label {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  font-weight: 700;
}

.profile-title {
  display: block;
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.profile-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.profile-metric {
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  text-align: center;
}

.profile-metric-value,
.profile-metric-label {
  display: block;
}

.profile-metric-value {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.profile-section-head {
  margin: 6rpx 4rpx 18rpx;
}

.profile-section-title,
.profile-section-desc {
  display: block;
}

.profile-section-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-section-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
}

.profile-menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.profile-menu-card {
  min-height: 166rpx;
  padding: 24rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.profile-menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 18rpx;
}

.profile-menu-body {
  min-width: 0;
}

.menu-title,
.menu-desc {
  display: block;
}

.menu-title {
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.menu-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.logout-button {
  width: 100%;
  height: 78rpx;
  margin-top: 34rpx;
  border: 1rpx solid rgba(211, 47, 47, 0.18);
  border-radius: 18rpx;
  background: #fff;
  color: #d32f2f;
  font-size: 28rpx;
  line-height: 78rpx;
}
