.profile-page {
  padding-bottom: calc(116rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  margin-bottom: 28rpx;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 50% 0, rgba(219, 225, 255, 0.76), transparent 42%),
    linear-gradient(180deg, #ffffff, #edf3ff);
  color: #ffffff;
  border: 1rpx solid rgba(198, 210, 236, 0.64);
  box-shadow: 0 18rpx 42rpx rgba(31, 83, 201, 0.07);
}

.profile-user-row {
  display: block;
  text-align: center;
}

.profile-avatar-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 118rpx;
  margin: 0 auto;
  padding: 6rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
  border: 1rpx solid rgba(64, 109, 228, 0.16);
  box-shadow: 0 14rpx 32rpx rgba(31, 83, 201, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

.profile-setup-hint {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  border: 1rpx solid rgba(31, 83, 201, 0.14);
  font-size: 22rpx;
  line-height: 1.4;
}

.profile-setup-hint:active {
  background: rgba(31, 83, 201, 0.14);
}

.profile-setup-hint-text {
  display: block;
  color: #1f53c9;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-avatar,
.profile-avatar-default {
  width: 106rpx;
  height: 106rpx;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(64, 109, 228, 0.18);
}

.profile-avatar {
  display: block;
}

.flat-avatar-head {
  position: absolute;
  top: 27rpx;
  left: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  border: 5rpx solid #6f8fe8;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.flat-avatar-body {
  position: absolute;
  left: 50%;
  bottom: 26rpx;
  width: 58rpx;
  height: 30rpx;
  margin-left: -29rpx;
  border: 5rpx solid #6f8fe8;
  border-bottom: 0;
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
}

.profile-user-body {
  margin-top: 22rpx;
}

.profile-brand {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 7rpx 14rpx 7rpx 7rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 8rpx 20rpx rgba(24, 67, 126, 0.05);
  box-sizing: border-box;
}

.profile-brand-logo {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 auto;
}

.profile-label {
  display: block;
  color: rgb(24, 118, 210);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.profile-title {
  display: block;
  margin-top: 14rpx;
  color: #0b1c30;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-desc {
  display: block;
  margin-top: 10rpx;
  color: #3e4a5f;
  font-size: 25rpx;
  line-height: 1.5;
}

.profile-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.profile-metric {
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(198, 210, 236, 0.42);
  text-align: center;
}

.profile-metric-value,
.profile-metric-label {
  display: block;
}

.profile-metric-value {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-metric-label {
  margin-top: 8rpx;
  color: #3e4a5f;
  font-size: 24rpx;
}

.guest-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
}

.guest-panel-title,
.guest-panel-desc {
  display: block;
}

.guest-panel-title {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 900;
}

.guest-panel-desc {
  margin-top: 10rpx;
  color: #3e4a5f;
  font-size: 25rpx;
  line-height: 1.6;
}

.guest-login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(31, 83, 201, 0.2);
}

.guest-login-button::after {
  border: 0;
}

.profile-section {
  margin-top: 8rpx;
}

.profile-section-head {
  margin: 0 4rpx 18rpx;
}

.profile-section-title,
.profile-section-desc {
  display: block;
}

.profile-section-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-section-desc {
  margin-top: 8rpx;
  color: #3e4a5f;
  font-size: 25rpx;
}

.profile-menu-list {
  overflow: hidden;
  border: 1rpx solid rgba(198, 210, 236, 0.58);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 83, 201, 0.05);
}

.profile-menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(195, 198, 214, 0.26);
  box-sizing: border-box;
}

.profile-menu-row:last-child {
  border-bottom: 0;
}

.profile-menu-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #eef3ff;
  flex: 0 0 auto;
}

.profile-menu-icon {
  width: 62rpx;
  height: 62rpx;
}

.profile-menu-body {
  flex: 1;
  min-width: 0;
}

.menu-arrow {
  color: #9aa6b8;
  font-size: 44rpx;
  line-height: 1;
}

.menu-title,
.menu-desc {
  display: block;
}

.menu-title {
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.menu-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  margin-top: 34rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.2);
  color: #ba1a1a;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.logout-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}
