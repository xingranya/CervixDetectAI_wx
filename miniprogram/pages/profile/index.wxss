.profile-hero {
  margin-bottom: 28rpx;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1976d2 0%, #1d4ed8 100%);
  color: #ffffff;
}

.profile-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
}

.menu-title {
  display: block;
  color: #1e293b;
  font-size: 31rpx;
  font-weight: 800;
}

.menu-desc {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
}
