.profile-page {
  padding-bottom: 72rpx;
}

.profile-hero {
  margin-bottom: 28rpx;
  padding: 38rpx 30rpx 30rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 50% 0, rgba(219, 225, 255, 0.94), transparent 46%),
    linear-gradient(180deg, rgba(248, 249, 255, 0.86), rgba(239, 244, 255, 0.78));
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 20rpx 46rpx rgba(31, 83, 201, 0.08);
}

.profile-user-row {
  display: block;
  text-align: center;
}

.profile-avatar-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto;
  padding: 6rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
  border: 1rpx solid rgba(64, 109, 228, 0.16);
  box-shadow: 0 14rpx 32rpx rgba(31, 83, 201, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

.profile-avatar,
.profile-avatar-default {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(64, 109, 228, 0.18);
}

.profile-avatar {
  display: block;
}

.flat-avatar-head {
  position: absolute;
  top: 27rpx;
  left: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  border: 5rpx solid #6f8fe8;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.flat-avatar-body {
  position: absolute;
  left: 50%;
  bottom: 26rpx;
  width: 58rpx;
  height: 30rpx;
  margin-left: -29rpx;
  border: 5rpx solid #6f8fe8;
  border-bottom: 0;
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
}

.profile-user-body {
  margin-top: 22rpx;
}

.profile-label {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.1);
  color: #1f53c9;
  font-size: 23rpx;
  font-weight: 700;
}

.profile-title {
  display: block;
  margin-top: 14rpx;
  color: #0b1c30;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-desc {
  display: block;
  margin-top: 10rpx;
  color: #66748a;
  font-size: 25rpx;
  line-height: 1.5;
}

.profile-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.profile-metric {
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  text-align: center;
}

.profile-metric-value,
.profile-metric-label {
  display: block;
}

.profile-metric-value {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 900;
}

.profile-metric-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 24rpx;
}

.guest-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
}

.guest-panel-title,
.guest-panel-desc {
  display: block;
}

.guest-panel-title {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 900;
}

.guest-panel-desc {
  margin-top: 10rpx;
  color: #66748a;
  font-size: 25rpx;
  line-height: 1.6;
}

.guest-login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(31, 83, 201, 0.2);
}

.guest-login-button::after {
  border: 0;
}

.profile-section {
  margin-top: 8rpx;
}

.profile-section-head {
  margin: 0 4rpx 18rpx;
}

.profile-section-title,
.profile-section-desc {
  display: block;
}

.profile-section-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-section-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
}

.profile-menu-list {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 38rpx rgba(31, 83, 201, 0.06);
}

.profile-menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(195, 198, 214, 0.26);
  box-sizing: border-box;
}

.profile-menu-row:last-child {
  border-bottom: 0;
}

.profile-menu-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: rgba(219, 225, 255, 0.58);
  flex: 0 0 auto;
}

.profile-menu-icon {
  width: 62rpx;
  height: 62rpx;
}

.profile-menu-body {
  flex: 1;
  min-width: 0;
}

.menu-arrow {
  color: #9aa6b8;
  font-size: 44rpx;
  line-height: 1;
}

.menu-title,
.menu-desc {
  display: block;
}

.menu-title {
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.menu-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  margin-top: 34rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 218, 214, 0.2);
  color: #ba1a1a;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.logout-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}
