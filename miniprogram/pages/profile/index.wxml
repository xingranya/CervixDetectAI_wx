<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-user-row">
      <view class="profile-avatar-shell">
        <image
          wx:if="{{activeAvatarUrl}}"
          class="profile-avatar"
          src="{{activeAvatarUrl}}"
          mode="aspectFill"
          data-url="{{activeAvatarUrl}}"
          bind:error="onAvatarLoadError"
        />
        <view wx:else class="profile-avatar-default">
          <mp-icon icon="me" color="#ffffff" size="{{34}}" />
        </view>
      </view>
      <view class="profile-user-body">
        <view class="profile-brand">
          <image class="profile-brand-logo" src="https://img1.tucang.cc/api/image/show/45b4f4864a1e97681b52b7a1e1f5cc31" mode="aspectFit" />
          <text class="profile-label">{{appName}}</text>
        </view>
        <text class="profile-title">{{user.nickname || '微信用户'}}</text>
        <text class="profile-desc">{{isGuest ? '可先查看说明、知识与功能入口，确认需要后再自愿登录。' : '健康记录与复查安排已为你整理'}}</text>
        <view wx:if="{{!isGuest}}" class="profile-setup-hint" catch:tap="goProfileSetup">
          <mp-icon icon="info" color="#1f53c9" size="{{14}}" />
          <text class="profile-setup-hint-text">点击头像编辑资料</text>
          <mp-icon icon="arrow" color="#1f53c9" size="{{12}}" />
        </view>
      </view>
    </view>

    <view class="profile-metrics">
      <view wx:for="{{metrics}}" wx:key="label" class="profile-metric">
        <text class="profile-metric-value">{{item.value}}</text>
        <text class="profile-metric-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{isGuest}}" class="guest-panel">
      <text class="guest-panel-title">当前处于体验模式</text>
      <text class="guest-panel-desc">你可以先浏览隐私说明、健康知识、服务边界和功能入口；需要保存个人记录时，再自行选择登录。</text>
      <button class="guest-login-button" bind:tap="goLogin">
        <view class="button-content">
          <mp-icon icon="me" color="#ffffff" size="{{18}}" />
          <text class="button-text">去登录</text>
        </view>
      </button>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-section-head">
      <text class="profile-section-title">常用功能</text>
      <text class="profile-section-desc">快速进入你的健康管理事项</text>
    </view>

    <view class="profile-menu-list">
      <view
        wx:for="{{menus}}"
        wx:key="title"
        class="profile-menu-row"
        bind:tap="openMenu"
        data-path="{{item.path}}"
        data-tab="{{item.tab}}"
      >
          <view class="profile-menu-icon-wrap">
          <mp-icon wx:if="{{item.weuiIcon}}" icon="{{item.weuiIcon}}" color="#1f53c9" size="{{24}}" />
        </view>
        <view class="profile-menu-body">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <mp-icon icon="arrow" color="#4d5d73" size="{{16}}" />
      </view>
    </view>
  </view>

  <button wx:if="{{!isGuest}}" class="logout-button" bind:tap="logout">
    <view class="button-content">
      <mp-icon icon="close" color="#ba1a1a" size="{{18}}" />
      <text class="button-text">退出登录</text>
    </view>
  </button>
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="退出登录"
    content="退出后可重新登录继续管理自己的记录。"
    confirm-text="退出"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmLogout"
  />

  <setup-sheet
    visible="{{setupSheetVisible}}"
    loggedIn="{{!isGuest}}"
    bind:closed="onSetupSheetClosed"
  />
</view>
