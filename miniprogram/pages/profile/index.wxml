<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-user-row">
      <view class="profile-avatar-shell">
        <image
          wx:if="{{activeAvatarUrl}}"
          class="profile-avatar"
          src="{{activeAvatarUrl}}"
          mode="aspectFill"
          data-url="{{activeAvatarUrl}}"
          bind:error="onAvatarLoadError"
        />
        <view wx:else class="profile-avatar-default">
          <image class="profile-avatar-icon" src="/assets/icons/profile-white.png" mode="aspectFit" />
        </view>
      </view>
      <view class="profile-user-body">
        <text class="profile-label">{{appName}}</text>
        <text class="profile-title">{{user.nickname || '微信用户'}}</text>
        <text class="profile-desc">健康记录与复查安排已为你整理</text>
      </view>
    </view>

    <view class="profile-metrics">
      <view wx:for="{{metrics}}" wx:key="label" class="profile-metric">
        <text class="profile-metric-value">{{item.value}}</text>
        <text class="profile-metric-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-section-head">
      <text class="profile-section-title">常用功能</text>
      <text class="profile-section-desc">快速进入你的健康管理事项</text>
    </view>

    <view class="profile-menu-list">
      <view
        wx:for="{{menus}}"
        wx:key="title"
        class="profile-menu-row"
        bind:tap="openMenu"
        data-path="{{item.path}}"
        data-tab="{{item.tab}}"
      >
        <view class="profile-menu-icon-wrap">
          <image class="profile-menu-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="profile-menu-body">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <button class="logout-button" bind:tap="logout">
    <image class="button-icon" src="/assets/icons/logout-danger.png" mode="aspectFit" />
    退出登录
  </button>
</view>
