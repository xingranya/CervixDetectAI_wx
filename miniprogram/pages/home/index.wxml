<view class="page home-page">
  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <text class="state-title">正在加载健康记录</text>
    <text class="state-desc">请稍候，正在同步你的健康管理信息。</text>
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载首页</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" bind:tap="loadHome">重新加载</button>
  </view>

  <block wx:else>
    <view class="hero dashboard-card">
      <view class="hero-top">
        <view>
          <text class="section-kicker">女性健康管理助手</text>
          <view class="status-row">
            <view class="status-dot"></view>
            <text class="hero-status">记录中</text>
          </view>
        </view>
        <view class="follow-card">
          <text class="follow-label">下次提醒</text>
          <text class="follow-date">{{home.nextReminderValue}}</text>
        </view>
      </view>
      <text class="hero-title">{{home.userName}}，请按计划管理健康记录</text>
      <text class="hero-desc">{{home.latestSummary}}</text>
      <view class="metric-row">
        <view wx:for="{{home.metrics}}" wx:key="label" class="metric-item">
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="home-section-head">
      <text class="section-title">快捷操作</text>
      <text class="section-subtitle">把复查准备放进日常计划</text>
    </view>

    <view class="action-grid">
      <button
        wx:for="{{actions}}"
        wx:key="label"
        class="action-card action-card-{{item.tone}}"
        hover-class="action-card-pressed"
        bind:tap="goPage"
        data-path="{{item.path}}"
      >
        <view class="action-icon-wrap">
          <image class="action-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="action-title">{{item.label}}</text>
        <text class="action-desc">{{item.desc}}</text>
      </button>
    </view>

    <view class="card latest-card">
      <view class="card-head">
        <view class="card-title-row">
          <view class="icon-chip">
            <image src="/assets/icons/detail-active.png" mode="aspectFit" />
          </view>
          <view class="latest-title-block">
            <text class="section-kicker">最近记录</text>
            <text class="latest-title">{{home.latestTitle}}</text>
          </view>
        </view>
        <text class="pill">{{home.latestDate || '待记录'}}</text>
      </view>
      <text class="latest-desc">{{home.nextReminder}}</text>
      <button class="primary-button" bind:tap="goPage" data-path="/pages/records/index">
        <image class="button-icon" src="/assets/icons/records-white.png" mode="aspectFit" />
        查看检查记录
      </button>
    </view>

    <view class="safe-note">{{home.disclaimer}}</view>
  </block>
</view>
