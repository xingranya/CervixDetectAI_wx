<view class="page home-page">
  <view wx:if="{{pageStatus === 'loading'}}" class="skeleton-container">
    <skeleton mode="hero" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载首页</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" hover-class="u-hover" bind:tap="loadHome">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <block wx:else>
    <view class="hero dashboard-card">
      <view class="hero-top-row">
        <view class="home-brand">
          <image class="home-brand-logo" src="/assets/icons/logo.png" mode="aspectFit" />
          <text class="home-brand-name">云端智诊</text>
        </view>
        <view class="hero-top-spacer"></view>
        <view class="notification-entry" hover-class="u-hover" bind:tap="goPage" data-path="{{notificationPath}}" aria-role="button" aria-label="通知中心，{{unreadCount}}条未读">
          <mp-icon icon="notification" color="#475569" size="{{22}}" />
          <view wx:if="{{unreadCount > 0}}" class="notification-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
      </view>
      <view class="hero-user-row">
        <view class="avatar-wrap">
          <image
            wx:if="{{activeAvatarUrl && !isGuest}}"
            class="home-avatar"
            src="{{activeAvatarUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <mp-icon wx:else icon="me" color="{{brandColor}}" size="{{32}}" />
          <view class="status-dot status-dot-{{home.healthTone}}"></view>
        </view>
        <view class="hero-top-copy">
          <view class="status-row">
            <view class="status-pill status-pill-{{home.healthTone}}">
              <view class="status-dot-inline status-dot-inline-{{home.healthTone}}"></view>
              <text>{{home.healthLabel || (isGuest ? '体验中' : '记录中')}}</text>
            </view>
          </view>
        </view>
        <view class="follow-card">
          <text class="follow-label">下次提醒</text>
          <text class="follow-date">{{home.nextReminderValue}}</text>
        </view>
      </view>
      <text class="hero-title">{{isGuest ? '当前处于体验模式' : home.userName + '，请按计划管理健康记录'}}</text>
      <text class="hero-desc">{{home.latestSummary}}</text>
      <view class="metric-row">
        <view wx:for="{{home.metrics}}" wx:key="label" class="metric-item metric-item-{{item.tone}}">
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-label">{{item.label}}</text>
        </view>
      </view>
      <view wx:if="{{isGuest}}" class="guest-entry-card">
        <text class="guest-entry-title">先浏览功能，再决定是否登录</text>
        <text class="guest-entry-desc">登录仅在你需要保存个人记录、提醒和备忘时使用，头像与昵称均为选填。</text>
        <button class="primary-button guest-entry-button" hover-class="u-hover" bind:tap="goLogin">
          <view class="button-content">
            <mp-icon icon="me" color="#ffffff" size="{{18}}" />
            <text class="button-text guest-entry-button-text">登录保存数据</text>
          </view>
        </button>
      </view>
    </view>

    <view class="home-section-head">
      <text class="section-title">快捷操作</text>
      <text class="section-subtitle">把复查准备放进日常计划</text>
    </view>

    <view class="action-grid" aria-role="list">
      <view
        wx:for="{{actions}}"
        wx:key="label"
        class="action-card action-card-{{item.tone}} action-card-{{item.side}}"
        hover-class="action-card-pressed"
        bind:tap="goPage"
        data-path="{{item.path}}"
        aria-role="listitem"
        aria-label="{{item.label}}，{{item.desc}}"
      >
        <view class="action-icon-wrap">
          <image class="action-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="action-copy">
          <text class="action-title">{{item.label}}</text>
          <text class="action-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="card latest-card timeline-card">
      <view class="timeline-line"></view>
      <view class="timeline-dot"></view>
      <view class="card-head">
        <view class="card-title-row">
          <view class="icon-chip">
            <image class="icon-chip-image" src="/assets/icons/records-active.png" mode="aspectFit" />
          </view>
          <view class="latest-title-block">
            <text class="section-kicker">最近记录</text>
            <text class="latest-title">{{home.latestTitle}}</text>
          </view>
        </view>
        <text class="pill">{{home.latestDate || '待记录'}}</text>
      </view>
      <text class="latest-desc">{{home.nextReminder}}</text>
      <button class="primary-button" hover-class="u-hover" bind:tap="goPage" data-path="/pages/records/index" aria-role="button" aria-label="查看检查记录">
        <view class="button-content">
          <mp-icon icon="note" color="#ffffff" size="{{18}}" />
          <text class="button-text">查看检查记录</text>
        </view>
      </button>
    </view>

    <view class="safe-note">{{home.disclaimer}}</view>
  </block>
</view>
