.hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx 30rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 84% 8%, rgba(64, 109, 228, 0.16), transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.78) 0%, rgba(229, 238, 255, 0.72) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 22rpx 58rpx rgba(31, 83, 201, 0.1);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #26a69a;
  box-shadow: 0 0 0 8rpx rgba(38, 166, 154, 0.12);
}

.hero-status {
  color: #0b1c30;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.follow-card {
  min-width: 158rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.follow-label,
.follow-date {
  display: block;
  text-align: right;
}

.follow-label {
  color: #66748a;
  font-size: 21rpx;
}

.follow-date {
  margin-top: 6rpx;
  color: #1f53c9;
  font-size: 25rpx;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 28rpx;
  color: #0b1c30;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-desc {
  display: block;
  margin-top: 18rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.7;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.metric-item {
  padding: 20rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
}

.metric-value,
.metric-label {
  display: block;
  text-align: center;
}

.metric-value {
  color: #0b1c30;
  font-size: 30rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
}

.latest-card {
  margin-top: 28rpx;
}

.home-section-head {
  margin: 30rpx 4rpx 18rpx;
}

.home-section-head .section-title {
  display: block;
  margin-bottom: 6rpx;
}

.section-subtitle {
  display: block;
  color: #66748a;
  font-size: 25rpx;
}

.state-card {
  margin-top: 120rpx;
}

.state-title,
.state-desc {
  display: block;
}

.state-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.state-desc {
  margin: 14rpx 0 24rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title-row {
  flex: 1;
  min-width: 0;
}

.latest-title-block {
  flex: 1;
  min-width: 0;
}

.latest-title {
  display: block;
  margin-top: 6rpx;
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.latest-desc {
  display: block;
  margin: 10rpx 0 24rpx;
  color: #66748a;
  font-size: 28rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-card {
  min-height: 178rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #0b1c30;
  text-align: left;
  box-shadow: 0 14rpx 34rpx rgba(31, 83, 201, 0.06);
  padding: 24rpx;
  box-sizing: border-box;
  line-height: 1.3;
}

.action-card::after {
  border: 0;
}

.action-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-card-green {
  border-color: rgba(31, 83, 201, 0.18);
  background: rgba(255, 255, 255, 0.76);
}

.action-card-blue {
  border-color: rgba(64, 109, 228, 0.2);
  background: rgba(239, 244, 255, 0.76);
}

.action-card-gold {
  border-color: rgba(38, 166, 154, 0.22);
  background: rgba(239, 255, 252, 0.72);
}

.action-card-mint {
  border-color: rgba(49, 204, 236, 0.22);
  background: rgba(239, 250, 255, 0.74);
}

.action-card-green .action-icon-wrap {
  background: rgba(219, 225, 255, 0.62);
}

.action-card-blue .action-icon-wrap {
  background: rgba(211, 228, 254, 0.66);
}

.action-card-gold .action-icon-wrap {
  background: rgba(210, 242, 237, 0.68);
}

.action-card-mint .action-icon-wrap {
  background: rgba(211, 246, 255, 0.68);
}

.action-title,
.action-desc {
  display: block;
}

.action-title {
  font-size: 29rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 23rpx;
}

.guide-card {
  margin-top: 24rpx;
}

.guide-step {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(25, 118, 210, 0.08);
}

.guide-step:first-of-type {
  border-top: 0;
}

.guide-index {
  flex: 0 0 56rpx;
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 800;
}

.guide-title,
.guide-desc {
  display: block;
}

.guide-title {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
}

.guide-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}
