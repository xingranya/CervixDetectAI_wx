.skeleton-container {
  padding: 24rpx;
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--wx-text-primary);
}

.section-kicker {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 86rpx;
  border-radius: var(--wx-radius-sm);
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: var(--wx-shadow-button);
}

.primary-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  max-width: 32rpx;
  max-height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--wx-brand-100);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--wx-brand-100);
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.safe-note {
  margin-top: 18rpx;
  margin-bottom: 0;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--wx-bg-glass-light);
  border: 1rpx solid var(--wx-border-light);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 28rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 18% 0, rgba(var(--wx-brand-500-rgb), 0.18), transparent 44%),
    linear-gradient(135deg, var(--wx-bg-primary) 0%, var(--wx-brand-50) 100%);
  border: 1rpx solid var(--wx-border-white-72);
  box-shadow: var(--wx-shadow-elevated);
  box-sizing: border-box;
}

.home-brand {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
  margin-bottom: 24rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  border: 1rpx solid var(--wx-border-brand);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-glass);
  box-shadow: var(--wx-shadow-soft);
  box-sizing: border-box;
}

.home-brand-logo {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.home-brand-name {
  display: block;
  color: var(--wx-brand-500);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.hero-top-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.avatar-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--wx-brand-200);
  border: 4rpx solid var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  flex: 0 0 auto;
}

.home-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.hero-top-copy {
  flex: 1;
  min-width: 0;
}

.status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 0;
}

.status-dot {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--wx-success);
  border: 4rpx solid var(--wx-bg-primary);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.10);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 800;
}

.status-dot-inline {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--wx-success);
  box-shadow: 0 0 0 6rpx var(--wx-success-light);
  flex: 0 0 auto;
}

.hero-status {
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  line-height: 40rpx;
}

.follow-card {
  min-width: 134rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--wx-bg-glass);
  border: 1rpx solid var(--wx-border-white-90);
  box-shadow: var(--wx-shadow-card);
}

.follow-label,
.follow-date {
  display: block;
  text-align: center;
}

.follow-label {
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
}

.follow-date {
  margin-top: 8rpx;
  color: var(--wx-brand-700);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.15;
}

.hero-title {
  display: block;
  margin-top: 26rpx;
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
  min-width: 0;
  overflow-wrap: break-word;
  white-space: normal;
}

.hero-time {
  flex: 0 0 auto;
  max-width: 168rpx;
  color: var(--wx-text-secondary);
  font-size: 21rpx;
  line-height: 1.35;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: var(--wx-text-secondary);
  font-size: 27rpx;
  line-height: 1.52;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-item {
  min-width: 0;
  padding: 22rpx 8rpx 20rpx;
  border-radius: 16rpx;
  background: var(--wx-bg-glass);
  border: 1rpx solid var(--wx-border-white-90);
  box-shadow: var(--wx-shadow-card);
}

.metric-value,
.metric-label {
  display: block;
  text-align: center;
}

.metric-value {
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.metric-label {
  margin-top: 12rpx;
  color: var(--wx-text-secondary);
  font-size: 23rpx;
  line-height: 1.25;
}

.guest-entry-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: var(--wx-bg-glass);
  border: 1rpx solid var(--wx-border-white-90);
}

.guest-entry-title,
.guest-entry-desc {
  display: block;
}

.guest-entry-title {
  color: var(--wx-text-primary);
  font-size: 30rpx;
  font-weight: 900;
}

.guest-entry-desc {
  margin-top: 10rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.guest-entry-button {
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  line-height: normal;
  white-space: nowrap;
}

.guest-entry-button-text {
  display: block;
  font-size: 28rpx;
  line-height: normal;
  white-space: nowrap;
}

.latest-card {
  margin-top: 24rpx;
  margin-bottom: 0;
}

.home-section-head {
  margin: 34rpx 0 18rpx;
}

.home-section-head .section-title {
  display: block;
  margin-bottom: 6rpx;
}

.section-subtitle {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.4;
}

.state-card {
  margin-top: 120rpx;
}

.state-title,
.state-desc {
  display: block;
}

.state-title {
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-desc {
  margin: 14rpx 0 24rpx;
  color: var(--wx-text-tertiary);
  font-size: 26rpx;
  line-height: 1.6;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 14rpx;
  min-width: 0;
}

.latest-title-block {
  flex: 1;
  min-width: 0;
}

.latest-title {
  display: block;
  margin-top: 8rpx;
  color: var(--wx-text-primary);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.28;
}

.latest-desc {
  display: block;
  margin: 14rpx 0 24rpx;
  color: var(--wx-text-secondary);
  font-size: 27rpx;
  line-height: 1.45;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.action-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
  height: 142rpx;
  margin: 0;
  border: 1rpx solid var(--wx-border-white-72);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  color: var(--wx-text-primary);
  text-align: left;
  box-shadow: var(--wx-shadow-card);
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  line-height: 1.3;
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.action-card::after {
  border: 0;
}

.action-card-pressed {
  border-color: rgba(var(--wx-brand-500-rgb), 0.28);
  box-shadow: var(--wx-shadow-card-hover);
  transform: translateY(2rpx) scale(0.98);
}

.action-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  flex: 0 0 auto;
}

.action-card-blue {
  background: var(--wx-brand-50);
  border-color: rgba(var(--wx-brand-500-rgb), 0.28);
}

.action-card-lavender {
  background: var(--wx-bg-action-blue);
  border-color: var(--wx-bg-action-blue-border);
}

.action-card-mint {
  background: var(--wx-bg-action-teal);
  border-color: var(--wx-bg-action-teal-border);
}

.action-card-cyan {
  background: var(--wx-bg-action-sky);
  border-color: var(--wx-bg-action-sky-border);
}

.action-card-blue .action-icon-wrap {
  background: var(--wx-brand-100);
}

.action-card-mint .action-icon-wrap {
  background: var(--wx-diagnosis-normal-bg);
}

.action-card-lavender .action-icon-wrap {
  background: var(--wx-bg-action-blue-deep);
}

.action-card-cyan .action-icon-wrap {
  background: var(--wx-bg-action-sky-deep);
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title,
.action-desc {
  display: block;
}

.action-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.22;
}

.action-desc {
  margin-top: 8rpx;
  color: var(--wx-text-tertiary);
  font-size: 23rpx;
  line-height: 1.28;
}

/* -------- Hero 顶部布局升级 -------- */
.hero-top-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  margin-bottom: 24rpx;
}

.hero-top-spacer {
  flex: 1;
}

.hero-user-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.notification-entry {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-glass);
  flex: 0 0 auto;
}

.notification-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-danger);
  color: var(--wx-text-on-primary);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}

/* -------- 健康状态色阶 -------- */
.status-dot-normal {
  background: var(--wx-diagnosis-normal);
}

.status-dot-pending {
  background: var(--wx-status-pending);
}

.status-dot-attention {
  background: var(--wx-status-attention);
}

.status-pill-normal {
  background: var(--wx-diagnosis-normal-bg);
  color: var(--wx-diagnosis-normal);
}

.status-pill-pending {
  background: var(--wx-status-pending-bg);
  color: var(--wx-status-pending);
}

.status-pill-attention {
  background: var(--wx-status-attention-bg);
  color: var(--wx-status-attention);
}

.status-dot-inline-normal {
  background: var(--wx-diagnosis-normal);
  box-shadow: 0 0 0 6rpx var(--wx-diagnosis-normal-bg);
}

.status-dot-inline-pending {
  background: var(--wx-status-pending);
  box-shadow: 0 0 0 6rpx var(--wx-status-pending-bg);
}

.status-dot-inline-attention {
  background: var(--wx-status-attention);
  box-shadow: 0 0 0 6rpx var(--wx-status-attention-bg);
}

/* -------- KPI 指标色阶 -------- */
.metric-item-success {
  border-bottom: 4rpx solid var(--wx-status-done);
}

.metric-item-warning {
  border-bottom: 4rpx solid var(--wx-status-pending);
}

.metric-item-info {
  border-bottom: 4rpx solid var(--wx-brand-500);
}

/* -------- 时间线卡片 -------- */
.timeline-card {
  position: relative;
  padding-left: 52rpx;
}

.timeline-line {
  position: absolute;
  left: 18rpx;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--wx-border-default);
  border-radius: 4rpx;
}

.timeline-dot {
  position: absolute;
  left: 12rpx;
  top: 36rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--wx-brand-500);
  border: 4rpx solid var(--wx-bg-secondary);
  box-sizing: content-box;
}
