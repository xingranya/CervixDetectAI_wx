.section-title {
  margin: 0 0 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #191c1e;
}

.section-kicker {
  display: block;
  color: #717783;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(198, 210, 236, 0.58);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 86rpx;
  border-radius: 16rpx;
  background: rgb(24, 118, 210);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 118, 210, 0.22);
}

.primary-button::after {
  border: 0;
}

.button-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  max-width: 32rpx;
  max-height: 32rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #005dac;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.safe-note {
  margin-top: 18rpx;
  margin-bottom: 0;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #414752;
  font-size: 24rpx;
  line-height: 1.6;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 28rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 18% 0, rgba(212, 227, 255, 0.92), transparent 44%),
    linear-gradient(135deg, #ffffff 0%, #edf3ff 100%);
  border: 1rpx solid rgba(198, 210, 236, 0.72);
  box-shadow: 0 16rpx 38rpx rgba(0, 93, 172, 0.07);
  box-sizing: border-box;
}

.home-brand {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
  margin-bottom: 24rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(24, 67, 126, 0.05);
  box-sizing: border-box;
}

.home-brand-logo {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.home-brand-name {
  display: block;
  color: rgb(24, 118, 210);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.hero-top-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.avatar-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #d4e3ff;
  border: 4rpx solid #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(0, 93, 172, 0.08);
  flex: 0 0 auto;
}

.home-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.hero-top-copy {
  flex: 1;
  min-width: 0;
}

.status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 0;
}

.status-dot {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #94f990;
  border: 4rpx solid #ffffff;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 93, 172, 0.1);
  color: #005dac;
  font-size: 24rpx;
  font-weight: 800;
}

.status-dot-inline {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #14b8a6;
  box-shadow: 0 0 0 6rpx rgba(20, 184, 166, 0.13);
  flex: 0 0 auto;
}

.hero-status {
  color: #717783;
  font-size: 22rpx;
  line-height: 40rpx;
}

.follow-card {
  min-width: 134rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 22rpx rgba(0, 93, 172, 0.05);
}

.follow-label,
.follow-date {
  display: block;
  text-align: center;
}

.follow-label {
  color: #717783;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
}

.follow-date {
  margin-top: 8rpx;
  color: #005dac;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.15;
}

.hero-title {
  display: block;
  margin-top: 26rpx;
  color: #191c1e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
  min-width: 0;
  overflow-wrap: break-word;
  white-space: normal;
}

.hero-time {
  flex: 0 0 auto;
  max-width: 168rpx;
  color: #717783;
  font-size: 21rpx;
  line-height: 1.35;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: #414752;
  font-size: 27rpx;
  line-height: 1.52;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-item {
  min-width: 0;
  padding: 22rpx 8rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(0, 93, 172, 0.04);
}

.metric-value,
.metric-label {
  display: block;
  text-align: center;
}

.metric-value {
  color: #191c1e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.metric-label {
  margin-top: 12rpx;
  color: #717783;
  font-size: 23rpx;
  line-height: 1.25;
}

.guest-entry-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
}

.guest-entry-title,
.guest-entry-desc {
  display: block;
}

.guest-entry-title {
  color: #191c1e;
  font-size: 30rpx;
  font-weight: 900;
}

.guest-entry-desc {
  margin-top: 10rpx;
  color: #414752;
  font-size: 25rpx;
  line-height: 1.6;
}

.guest-entry-button {
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  line-height: normal;
  white-space: nowrap;
}

.guest-entry-button-text {
  display: block;
  font-size: 28rpx;
  line-height: normal;
  white-space: nowrap;
}

.latest-card {
  margin-top: 24rpx;
  margin-bottom: 0;
}

.home-section-head {
  margin: 34rpx 0 18rpx;
}

.home-section-head .section-title {
  display: block;
  margin-bottom: 6rpx;
}

.section-subtitle {
  display: block;
  color: #414752;
  font-size: 26rpx;
  line-height: 1.4;
}

.state-card {
  margin-top: 120rpx;
}

.state-title,
.state-desc {
  display: block;
}

.state-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.state-desc {
  margin: 14rpx 0 24rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 14rpx;
  min-width: 0;
}

.latest-title-block {
  flex: 1;
  min-width: 0;
}

.latest-title {
  display: block;
  margin-top: 8rpx;
  color: #191c1e;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.28;
}

.latest-desc {
  display: block;
  margin: 14rpx 0 24rpx;
  color: #414752;
  font-size: 27rpx;
  line-height: 1.45;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.action-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
  height: 142rpx;
  margin: 0;
  border: 1rpx solid rgba(198, 210, 236, 0.72);
  border-radius: 16rpx;
  background: #ffffff;
  color: #191c1e;
  text-align: left;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  line-height: 1.3;
  transform: translateY(0) scale(1);
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.action-card::after {
  border: 0;
}

.action-card-pressed {
  border-color: rgba(0, 93, 172, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(0, 93, 172, 0.09);
  transform: translateY(2rpx) scale(0.98);
}

.action-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(0, 93, 172, 0.08);
  flex: 0 0 auto;
}

.action-card-blue {
  background: #f7fbff;
  border-color: rgba(92, 141, 255, 0.28);
}

.action-card-lavender {
  background: #f4f7ff;
  border-color: rgba(113, 136, 255, 0.22);
}

.action-card-mint {
  background: #f0fbfa;
  border-color: rgba(42, 187, 169, 0.22);
}

.action-card-cyan {
  background: #f0f9ff;
  border-color: rgba(56, 166, 222, 0.22);
}

.action-card-blue .action-icon-wrap {
  background: #e3edff;
}

.action-card-mint .action-icon-wrap {
  background: #dff8f5;
}

.action-card-lavender .action-icon-wrap {
  background: #e8edff;
}

.action-card-cyan .action-icon-wrap {
  background: #e1f4ff;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title,
.action-desc {
  display: block;
}

.action-title {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.22;
}

.action-desc {
  margin-top: 8rpx;
  color: #526174;
  font-size: 23rpx;
  line-height: 1.28;
}
