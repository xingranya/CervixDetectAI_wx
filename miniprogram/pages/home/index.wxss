.hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 30rpx 30rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(38, 166, 154, 0.2) 0, rgba(38, 166, 154, 0) 190rpx),
    linear-gradient(135deg, #e3f2fd 0%, #f8fafc 54%, #eef4ff 100%);
  box-shadow: 0 20rpx 54rpx rgba(15, 23, 42, 0.1);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #1976d2;
  font-size: 23rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #1e293b;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-desc {
  display: block;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 27rpx;
  line-height: 1.7;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.metric-item {
  padding: 20rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(25, 118, 210, 0.1);
}

.metric-value,
.metric-label {
  display: block;
  text-align: center;
}

.metric-value {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.latest-card {
  margin-top: 28rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.latest-desc {
  display: block;
  margin: 10rpx 0 24rpx;
  color: #64748b;
  font-size: 28rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.action-card {
  height: 148rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1e293b;
  text-align: left;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  line-height: 1.3;
}

.action-card-green {
  border-left: 8rpx solid #1976d2;
}

.action-card-blue {
  border-left: 8rpx solid #2563eb;
}

.action-card-gold {
  border-left: 8rpx solid #26a69a;
}

.action-card-mint {
  border-left: 8rpx solid #31ccec;
}

.action-title,
.action-desc {
  display: block;
}

.action-title {
  font-size: 30rpx;
  font-weight: 800;
}

.action-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 23rpx;
}

.guide-card {
  margin-top: 24rpx;
}

.guide-step {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(25, 118, 210, 0.08);
}

.guide-step:first-of-type {
  border-top: 0;
}

.guide-index {
  flex: 0 0 56rpx;
  color: #1976d2;
  font-size: 24rpx;
  font-weight: 800;
}

.guide-title,
.guide-desc {
  display: block;
}

.guide-title {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
}

.guide-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}
