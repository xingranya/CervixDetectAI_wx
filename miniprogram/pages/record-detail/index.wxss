.detail-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-title {
  display: block;
  color: #1e293b;
  font-size: 40rpx;
  font-weight: 800;
}

.detail-row {
  display: block;
  margin-top: 22rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.delete-button {
  height: 76rpx;
  border: 1rpx solid rgba(211, 47, 47, 0.2);
  border-radius: 16rpx;
  background: #fff;
  color: #d32f2f;
  font-size: 28rpx;
  line-height: 76rpx;
}
