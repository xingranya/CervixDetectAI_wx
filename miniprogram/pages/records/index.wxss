.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(193, 198, 212, 0.62);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
  box-sizing: border-box;
}

.primary-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 16rpx;
  background: rgb(24, 118, 210);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 118, 210, 0.22);
}

.mini-primary {
  white-space: nowrap;
  width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.16);
  border-radius: 999rpx;
  background: rgba(212, 227, 255, 0.72);
  color: #0d47a1;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
  box-shadow: none;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(24, 118, 210, 0.08);
  color: #0d47a1;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.danger {
  background: rgba(186, 26, 26, 0.08);
  color: #ba1a1a;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #0d47a1;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #d4e3ff;
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: #717783;
  font-size: 22rpx;
  font-weight: 800;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #414752;
  font-size: 24rpx;
  line-height: 1.6;
}

.records-trend-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.trend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.trend-title {
  display: block;
  color: #191c1e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.trend-desc {
  display: block;
  margin-top: 8rpx;
  color: #414752;
  font-size: 24rpx;
  line-height: 1.45;
}

.trend-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.trend-metric {
  padding: 24rpx 8rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.1);
  border-radius: 14rpx;
  background: rgba(24, 118, 210, 0.07);
  text-align: center;
}

.trend-metric:nth-child(2) {
  background: rgba(186, 26, 26, 0.06);
}

.trend-metric:nth-child(3) {
  grid-column: 1 / -1;
  padding: 18rpx 8rpx;
}

.trend-value,
.trend-label {
  display: block;
}

.trend-value {
  color: #0d47a1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.trend-label {
  margin-top: 8rpx;
  color: #414752;
  font-size: 22rpx;
}

.record-card {
  display: block;
  width: 100%;
  margin-bottom: 0;
  padding: 22rpx;
  overflow: hidden;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 0 18rpx;
  min-width: 0;
}

.record-title-block {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  color: #191c1e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.record-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  min-width: 0;
}

.record-date,
.record-project,
.record-summary {
  display: block;
  color: #414752;
  font-size: 25rpx;
  line-height: 1.6;
}

.record-date {
  margin-top: 0;
  color: #717783;
  font-size: 22rpx;
  font-weight: 700;
}

.record-project {
  margin-top: 0;
  color: #191c1e;
  font-weight: 800;
  overflow-wrap: break-word;
}

.record-summary {
  margin-top: 8rpx;
  overflow-wrap: break-word;
}

.record-summary-box {
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(247, 249, 251, 0.92);
  border: 1rpx solid rgba(230, 232, 234, 0.9);
}

.record-actions {
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
  margin-top: 0;
  padding: 18rpx 0 0;
  min-width: 0;
}

.text-button {
  flex: 0 1 176rpx;
  min-width: 0;
  white-space: nowrap;
  margin-right: 0;
}

.records-list {
  position: relative;
  margin-top: 4rpx;
}

.timeline-item {
  display: block;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.slide-cell {
  min-width: 0;
  width: 100%;
  overflow: hidden;
}

.record-slideview {
  width: 100% !important;
  max-width: 100% !important;
  overflow: hidden;
}

.weui-search {
  margin: -2rpx 0 20rpx;
  padding: 0 !important;
  border: 1rpx solid rgba(199, 210, 232, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92) !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(24, 118, 210, 0.05);
}

.weui-search .weui-search-bar {
  padding: 10rpx 12rpx !important;
  background: transparent !important;
}

.weui-search .weui-search-bar__form {
  border-radius: 16rpx !important;
  background: #ffffff !important;
}

.pill-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 38%;
}

.pill-wrap .pill {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
