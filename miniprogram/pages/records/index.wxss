.skeleton-container {
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

.primary-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: var(--wx-radius-sm);
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.22);
}

.mini-primary {
  white-space: nowrap;
  width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.16);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-brand-100);
  color: var(--wx-brand-700);
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
  box-shadow: none;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--wx-radius-pill);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.danger {
  background: var(--wx-danger-light);
  color: var(--wx-danger);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-brand-100);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--wx-brand-200);
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  font-weight: 800;
}

.loading-more {
  padding: 32rpx 0;
  text-align: center;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--wx-text-muted);
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--wx-bg-glass-light);
  border: 1rpx solid var(--wx-border-light);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.records-trend-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.trend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.trend-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.trend-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.trend-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.trend-metric {
  padding: 24rpx 8rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.1);
  border-radius: 14rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.07);
  text-align: center;
}

.trend-metric:nth-child(2) {
  background: var(--wx-bg-danger-light);
}

.trend-metric:nth-child(3) {
  grid-column: 1 / -1;
  padding: 18rpx 8rpx;
}

.trend-value,
.trend-label {
  display: block;
}

.trend-value {
  color: var(--wx-brand-700);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.trend-label {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 22rpx;
}

.record-card {
  display: block;
  width: 100%;
  margin-bottom: 0;
  padding: 22rpx;
  overflow: hidden;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 0 18rpx;
  min-width: 0;
}

.record-title-block {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.record-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  min-width: 0;
}

.record-date,
.record-project,
.record-summary {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.record-date {
  margin-top: 0;
  color: var(--wx-brand-700);
  font-size: 23rpx;
  font-weight: 900;
}

.record-project {
  margin-top: 0;
  color: var(--wx-text-primary);
  font-weight: 800;
  overflow-wrap: break-word;
}

.record-summary {
  margin-top: 8rpx;
  overflow-wrap: break-word;
}

.record-summary-box {
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(247, 249, 251, 0.92);
  border: 1rpx solid rgba(230, 232, 234, 0.9);
}

.record-actions {
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
  margin-top: 0;
  padding: 18rpx 0 0;
  min-width: 0;
}

.text-button {
  flex: 0 1 176rpx;
  min-width: 0;
  white-space: nowrap;
  margin-right: 0;
}

.records-list {
  position: relative;
  margin-top: 4rpx;
}

.timeline-item {
  display: block;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.slide-cell {
  min-width: 0;
  width: 100%;
  overflow: hidden;
}

.weui-search {
  margin: -2rpx 0 20rpx;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-card-92) !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.05);
}

.weui-search .weui-search-bar {
  padding: 10rpx 12rpx !important;
  background: transparent !important;
}

.weui-search .weui-search-bar__form {
  border-radius: 16rpx !important;
  background: var(--wx-bg-primary) !important;
}

.pill-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 38%;
}

.pill-wrap .pill {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- Filter Tabs ---- */
.filter-tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.14);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-card);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all var(--wx-motion-fast);
}

.filter-tab::after {
  border: 0;
}

.filter-tab-active {
  border-color: rgba(var(--wx-brand-500-rgb), 0.24);
  background: rgba(var(--wx-brand-500-rgb), 0.10);
  color: var(--wx-brand-700);
  font-weight: 800;
}

.filter-tab-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.12);
  color: var(--wx-brand-700);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}
