<custom-nav-bar title="检查记录" />
<scroll-view type="list" scroll-y style="height: 100vh;" enhanced="{{true}}" refresher-enabled="{{true}}" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{refreshing}}">
<view class="page records-page">
  <section-header title="检查记录" weui-icon="note">
    <t-button slot="extra" theme="primary" size="small" icon="add" bind:tap="createRecord">新增</t-button>
  </section-header>

  <view class="card records-trend-card">
    <view class="trend-head">
      <view>
        <text class="trend-title">全部记录</text>
        <text class="trend-desc">查看您的健康筛查历史</text>
      </view>
      <view class="icon-chip">
        <image class="icon-chip-image" src="/assets/icons/records-active.png" mode="aspectFit" />
      </view>
    </view>
    <view class="trend-metrics">
      <view class="trend-metric">
        <text class="trend-value">{{summary.total}}</text>
        <text class="trend-label">全部记录</text>
      </view>
      <view class="trend-metric">
        <text class="trend-value">{{summary.pending}}</text>
        <text class="trend-label">待关注</text>
      </view>
      <view class="trend-metric">
        <text class="trend-value">{{summary.latestDate}}</text>
        <text class="trend-label">最近日期</text>
      </view>
    </view>
  </view>

  <t-search
    wx:if="{{allRecords.length}}"
    placeholder="搜索标题、项目或日期"
    value="{{searchKeyword}}"
    bind:change="onSearchChange"
    bind:clear="onSearchClear"
    bind:submit="onSearchSubmit"
  />

  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <t-skeleton row-col="{{[{size: '32rpx', type: 'rect'},{size: '24rpx', type: 'rect', width: '80%'},[{width: '60%'},{width: '30%'}],[{size: '24rpx', type: 'rect', width: '40%'}]]}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载检查记录</text>
    <text class="state-desc">{{errorMessage}}</text>
    <t-button theme="primary" size="large" block bind:tap="loadRecords">重新加载</t-button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="{{isGuest ? '体验模式下不展示个人记录' : '还没有检查记录'}}"
    desc="{{isGuest ? '你可以先浏览首页、知识内容和服务说明；需要保存自己的检查摘要时，再自行登录。' : '可以先添加一次检查摘要，后续复查时更方便查看。'}}"
    weui-icon="add"
    button-text="{{isGuest ? '前往登录' : '添加第一条记录'}}"
    bind:action="createRecord"
  />

  <empty-state
    wx:elif="{{searchEmpty}}"
    title="未找到匹配记录"
    desc="换个标题、项目或日期关键词再试试。"
    weui-icon="search"
  />

  <block wx:else>
    <view class="records-list">
      <view wx:for="{{records}}" wx:key="id" class="timeline-item">
        <view class="slide-cell">
          <view class="card record-card" bind:tap="openDetail" data-id="{{item.id}}">
            <view class="record-top">
              <view class="record-title-block">
                <text class="record-title">{{item.title}}</text>
                <view class="record-meta-row">
                  <text class="record-date">{{item.dateText}}</text>
                </view>
              </view>
              <view class="pill-wrap">
                <t-tag theme="primary" variant="light" size="small">{{item.status}}</t-tag>
              </view>
            </view>
            <view class="record-summary-box">
              <text class="record-project">{{item.project}}</text>
              <text class="record-summary">{{item.summary}}</text>
            </view>
            <view class="record-actions">
              <t-button variant="text" size="small" icon="file" catch:tap="editRecord" data-id="{{item.id}}">编辑</t-button>
              <t-button variant="text" theme="danger" size="small" icon="delete" catch:tap="deleteRecord" data-id="{{item.id}}">删除</t-button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <t-notice-bar theme="info" content="记录内容用于个人健康管理和复查准备，不作为诊断、治疗或紧急医疗建议。" />
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="{{confirmDialog.title}}"
    content="{{confirmDialog.content}}"
    confirm-text="删除"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmDeleteRecord"
  />
</view>
</scroll-view>
