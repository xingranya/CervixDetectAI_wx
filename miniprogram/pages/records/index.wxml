<view class="page records-page">
  <section-header title="检查记录" weui-icon="record">
    <button slot="extra" class="mini-primary" hover-class="u-hover" bind:tap="createRecord" aria-role="button" aria-label="新增检查记录">
      <view class="button-content">
        <image class="action-inline-icon" src="/assets/icons/plus-active.png" mode="aspectFit" />
        <text class="button-text">新增</text>
      </view>
    </button>
  </section-header>

  <view class="card records-trend-card">
    <view class="trend-head">
      <view>
        <text class="trend-title">全部记录</text>
        <text class="trend-desc">查看您的健康筛查历史</text>
      </view>
      <view class="icon-chip">
        <image class="icon-chip-image" src="/assets/icons/records-active.png" mode="aspectFit" />
      </view>
    </view>
    <view class="trend-metrics">
      <view class="trend-metric">
        <text class="trend-value">{{summary.total}}</text>
        <text class="trend-label">全部记录</text>
      </view>
      <view class="trend-metric">
        <text class="trend-value">{{summary.pending}}</text>
        <text class="trend-label">待关注</text>
      </view>
      <view class="trend-metric">
        <text class="trend-value">{{summary.latestDate}}</text>
        <text class="trend-label">最近日期</text>
      </view>
    </view>
  </view>

  <t-search
    wx:if="{{allRecords.length}}"
    class="records-search"
    placeholder="搜索标题、项目或日期"
    value="{{searchKeyword}}"
    bind:change="onSearchInput"
    bind:clear="onSearchClear"
  />

  <view wx:if="{{allRecords.length}}" class="filter-tab-row">
    <button wx:for="{{filterTabs}}" wx:key="value" class="filter-tab {{item.active ? 'filter-tab-active' : ''}}" hover-class="u-hover" data-value="{{item.value}}" bind:tap="onFilterChange">
      <text>{{item.label}}</text>
      <text wx:if="{{item.count > 0}}" class="filter-tab-count">{{item.count}}</text>
    </button>
  </view>

  <view wx:if="{{pageStatus === 'loading'}}" class="skeleton-container">
    <skeleton mode="list" rows="{{4}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载检查记录</text>
    <text class="state-desc">{{errorMessage}}</text>
    <button class="primary-button" hover-class="u-hover" bind:tap="loadRecords">
      <text class="button-text">重新加载</text>
    </button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="{{isGuest ? '体验模式下不展示个人记录' : '还没有检查记录'}}"
    desc="{{isGuest ? '你可以先浏览首页、知识内容和服务说明；需要保存自己的检查摘要时，再自行登录。' : '可以先添加一次检查摘要，后续复查时更方便查看。'}}"
    weui-icon="add"
    button-text="{{isGuest ? '前往登录' : '添加第一条记录'}}"
    bind:action="createRecord"
  />

  <empty-state
    wx:elif="{{searchEmpty}}"
    title="未找到匹配记录"
    desc="换个标题、项目或日期关键词再试试。"
    weui-icon="search"
  />

  <block wx:else>
    <view class="records-list" aria-role="list">
      <view wx:for="{{records}}" wx:key="id" class="timeline-item" aria-role="listitem">
        <view class="slide-cell">
          <view class="card record-card" hover-class="u-hover" bind:tap="openDetail" data-id="{{item.id}}" aria-label="{{item.title}}，{{item.dateText}}，{{item.status}}">
            <view class="record-top">
              <view class="record-title-block">
                <text class="record-title">{{item.title}}</text>
                <view class="record-meta-row">
                  <text class="record-date">{{item.dateText}}</text>
                </view>
              </view>
              <view class="pill-wrap">
                <text class="pill">{{item.status}}</text>
                <t-badge wx:if="{{item.status.indexOf('待') > -1 || item.status.indexOf('复查') > -1}}" dot="{{true}}" />
              </view>
            </view>
            <view class="record-summary-box">
              <text class="record-project">{{item.project}}</text>
              <text class="record-summary">{{item.summary}}</text>
            </view>
            <view class="record-actions">
              <button class="text-button" hover-class="u-hover" catch:tap="editRecord" data-id="{{item.id}}" aria-role="button" aria-label="编辑">
                <view class="button-content">
                  <image class="action-inline-icon" src="/assets/icons/detail-active.png" mode="aspectFit" />
                  <text class="button-text">编辑</text>
                </view>
              </button>
              <button class="text-button danger" hover-class="u-hover" catch:tap="deleteRecord" data-id="{{item.id}}" aria-role="button" aria-label="删除">
                <view class="button-content">
                  <image class="action-inline-icon" src="/assets/icons/trash-danger.png" mode="aspectFit" />
                  <text class="button-text">删除</text>
                </view>
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{loadingMore}}" class="loading-more">
    <text class="loading-more-text">加载中...</text>
  </view>
  <view wx:elif="{{!hasMore && allRecords.length > 0}}" class="loading-more">
    <text class="loading-more-text">没有更多了</text>
  </view>

  <view class="safe-note">记录内容用于个人健康管理和复查准备，不作为诊断、治疗或紧急医疗建议。</view>
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="{{confirmDialog.title}}"
    content="{{confirmDialog.content}}"
    confirm-text="删除"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmDeleteRecord"
  />
  <view class="u-back-to-top {{showBackToTop ? '' : 'u-back-to-top-hidden'}}" bind:tap="scrollToTop" aria-role="button" aria-label="回到顶部">
    <t-icon name="chevron-right" color="rgb(24, 118, 210)" size="40rpx" />
  </view>
</view>
