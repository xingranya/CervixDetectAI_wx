<custom-nav-bar title="复查提醒" />
<scroll-view type="list" scroll-y style="height: 100vh;" enhanced="{{true}}" refresher-enabled="{{true}}" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{refreshing}}">
<view class="page reminders-page">
  <section-header title="复查提醒" icon="/assets/icons/reminders-active.png">
    <t-button slot="extra" theme="primary" size="small" icon="add" bind:tap="createReminder">新增</t-button>
  </section-header>

  <view class="card reminder-summary-card">
    <view class="reminder-summary-head">
      <view>
        <text class="section-kicker">提醒概览</text>
        <text class="reminder-summary-title">{{summary.title}}</text>
      </view>
      <view class="icon-chip">
        <image class="icon-chip-image" src="/assets/icons/check-active.png" mode="aspectFit" />
      </view>
    </view>
    <view class="reminder-summary-grid">
      <view class="summary-cell">
        <text class="summary-value">{{summary.pending}}</text>
        <text class="summary-label">待处理</text>
      </view>
      <view class="summary-cell">
        <text class="summary-value">{{summary.total}}</text>
        <text class="summary-label">全部提醒</text>
      </view>
      <view class="summary-cell">
        <text class="summary-value">{{summary.nextDate}}</text>
        <text class="summary-label">下一项</text>
      </view>
    </view>
  </view>

  <t-search
    wx:if="{{allReminders.length}}"
    placeholder="搜索提醒标题、内容或日期"
    value="{{searchKeyword}}"
    bind:change="onSearchChange"
    bind:clear="onSearchClear"
  />

  <view wx:if="{{pageStatus === 'loading'}}" class="card state-card">
    <t-skeleton row-col="{{[{size: '32rpx', type: 'rect'},{size: '24rpx', type: 'rect', width: '80%'},[{width: '40%'},{width: '30%'},{width: '20%'}]]}}" />
  </view>

  <view wx:elif="{{pageStatus === 'error'}}" class="card state-card">
    <text class="state-title">暂时无法加载复查提醒</text>
    <text class="state-desc">{{errorMessage}}</text>
    <t-button theme="primary" size="large" block bind:tap="loadReminders">重新加载</t-button>
  </view>

  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="{{isGuest ? '体验模式下不展示个人提醒' : '还没有提醒'}}"
    desc="{{isGuest ? '你可以先浏览提醒页布局和说明；需要保存自己的复查计划时，再自行登录。' : '添加复查或资料准备提醒，把后续安排放进计划里。'}}"
    weui-icon="time"
    button-text="{{isGuest ? '前往登录' : '添加提醒'}}"
    bind:action="createReminder"
  />

  <empty-state
    wx:elif="{{searchEmpty}}"
    title="未找到匹配提醒"
    desc="换个标题、内容或日期关键词再试试。"
    weui-icon="search"
  />

  <block wx:else>
    <view wx:for="{{reminders}}" wx:key="id" class="reminder-slide-cell">
      <view class="card reminder-card {{item.done ? 'reminder-done' : ''}}">
        <view class="reminder-top">
          <view class="date-tile">
            <text class="date-month">{{item.dateMonthDay}}</text>
            <text class="date-year">{{item.dateYear}}</text>
          </view>
          <view class="reminder-main">
            <text class="reminder-title">{{item.title}}</text>
          </view>
          <view class="pill-wrap">
            <t-tag theme="{{item.done ? 'default' : 'primary'}}" variant="light" size="small">{{item.statusText}}</t-tag>
          </view>
        </view>
        <text class="reminder-desc">{{item.desc}}</text>
        <view class="reminder-actions">
          <t-button
            wx:if="{{item.canNotify}}"
            theme="primary"
            size="small"
            loading="{{sendingReminderId === item.id}}"
            disabled="{{sendingReminderId !== ''}}"
            bind:tap="subscribeReminder"
            data-id="{{item.id}}"
          >{{sendingReminderId === item.id ? '发送中' : '微信提醒'}}</t-button>
          <t-button wx:if="{{!item.done}}" variant="outline" size="small" icon="info-circle" bind:tap="markDone" data-id="{{item.id}}">标记完成</t-button>
          <t-button variant="text" size="small" icon="file" bind:tap="editReminder" data-id="{{item.id}}">编辑</t-button>
          <t-button variant="text" theme="danger" size="small" icon="delete" bind:tap="deleteReminder" data-id="{{item.id}}">删除</t-button>
        </view>
      </view>
    </view>
  </block>
  <weui-confirm
    show="{{confirmDialog.show}}"
    title="{{confirmDialog.title}}"
    content="{{confirmDialog.content}}"
    confirm-text="删除"
    confirm-warn="{{true}}"
    bind:cancel="closeConfirmDialog"
    bind:confirm="confirmDeleteReminder"
  />
</view>
</scroll-view>
