.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.ghost-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.ghost-button {
  white-space: nowrap;
  height: 76rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #1f53c9;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.mini-primary {
  white-space: nowrap;
  min-width: 132rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #1f53c9;
  color: #fff;
  font-size: 26rpx;
  line-height: normal;
  font-weight: 700;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.ghost-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.danger {
  background: rgba(186, 26, 26, 0.08);
  color: #ba1a1a;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: #66748a;
  font-size: 22rpx;
  font-weight: 800;
}

.reminder-summary-card {
  margin-bottom: 28rpx;
}

.reminder-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reminder-summary-title {
  display: block;
  margin-top: 8rpx;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.reminder-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.summary-cell {
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(239, 244, 255, 0.72);
  text-align: center;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: #0b1c30;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
}

.reminder-done {
  opacity: 0.72;
}

.reminder-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.reminder-date {
  display: block;
  color: #425d96;
  font-size: 26rpx;
  font-weight: 800;
}

.reminder-title {
  display: block;
  margin-top: 12rpx;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
}

.reminder-desc {
  display: block;
  margin: 12rpx 0 24rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.65;
}

.reminder-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.small-button,
.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: normal;
}

.text-button {
  white-space: nowrap;
  margin: 0;
}
