.reminder-summary-card {
  margin-bottom: 28rpx;
}

.reminder-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reminder-summary-title {
  display: block;
  margin-top: 8rpx;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.reminder-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.summary-cell {
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(239, 244, 255, 0.72);
  text-align: center;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: #0b1c30;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
}

.reminder-done {
  opacity: 0.72;
}

.reminder-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.reminder-date {
  display: block;
  color: #425d96;
  font-size: 26rpx;
  font-weight: 800;
}

.reminder-title {
  display: block;
  margin-top: 12rpx;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
}

.reminder-desc {
  display: block;
  margin: 12rpx 0 24rpx;
  color: #66748a;
  font-size: 27rpx;
  line-height: 1.65;
}

.reminder-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.small-button,
.text-button {
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 58rpx;
}

.text-button {
  margin: 0;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin: 16rpx 0 24rpx;
  color: #66748a;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-icon {
  margin-bottom: 20rpx;
}
