.skeleton-container {
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--wx-border-default);
  border-radius: var(--wx-radius-sm);
  background: var(--wx-bg-primary);
  box-shadow: var(--wx-shadow-card);
  box-sizing: border-box;
}

.primary-button,
.ghost-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 88rpx;
  border-radius: var(--wx-radius-sm);
  background: var(--wx-brand-500);
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(var(--wx-brand-500-rgb), 0.22);
}

.ghost-button {
  white-space: nowrap;
  height: 76rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.18);
  border-radius: 16rpx;
  background: var(--wx-bg-glass-light);
  color: var(--wx-brand-700);
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.mini-primary {
  white-space: nowrap;
  width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.16);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-brand-100);
  color: var(--wx-brand-700);
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
  box-shadow: none;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--wx-radius-pill);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.action-inline-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.primary-button::after,
.ghost-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.danger {
  background: var(--wx-danger-light);
  color: var(--wx-danger);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-brand-100);
  color: var(--wx-brand-700);
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--wx-brand-200);
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: var(--wx-text-secondary);
  font-size: 22rpx;
  font-weight: 800;
}

.reminder-summary-card {
  margin-bottom: 24rpx;
}

.reminder-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reminder-summary-title {
  display: block;
  margin-top: 10rpx;
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.reminder-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.summary-cell {
  padding: 20rpx 8rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.1);
  border-radius: 14rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.07);
  text-align: center;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: var(--wx-brand-700);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.summary-label {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 22rpx;
}

.reminder-done {
  opacity: 0.72;
}

.reminder-card {
  width: 100%;
  padding: 22rpx;
  overflow: hidden;
}

.reminder-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 0 18rpx;
  min-width: 0;
}

.date-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 92rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.14);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #eaf3ff 0%, #dbeaff 100%);
  color: var(--wx-brand-700);
  flex: 0 0 auto;
}

.date-month,
.date-year {
  display: block;
  line-height: 1;
}

.date-month {
  font-size: 29rpx;
  font-weight: 900;
}

.date-year {
  margin-top: 8rpx;
  color: var(--wx-text-secondary);
  font-size: 20rpx;
  font-weight: 800;
}

.reminder-main {
  min-width: 0;
  flex: 1;
}

.reminder-date {
  display: block;
  color: var(--wx-text-brand-muted);
  font-size: 23rpx;
  font-weight: 800;
}

.reminder-title {
  display: block;
  margin-top: 0;
  color: var(--wx-text-primary);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.32;
  overflow-wrap: break-word;
}

.reminder-desc {
  display: block;
  margin: 0;
  padding: 22rpx;
  border: 1rpx solid rgba(230, 232, 234, 0.9);
  border-radius: 16rpx;
  background: rgba(247, 249, 251, 0.92);
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  box-sizing: border-box;
  overflow-wrap: break-word;
}

.reminder-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding: 18rpx 0 0;
  min-width: 0;
  width: 100%;
  overflow: visible;
  box-sizing: border-box;
}

.notify-button {
  grid-column: 1 / -1;
  width: 100%;
  height: 58rpx;
  min-width: 0;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--wx-radius-pill);
  background: var(--wx-brand-500);
  font-size: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(var(--wx-brand-500-rgb), 0.18);
}

.notify-button-disabled {
  background: var(--wx-brand-ghost-bg);
  color: var(--wx-text-on-primary);
}

.small-button,
.text-button {
  white-space: nowrap;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: normal;
}

.small-button {
  border-color: rgba(var(--wx-brand-500-rgb), 0.16);
  background: rgba(var(--wx-brand-500-rgb), 0.08);
  color: var(--wx-brand-700);
  font-weight: 700;
}

.reminder-slide-cell {
  width: 100%;
  min-width: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.weui-search {
  margin: -2rpx 0 24rpx;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-subtle);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-card-92) !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.05);
}

.weui-search .weui-search-bar {
  padding: 10rpx 12rpx !important;
  background: transparent !important;
}

.weui-search .weui-search-bar__form {
  border-radius: 16rpx !important;
  background: var(--wx-bg-primary) !important;
}

.pill-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 34%;
}

.pill-wrap .pill {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- Filter Tabs ---- */
.filter-tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(var(--wx-brand-500-rgb), 0.14);
  border-radius: var(--wx-radius-pill);
  background: var(--wx-bg-card);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all var(--wx-motion-fast);
}

.filter-tab::after {
  border: 0;
}

.filter-tab-active {
  border-color: rgba(var(--wx-brand-500-rgb), 0.24);
  background: rgba(var(--wx-brand-500-rgb), 0.10);
  color: var(--wx-brand-700);
  font-weight: 800;
}

.filter-tab-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.12);
  color: var(--wx-brand-700);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

/* ---- Type Badge ---- */
.reminder-type-badge {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--wx-radius-pill);
  font-size: 20rpx;
  font-weight: 700;
}

.type-primary {
  background: rgba(var(--wx-brand-500-rgb), 0.10);
  color: var(--wx-brand-700);
}

.type-info {
  background: var(--wx-bg-tertiary);
  color: var(--wx-text-secondary);
}

.type-warning {
  background: var(--wx-warning-light);
  color: var(--wx-text-warning-deep);
}

.type-success {
  background: var(--wx-success-light);
  color: var(--wx-text-success-deep);
}

.loading-more {
  padding: 32rpx 0;
  text-align: center;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--wx-text-muted);
}
