.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(193, 198, 212, 0.62);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 93, 172, 0.04);
  box-sizing: border-box;
}

.primary-button,
.ghost-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 16rpx;
  background: rgb(24, 118, 210);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(24, 118, 210, 0.22);
}

.ghost-button {
  white-space: nowrap;
  height: 76rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.18);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #0d47a1;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.mini-primary {
  white-space: nowrap;
  width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.16);
  border-radius: 999rpx;
  background: rgba(212, 227, 255, 0.72);
  color: #0d47a1;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
  box-shadow: none;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(24, 118, 210, 0.08);
  color: #0d47a1;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.ghost-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.danger {
  background: rgba(186, 26, 26, 0.08);
  color: #ba1a1a;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(212, 227, 255, 0.72);
  color: #0d47a1;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #d4e3ff;
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: #4d5d73;
  font-size: 22rpx;
  font-weight: 800;
}

.reminder-summary-card {
  margin-bottom: 24rpx;
}

.reminder-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reminder-summary-title {
  display: block;
  margin-top: 10rpx;
  color: #191c1e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.reminder-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.summary-cell {
  padding: 20rpx 8rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.1);
  border-radius: 14rpx;
  background: rgba(24, 118, 210, 0.07);
  text-align: center;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: #0d47a1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.15;
}

.summary-label {
  margin-top: 8rpx;
  color: #414752;
  font-size: 22rpx;
}

.reminder-done {
  opacity: 0.72;
}

.reminder-card {
  width: 100%;
  padding: 22rpx;
  overflow: hidden;
}

.reminder-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 0 18rpx;
  min-width: 0;
}

.date-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 92rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.14);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #eaf3ff 0%, #dbeaff 100%);
  color: #0d47a1;
  flex: 0 0 auto;
}

.date-month,
.date-year {
  display: block;
  line-height: 1;
}

.date-month {
  font-size: 29rpx;
  font-weight: 900;
}

.date-year {
  margin-top: 8rpx;
  color: #3e4a5f;
  font-size: 20rpx;
  font-weight: 800;
}

.reminder-main {
  min-width: 0;
  flex: 1;
}

.reminder-date {
  display: block;
  color: #425d96;
  font-size: 23rpx;
  font-weight: 800;
}

.reminder-title {
  display: block;
  margin-top: 0;
  color: #191c1e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.32;
  overflow-wrap: break-word;
}

.reminder-desc {
  display: block;
  margin: 0;
  padding: 22rpx;
  border: 1rpx solid rgba(230, 232, 234, 0.9);
  border-radius: 16rpx;
  background: rgba(247, 249, 251, 0.92);
  color: #414752;
  font-size: 26rpx;
  line-height: 1.65;
  box-sizing: border-box;
  overflow-wrap: break-word;
}

.reminder-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 18rpx 0 0;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.notify-button {
  flex: 0 0 360rpx;
  width: 360rpx;
  max-width: 100%;
  height: 58rpx;
  min-width: 0;
  margin: 0 auto;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgb(24, 118, 210);
  font-size: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(24, 118, 210, 0.18);
}

.notify-button-disabled {
  background: #8fa5e8;
  color: rgba(255, 255, 255, 0.92);
}

.small-button,
.text-button {
  flex: 1 1 0;
  white-space: nowrap;
  width: 0;
  min-width: 0;
  max-width: 100%;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: normal;
}

.small-button {
  border-color: rgba(24, 118, 210, 0.16);
  background: rgba(24, 118, 210, 0.08);
  color: #0d47a1;
  font-weight: 700;
}

.reminder-slide-cell {
  width: 100%;
  min-width: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.weui-search {
  margin: -2rpx 0 24rpx;
  padding: 0 !important;
  border: 1rpx solid rgba(199, 210, 232, 0.66);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92) !important;
  overflow: hidden;
  box-shadow: 0 10rpx 26rpx rgba(24, 118, 210, 0.05);
}

.weui-search .weui-search-bar {
  padding: 10rpx 12rpx !important;
  background: transparent !important;
}

.weui-search .weui-search-bar__form {
  border-radius: 16rpx !important;
  background: #ffffff !important;
}

.pill-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 34%;
}

.pill-wrap .pill {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
