.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.ghost-button,
.text-button,
.mini-primary {
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  white-space: nowrap;
  height: 86rpx;
  border-radius: 18rpx;
  background: #1f53c9;
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.ghost-button {
  white-space: nowrap;
  height: 76rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #1f53c9;
  font-size: 28rpx;
  line-height: normal;
  font-weight: 700;
}

.mini-primary {
  white-space: nowrap;
  width: 128rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.16);
  border-radius: 18rpx;
  background: rgba(219, 225, 255, 0.64);
  color: #1f53c9;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 800;
  box-shadow: none;
}

.text-button {
  white-space: nowrap;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.08);
  color: #1f53c9;
  font-size: 24rpx;
  line-height: normal;
  font-weight: 700;
}

.primary-button::after,
.ghost-button::after,
.mini-primary::after,
.text-button::after {
  border: 0;
}

.small-icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.danger {
  background: rgba(186, 26, 26, 0.08);
  color: #ba1a1a;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(219, 225, 255, 0.72);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.icon-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(219, 225, 255, 0.56);
  flex: 0 0 auto;
}

.icon-chip-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.section-kicker {
  display: block;
  color: #66748a;
  font-size: 22rpx;
  font-weight: 800;
}

.reminder-summary-card {
  margin-bottom: 28rpx;
}

.reminder-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.reminder-summary-title {
  display: block;
  margin-top: 8rpx;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.reminder-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.summary-cell {
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(239, 244, 255, 0.72);
  text-align: center;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: #0b1c30;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 8rpx;
  color: #66748a;
  font-size: 22rpx;
}

.reminder-done {
  opacity: 0.72;
}

.reminder-card {
  padding: 28rpx;
}

.reminder-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.date-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 94rpx;
  border: 1rpx solid rgba(31, 83, 201, 0.14);
  border-radius: 22rpx;
  background: rgba(232, 238, 255, 0.9);
  color: #1f53c9;
  flex: 0 0 auto;
}

.date-month,
.date-year {
  display: block;
  line-height: 1;
}

.date-month {
  font-size: 30rpx;
  font-weight: 900;
}

.date-year {
  margin-top: 8rpx;
  color: #5c6f96;
  font-size: 20rpx;
  font-weight: 800;
}

.reminder-main {
  min-width: 0;
  flex: 1;
}

.reminder-date {
  display: block;
  color: #425d96;
  font-size: 23rpx;
  font-weight: 800;
}

.reminder-title {
  display: block;
  margin-top: 8rpx;
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.32;
}

.reminder-desc {
  display: block;
  margin: 22rpx 0 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(239, 244, 255, 0.72);
  color: #31445f;
  font-size: 26rpx;
  line-height: 1.65;
}

.reminder-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.notify-button {
  height: 68rpx;
  grid-column: span 2;
  min-width: 0;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #1f53c9;
  font-size: 26rpx;
  box-shadow: 0 12rpx 24rpx rgba(31, 83, 201, 0.18);
}

.notify-button-disabled {
  background: #8fa5e8;
  color: rgba(255, 255, 255, 0.92);
}

.small-button,
.text-button {
  white-space: nowrap;
  height: 62rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: normal;
}

.text-button {
  white-space: nowrap;
  margin: 0;
}
