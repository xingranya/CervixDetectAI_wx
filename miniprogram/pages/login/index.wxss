.login-page {
  padding-top: 48rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 86rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
  white-space: nowrap;
}

.primary-button::after,
.plain-link::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.button-text,
.plain-link-text {
  display: block;
  min-width: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #3e4a5f;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-weui-cells {
  margin: 0 !important;
  background: transparent !important;
}

.login-hero {
  padding: 22rpx 8rpx 34rpx;
  text-align: left;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(24, 67, 126, 0.06);
  box-sizing: border-box;
}

.login-mark-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(24, 118, 210, 0.06);
  flex: 0 0 auto;
}

.login-mark {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.eyebrow {
  display: block;
  color: rgb(24, 118, 210);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.login-title {
  display: block;
  margin-top: 30rpx;
  color: #0b1c30;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 20rpx;
  color: #3e4a5f;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-card {
  padding: 34rpx;
}

.login-form {
  display: block;
}

.avatar-tip {
  display: block;
  margin-bottom: 24rpx;
  color: #3e4a5f;
  font-size: 24rpx;
  text-align: center;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-placeholder {
  color: #4d5d73;
}

.login-button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-top: 28rpx;
}

.login-button[disabled] {
  background: linear-gradient(135deg, #a8b8e6 0%, #c6d2f0 100%);
  color: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.agreement-panel {
  margin-top: 10rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.72);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
}

.agreement-title,
.agreement-links,
.agreement-note {
  display: block;
}

.agreement-title {
  color: #10233c;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
}

.agreement-links {
  margin-top: 12rpx;
  line-height: 1.7;
}

.agreement-link,
.agreement-separator {
  font-size: 25rpx;
}

.agreement-link {
  color: #1f53c9;
  font-weight: 800;
}

.agreement-separator {
  margin: 0 8rpx;
  color: #4d5d73;
}

.agreement-note {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}
