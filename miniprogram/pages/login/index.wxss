.login-page {
  padding-top: 48rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 86rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
  white-space: nowrap;
}

.primary-button::after,
.plain-link::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.button-text,
.plain-link-text {
  display: block;
  min-width: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.form-weui-cells {
  margin: 0 !important;
  background: transparent !important;
}

.login-hero {
  padding: 28rpx 8rpx 36rpx;
  text-align: left;
}

.login-mark-wrap {
  display: block;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: rgba(219, 225, 255, 0.7);
  box-shadow: 0 16rpx 36rpx rgba(31, 83, 201, 0.12);
}

.login-mark {
  width: 62rpx;
  height: 62rpx;
  margin: 21rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.1);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.login-title {
  display: block;
  margin-top: 28rpx;
  color: #0b1c30;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 20rpx;
  color: #66748a;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-card {
  padding: 34rpx;
}

.login-form {
  display: block;
}

.avatar-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 152rpx !important;
  min-width: 152rpx !important;
  max-width: 152rpx !important;
  height: 152rpx !important;
  min-height: 152rpx !important;
  max-height: 152rpx !important;
  margin: 0 auto 12rpx !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 50% !important;
  background: transparent !important;
  overflow: visible;
  line-height: 1 !important;
  box-shadow: none;
  box-sizing: border-box;
}

.avatar-button::after {
  display: none;
  border: 0;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border: 1rpx solid rgba(64, 109, 228, 0.16);
  border-radius: 50%;
  background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
  overflow: hidden;
  box-shadow: 0 12rpx 26rpx rgba(31, 83, 201, 0.08);
  box-sizing: border-box;
}

.avatar-image,
.avatar-placeholder {
  display: block;
  width: 134rpx;
  height: 134rpx;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
}

.avatar-placeholder {
  position: relative;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(64, 109, 228, 0.18);
}

.flat-avatar-head {
  position: absolute;
  top: 32rpx;
  left: 50%;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  border: 5rpx solid #6f8fe8;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.flat-avatar-body {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  width: 66rpx;
  height: 34rpx;
  margin-left: -33rpx;
  border: 5rpx solid #6f8fe8;
  border-bottom: 0;
  border-radius: 42rpx 42rpx 0 0;
  box-sizing: border-box;
}

.avatar-tip {
  display: block;
  margin-bottom: 24rpx;
  color: #66748a;
  font-size: 24rpx;
  text-align: center;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-top: 28rpx;
}

.plain-link {
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  margin-top: 20rpx;
  padding: 0 24rpx;
  background: transparent;
  color: #1f53c9;
  font-size: 26rpx;
  line-height: normal;
  white-space: nowrap;
}
