.login-page {
  padding-top: 48rpx;
}

.login-hero {
  padding: 28rpx 8rpx 36rpx;
  text-align: left;
}

.login-mark-wrap {
  display: block;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: rgba(219, 225, 255, 0.7);
  box-shadow: 0 16rpx 36rpx rgba(31, 83, 201, 0.12);
}

.login-mark {
  width: 62rpx;
  height: 62rpx;
  margin: 21rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.1);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.login-title {
  display: block;
  margin-top: 28rpx;
  color: #0b1c30;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 20rpx;
  color: #66748a;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-card {
  padding: 34rpx;
}

.login-form {
  display: block;
}

.avatar-button {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 12rpx;
  padding: 0;
  border-radius: 42rpx;
  background: rgba(219, 225, 255, 0.72);
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(31, 83, 201, 0.14);
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-placeholder {
  width: 132rpx;
  height: 132rpx;
}

.avatar-placeholder {
  padding: 28rpx;
  box-sizing: border-box;
}

.avatar-tip {
  display: block;
  margin-bottom: 24rpx;
  color: #66748a;
  font-size: 24rpx;
  text-align: center;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-button {
  margin-top: 28rpx;
}

.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: 20rpx;
  background: transparent;
  color: #1f53c9;
  font-size: 26rpx;
}

.plain-link::after {
  border: 0;
}
