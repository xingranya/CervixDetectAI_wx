.login-page {
  padding-top: 36rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--wx-border-white-90);
  border-radius: 24rpx;
  background: var(--wx-bg-glass);
  box-shadow: 0 18rpx 46rpx rgba(var(--wx-brand-500-rgb), 0.07);
  box-sizing: border-box;
}

.primary-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: var(--wx-shadow-float);
  white-space: nowrap;
}

.primary-button::after,
.plain-link::after,
.login-skip-button::after,
.login-consent-cancel::after,
.login-consent-confirm::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.button-text,
.plain-link-text {
  display: block;
  min-width: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--wx-bg-glass-light);
  border: 1rpx solid var(--wx-border-light);
  color: var(--wx-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Hero ---------- */
.login-hero {
  padding: 18rpx 8rpx 28rpx;
  text-align: left;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border: 1rpx solid var(--wx-border-brand);
  border-radius: 999rpx;
  background: var(--wx-bg-glass);
  box-shadow: var(--wx-shadow-soft);
  box-sizing: border-box;
}

.login-mark-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(var(--wx-brand-500-rgb), 0.06);
  flex: 0 0 auto;
}

.login-mark {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.eyebrow {
  display: block;
  color: var(--wx-brand-500);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.login-title {
  display: block;
  margin-top: 28rpx;
  color: var(--wx-text-primary);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 16rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.7;
}

/* ---------- Card ---------- */
.login-card {
  padding: 34rpx 30rpx;
}

.login-card-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.login-card-desc {
  display: block;
  margin-top: 10rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.6;
}

.login-form {
  display: block;
  margin-top: 26rpx;
}

/* ---------- Avatar ---------- */
.login-avatar-field {
  padding-top: 6rpx;
}

.login-avatar-label,
.login-nickname-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--wx-text-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.login-avatar-picker-wrap {
  position: relative;
  display: inline-block;
  margin-top: 14rpx;
}

.login-avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx !important;
  height: 180rpx !important;
  margin-top: 0;
  padding: 0 !important;
  border: 1rpx solid var(--wx-border-light) !important;
  border-radius: 50% !important;
  background: var(--wx-bg-input) !important;
  overflow: hidden;
}

.login-avatar-picker::after {
  border: 0;
}

/* 未同意时的禁用态 */
.login-avatar-picker-disabled {
  opacity: 0.55;
  border-style: dashed !important;
}

.login-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.login-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.login-avatar-placeholder-text {
  color: #475569;
  font-size: 22rpx;
}

.login-avatar-hint {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.4;
}

.login-avatar-note {
  display: block;
  margin-top: 12rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.6;
}

/* ---------- Nickname ---------- */
.login-nickname-field {
  margin-top: 22rpx;
}

.login-nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--wx-border-light);
  border-radius: 20rpx;
  background: var(--wx-bg-input);
  color: var(--wx-text-primary);
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-nickname-placeholder {
  color: #64748b;
}

.login-nickname-hint {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---------- Agreement ---------- */
.agreement-panel {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--wx-border-card-light);
  border-radius: 20rpx;
  background: var(--wx-bg-input);
}

.agreement-title,
.agreement-links,
.agreement-note {
  display: block;
}

.agreement-title {
  color: var(--wx-text-primary);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
}

.agreement-links {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  line-height: 1.7;
}

.agreement-link,
.agreement-separator {
  font-size: 25rpx;
}

.agreement-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--wx-brand-500);
  font-weight: 800;
  background: rgba(var(--wx-brand-500-rgb), 0.08);
}

.agreement-separator {
  margin: 0;
  color: #475569;
}

.agreement-note {
  margin-top: 12rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Buttons ---------- */
.login-button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-top: 26rpx;
}

.login-button[disabled] {
  background: linear-gradient(135deg, var(--wx-brand-disabled-start) 0%, var(--wx-brand-disabled-end) 100%);
  color: var(--wx-text-on-primary);
  box-shadow: none;
}

.login-skip-button {
  margin-top: 18rpx;
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: var(--wx-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
  border: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-skip-button[disabled] {
  color: var(--wx-text-icon-placeholder);
  background: transparent;
}

.login-skip-button-text {
  display: block;
  white-space: nowrap;
}

/* ---------- Consent Popup ---------- */
.login-consent-mask {
  position: fixed;
  inset: 0;
  background: var(--wx-overlay);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-consent-panel {
  width: 100%;
  max-width: 620rpx;
  background: var(--wx-bg-primary);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 30rpx 70rpx var(--wx-shadow-panel);
  box-sizing: border-box;
}

.login-consent-title {
  display: block;
  color: var(--wx-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
}

.login-consent-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--wx-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.login-consent-links {
  margin-top: 16rpx;
}

.login-consent-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.login-consent-cancel,
.login-consent-confirm {
  flex: 1 1 0;
  height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-consent-cancel {
  background: var(--wx-bg-disabled);
  color: var(--wx-text-secondary);
}

.login-consent-confirm {
  background: linear-gradient(135deg, var(--wx-brand-500), var(--wx-brand-600));
  color: var(--wx-text-on-primary);
  box-shadow: 0 12rpx 26rpx rgba(var(--wx-brand-500-rgb), 0.24);
}
