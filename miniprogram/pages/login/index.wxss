.login-page {
  padding-top: 48rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  height: 86rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
}

.primary-button::after,
.plain-link::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-hero {
  padding: 28rpx 8rpx 36rpx;
  text-align: left;
}

.login-mark-wrap {
  display: block;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: rgba(219, 225, 255, 0.7);
  box-shadow: 0 16rpx 36rpx rgba(31, 83, 201, 0.12);
}

.login-mark {
  width: 62rpx;
  height: 62rpx;
  margin: 21rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 83, 201, 0.1);
  color: #1f53c9;
  font-size: 24rpx;
  font-weight: 700;
}

.login-title {
  display: block;
  margin-top: 28rpx;
  color: #0b1c30;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 20rpx;
  color: #66748a;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-card {
  padding: 34rpx;
}

.login-form {
  display: block;
}

.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  min-width: 152rpx;
  height: 152rpx;
  margin: 0 auto 12rpx;
  padding: 8rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.52) 42%, transparent 43%),
    linear-gradient(135deg, rgba(219, 225, 255, 0.9), rgba(239, 244, 255, 0.78));
  overflow: hidden;
  line-height: 1;
  box-shadow: 0 16rpx 36rpx rgba(31, 83, 201, 0.14);
  box-sizing: border-box;
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-placeholder {
  display: block;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
}

.avatar-placeholder {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.74);
}

.avatar-tip {
  display: block;
  margin-bottom: 24rpx;
  color: #66748a;
  font-size: 24rpx;
  text-align: center;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-button {
  margin-top: 28rpx;
}

.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: 20rpx;
  background: transparent;
  color: #1f53c9;
  font-size: 26rpx;
}
