.login-page {
  padding-top: 36rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(31, 83, 201, 0.07);
  box-sizing: border-box;
}

.primary-button,
.plain-link {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  font-size: 30rpx;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(31, 83, 201, 0.24);
  white-space: nowrap;
}

.primary-button::after,
.plain-link::after,
.login-skip-button::after,
.login-consent-cancel::after,
.login-consent-confirm::after {
  border: 0;
}

.button-icon,
.small-icon {
  display: block;
  flex: 0 0 auto;
}

.button-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.button-text,
.plain-link-text {
  display: block;
  min-width: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(195, 198, 214, 0.48);
  color: #3e4a5f;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Hero ---------- */
.login-hero {
  padding: 18rpx 8rpx 28rpx;
  text-align: left;
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border: 1rpx solid rgba(24, 118, 210, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(24, 67, 126, 0.06);
  box-sizing: border-box;
}

.login-mark-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(24, 118, 210, 0.06);
  flex: 0 0 auto;
}

.login-mark {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.eyebrow {
  display: block;
  color: rgb(24, 118, 210);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.login-title {
  display: block;
  margin-top: 28rpx;
  color: #0b1c30;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
}

.login-desc {
  display: block;
  margin-top: 16rpx;
  color: #3e4a5f;
  font-size: 28rpx;
  line-height: 1.7;
}

/* ---------- Card ---------- */
.login-card {
  padding: 34rpx 30rpx;
}

.login-card-title {
  display: block;
  color: #0b1c30;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.login-card-desc {
  display: block;
  margin-top: 10rpx;
  color: #4d5d73;
  font-size: 25rpx;
  line-height: 1.6;
}

.login-form {
  display: block;
  margin-top: 26rpx;
}

/* ---------- Avatar ---------- */
.login-avatar-field {
  padding-top: 6rpx;
}

.login-avatar-label,
.login-nickname-label {
  display: block;
  margin-bottom: 14rpx;
  color: #0b1c30;
  font-size: 26rpx;
  font-weight: 800;
}

.login-avatar-picker-wrap {
  position: relative;
  display: inline-block;
  margin-top: 14rpx;
}

.login-avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx !important;
  height: 180rpx !important;
  margin-top: 0;
  padding: 0 !important;
  border: 1rpx solid rgba(195, 198, 214, 0.52) !important;
  border-radius: 50% !important;
  background: rgba(248, 249, 255, 0.72) !important;
  overflow: hidden;
}

.login-avatar-picker::after {
  border: 0;
}

/* 未同意时的禁用态 */
.login-avatar-picker-disabled {
  opacity: 0.55;
  border-style: dashed !important;
}

.login-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.login-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.login-avatar-placeholder-text {
  color: #5f6f86;
  font-size: 22rpx;
}

.login-avatar-hint {
  display: block;
  margin-top: 10rpx;
  color: #8e9bb5;
  font-size: 22rpx;
  line-height: 1.4;
}

.login-avatar-note {
  display: block;
  margin-top: 12rpx;
  color: #5f6f86;
  font-size: 23rpx;
  line-height: 1.6;
}

/* ---------- Nickname ---------- */
.login-nickname-field {
  margin-top: 22rpx;
}

.login-nickname-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(195, 198, 214, 0.52);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
  color: #0f172a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-nickname-placeholder {
  color: #7d8ba3;
}

.login-nickname-hint {
  display: block;
  margin-top: 10rpx;
  color: #66748a;
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---------- Agreement ---------- */
.agreement-panel {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(199, 210, 232, 0.72);
  border-radius: 20rpx;
  background: rgba(248, 249, 255, 0.72);
}

.agreement-title,
.agreement-links,
.agreement-note {
  display: block;
}

.agreement-title {
  color: #10233c;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
}

.agreement-links {
  margin-top: 12rpx;
  line-height: 1.7;
}

.agreement-link,
.agreement-separator {
  font-size: 25rpx;
}

.agreement-link {
  color: #1f53c9;
  font-weight: 800;
}

.agreement-separator {
  margin: 0 8rpx;
  color: #4d5d73;
}

.agreement-note {
  margin-top: 12rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- Buttons ---------- */
.login-button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-top: 26rpx;
}

.login-button[disabled] {
  background: linear-gradient(135deg, #a8b8e6 0%, #c6d2f0 100%);
  color: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.login-skip-button {
  margin-top: 18rpx;
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: #4d5d73;
  font-size: 26rpx;
  font-weight: 700;
  border: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-skip-button[disabled] {
  color: #a8b3c7;
  background: transparent;
}

.login-skip-button-text {
  display: block;
  white-space: nowrap;
}

/* ---------- Consent Popup ---------- */
.login-consent-mask {
  position: fixed;
  inset: 0;
  background: rgba(11, 28, 48, 0.48);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-consent-panel {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 30rpx 70rpx rgba(11, 28, 48, 0.32);
  box-sizing: border-box;
}

.login-consent-title {
  display: block;
  color: #0b1c30;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
}

.login-consent-desc {
  display: block;
  margin-top: 12rpx;
  color: #4d5d73;
  font-size: 25rpx;
  line-height: 1.65;
}

.login-consent-links {
  margin-top: 16rpx;
}

.login-consent-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.login-consent-cancel,
.login-consent-confirm {
  flex: 1 1 0;
  height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-consent-cancel {
  background: #f2f4fb;
  color: #4d5d73;
}

.login-consent-confirm {
  background: linear-gradient(135deg, #1f53c9 0%, #406de4 100%);
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(31, 83, 201, 0.24);
}
