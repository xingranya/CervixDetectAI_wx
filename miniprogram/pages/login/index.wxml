<view class="page login-page">
  <view class="login-hero">
    <view class="brand-lockup">
      <view class="login-mark-wrap">
        <image class="login-mark" src="https://img1.tucang.cc/api/image/show/45b4f4864a1e97681b52b7a1e1f5cc31" mode="aspectFit" />
      </view>
      <text class="eyebrow">云端智诊</text>
    </view>
    <text class="login-title">女性健康记录与复查提醒助手</text>
    <text class="login-desc">保存检查摘要、管理复查提醒、整理线下咨询前的问题。</text>
  </view>

  <view class="card login-card">
    <text class="login-card-title">登录后设置昵称与头像</text>
    <text class="login-card-desc">登录仅用于保存你的个人记录。你可以直接选微信头像、使用微信昵称；不设置也不影响继续使用。</text>

    <form class="login-form" bind:submit="submitLogin">
      <view class="login-avatar-field">
        <text class="login-avatar-label">头像（可选）</text>
        <view class="login-avatar-picker-wrap">
          <!-- 未同意协议时：纯 view，不触发原生选择器 -->
          <view wx:if="{{!setupEnabled}}" class="login-avatar-picker login-avatar-picker-disabled" catch:tap="onAvatarPickerTap">
            <view class="login-avatar-placeholder">
              <t-icon name="user" color="#a8b3c7" size="64rpx" />
              <text class="login-avatar-placeholder-text">点击选择头像</text>
            </view>
          </view>
          <!-- 已同意协议后：真正的 button + open-type -->
          <button wx:else class="login-avatar-picker" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image wx:if="{{avatarPreviewUrl}}" class="login-avatar-preview" src="{{avatarPreviewUrl}}" mode="aspectFill" bind:error="onAvatarPreviewError" />
            <view wx:else class="login-avatar-placeholder">
              <t-icon name="user" color="#5f6f86" size="64rpx" />
              <text class="login-avatar-placeholder-text">点击选择头像</text>
            </view>
          </button>
        </view>
        <text wx:if="{{!setupEnabled}}" class="login-avatar-hint">同意协议后可设置</text>
        <text wx:if="{{avatarUploadPending}}" class="login-avatar-note">头像已选中，登录完成后会上传并更新显示。</text>
      </view>

      <view class="login-nickname-field">
        <text class="login-nickname-label">昵称（可选）</text>
        <input
          class="login-nickname-input"
          type="nickname"
          name="nickname"
          value="{{profileForm.nickname}}"
          bind:input="onNicknameInput"
          maxlength="20"
          placeholder="点击可输入，或从微信昵称中选择"
          placeholder-class="login-nickname-placeholder"
        />
        <text class="login-nickname-hint">提交登录前请先阅读并同意资料设置说明；不填写会使用默认昵称。</text>
      </view>

      <view class="agreement-panel">
        <text class="agreement-title">登录前请先同意以下协议</text>
        <view class="agreement-links">
          <text class="agreement-link" hover-class="u-hover" bind:tap="openServiceAgreement" aria-role="link" aria-label="用户服务协议">《用户服务协议》</text>
          <text class="agreement-separator">与</text>
          <text class="agreement-link" hover-class="u-hover" bind:tap="openPrivacy" aria-role="link" aria-label="隐私与服务说明">《隐私与服务说明》</text>
        </view>
        <text class="agreement-note">点击登录按钮后会弹出协议确认弹窗，请阅读后主动勾选同意。不同意也可仅浏览小程序，不影响查看健康知识和功能入口。</text>
      </view>

      <button class="primary-button login-button" hover-class="u-hover" disabled="{{loading}}" form-type="submit" aria-role="button" aria-label="登录并继续">
        <view class="button-content">
          <t-icon name="login" color="#ffffff" size="36rpx" />
          <text class="button-text">{{loading ? '正在登录' : '登录并继续'}}</text>
        </view>
      </button>

      <button class="login-skip-button" hover-class="u-hover" disabled="{{loading}}" catch:tap="skipSetupAndLogin" aria-role="button" aria-label="暂不设置资料，直接登录">
        <text class="login-skip-button-text">暂不设置资料，直接登录</text>
      </button>
    </form>
  </view>

  <view class="safe-note">产品仅用于健康信息记录与提醒，不提供在线诊断、治疗、处方或问诊服务。</view>

  <!-- 隐私协议同意弹窗 -->
  <privacy-consent
    visible="{{privacyConsentVisible}}"
    bind:accept="onPrivacyAccept"
    bind:decline="onPrivacyDecline"
  />

  <!-- 资料设置同意弹窗 -->
  <view wx:if="{{consentPopupVisible}}" class="login-consent-mask" catch:touchmove="{{true}}">
    <view class="login-consent-panel" catch:tap="{{true}}">
      <text class="login-consent-title">资料设置说明</text>
      <text class="login-consent-desc">设置昵称和头像前，请先阅读相关说明。不同意也可以继续登录并使用小程序，只是本次不进行资料设置。</text>
      <view class="agreement-links login-consent-links">
        <text class="agreement-link" hover-class="u-hover" bind:tap="openServiceAgreement">《用户服务协议》</text>
        <text class="agreement-separator">与</text>
        <text class="agreement-link" hover-class="u-hover" bind:tap="openPrivacy">《隐私与服务说明》</text>
      </view>
      <view class="login-consent-actions">
        <button class="login-consent-cancel" hover-class="u-hover" catch:tap="declineConsent">暂不设置</button>
        <button class="login-consent-confirm" hover-class="u-hover" catch:tap="agreeConsent">同意并设置</button>
      </view>
    </view>
  </view>
</view>
