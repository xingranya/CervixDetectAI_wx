<view class="page login-page">
  <view class="login-hero">
    <view class="login-mark-wrap">
      <image class="login-mark" src="/assets/icons/login-active.png" mode="aspectFit" />
    </view>
    <text class="eyebrow">云端智诊</text>
    <text class="login-title">女性健康记录与复查提醒助手</text>
    <text class="login-desc">用于保存检查摘要、管理复查提醒、整理线下咨询前的问题。</text>
  </view>

  <view class="card login-card">
    <form class="login-form" bind:submit="submitLogin">
      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl && !avatarPreviewFailed}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" bind:error="onAvatarLoadError" />
        <image wx:else class="avatar-placeholder" src="/assets/icons/profile-active.png" mode="aspectFit" />
      </button>
      <text class="avatar-tip">头像为选填，仅用于个人中心展示</text>

      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="nickname"
        name="nickname"
        value="{{nickname}}"
        bind:input="onNicknameInput"
        maxlength="20"
        placeholder="可填写或选择微信昵称"
      />
      <button class="primary-button login-button" loading="{{loading}}" form-type="submit">
        <image class="button-icon" src="/assets/icons/login-white.png" mode="aspectFit" />
        同意并进入
      </button>
      <button class="plain-link" bind:tap="openPrivacy">
        <image class="small-icon" src="/assets/icons/privacy-active.png" mode="aspectFit" />
        查看隐私与服务说明
      </button>
    </form>
  </view>

  <view class="safe-note">产品仅用于健康信息记录与提醒，不提供在线诊断、治疗、处方或问诊服务。</view>
  <privacy-popup id="privacyPopup" />
</view>
