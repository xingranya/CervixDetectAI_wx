<view class="page login-page">
  <view class="login-hero">
    <view class="brand-lockup">
      <view class="login-mark-wrap">
        <image class="login-mark" src="/assets/icons/logo.png" mode="aspectFit" />
      </view>
      <text class="eyebrow">云端智诊</text>
    </view>
    <text class="login-title">女性健康记录与复查提醒助手</text>
    <text class="login-desc">用于保存检查摘要、管理复查提醒、整理线下咨询前的问题。</text>
  </view>

  <view class="card login-card">
    <mp-form models="{{formModel}}">
    <form class="login-form" bind:submit="submitLogin">
      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <view class="avatar-circle">
          <image wx:if="{{avatarUrl && !avatarPreviewFailed}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" bind:error="onAvatarLoadError" />
          <view wx:else class="avatar-placeholder">
            <view class="flat-avatar-head"></view>
            <view class="flat-avatar-body"></view>
          </view>
        </view>
      </button>
      <text class="avatar-tip">头像为选填，仅用于个人中心展示</text>

      <mp-cells ext-class="form-weui-cells">
      <mp-cell title="昵称" inline="{{false}}">
      <input
        class="form-input"
        type="nickname"
        name="nickname"
        value="{{nickname}}"
        bind:input="onNicknameInput"
        maxlength="20"
        placeholder="可填写或选择微信昵称"
      />
      </mp-cell>
      </mp-cells>
      <text class="avatar-tip">登录仅用于保存你的个人记录、提醒和备忘，头像与昵称均为选填。</text>
      <button class="primary-button login-button" disabled="{{loading}}" form-type="submit">
        <view class="button-content">
          <mp-icon icon="me" color="#ffffff" size="{{18}}" />
          <text class="button-text">{{loading ? '正在登录' : '登录保存数据'}}</text>
        </view>
      </button>
      <button class="plain-link" bind:tap="openPrivacy">
        <view class="button-content">
          <mp-icon icon="info" color="#1f53c9" size="{{16}}" />
          <text class="plain-link-text">查看隐私与服务说明</text>
        </view>
      </button>
    </form>
    </mp-form>
  </view>

  <view class="safe-note">产品仅用于健康信息记录与提醒，不提供在线诊断、治疗、处方或问诊服务。</view>
  <privacy-popup id="privacyPopup" />
</view>
